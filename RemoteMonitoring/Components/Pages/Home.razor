@page "/"
@rendermode InteractiveServer
@inject SocketClient Socket

<PageTitle>Profiles</PageTitle>

<div class="flex flex-col gap-5 p-5">
    <h1 class="text-2xl font-bold">Profiles</h1>

    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5 2xl:grid-cols-7">
        @foreach (OlisProfileDTO profile in Profiles)
        {
            <div @onclick="() => SelectProfile(profile)">
                <Profile Title="@profile.Title" AccentColor="@profile.AccentColorHex" IsHighlighted="IsSelected(profile)" />
            </div>
        }
    </div>
</div>

@code {
    private OlisProfileDTO? SelectedProfile;
    private List<OlisProfileDTO> Profiles { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshProfiles();
    }

    private async Task RefreshProfiles()
    {
        ApiService service = new ApiService(Socket);
        Profiles.Clear();
        List<OlisProfileDTO> profiles = await service.GetAllProfiles();
        Profiles.AddRange(profiles);
    }

    private void SelectProfile(OlisProfileDTO profile)
    {
        SelectedProfile = profile;
    }

    private bool IsSelected(OlisProfileDTO profile)
    {
        return SelectedProfile?.Id == profile.Id;
    }
}