@page "/"
@using GameTimeNext.Shared.Profiles
@using GameTimeNext.Shared.Profiles.Monitoring
@rendermode InteractiveServer
@inject SocketClient Socket
@inject ProfilesApiService ProfilesApiService
@inject MonitoringStateService MonitoringStateService

<PageTitle>Profiles</PageTitle>

<div class="flex flex-col gap-5 p-5">
    <h1 class="text-2xl font-bold">Profiles</h1>

    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5 2xl:grid-cols-7">
        @foreach (ProfileDto profile in Profiles)
        {
            <div @onclick="() => SelectProfile(profile)">
                <Profile Title="@profile.GANA" ImageUrl="@profile.PPFN" AccentColor="@profile.AccentColorHex" IsHighlighted="IsSelected(profile)" />
            </div>
        }
    </div>

    <div class="fixed right-0 bottom-20 p-5 bg-black/25">
        @if (SelectedProfile is not null)
        {
            <p>@SelectedProfile.PFID</p>
            <h1 class="text-xl font-bold">@SelectedProfile.GANA</h1>

            @if (!IsMonitoring)
            {
                <button @onclick="() => StartMonitoring()">Start monitoring</button>
            }
            else
            {
                <button @onclick="() => StopMonitoring()">Stop monitoring</button>
            }
        }
    </div>

    
    <div class="fixed left-0 bottom-20 p-5 bg-black/25">
        <h1>Monitoring Status: @((MonitoringStateService.Current is not null && MonitoringStateService.Current.IsMonitoring) ? "Active" : "Inactive")</h1>
    </div>
</div>

@code {
    private List<ProfileDto> Profiles { get; } = new();
    private ProfileDto? SelectedProfile = null;
    private bool IsMonitoring = false;

    protected override async Task OnInitializedAsync()
    {
        await RefreshProfiles();
    }

    private async Task RefreshProfiles()
    {
        Profiles.Clear();
        List<ProfileDto> profiles = await ProfilesApiService.GetProfiles();
        Profiles.AddRange(profiles);
    }

    private async Task SelectProfile(ProfileDto profile)
    {
        SelectedProfile = null;
        SelectedProfile = await ProfilesApiService.GetProfile(profile.PFID);
    }

    private bool IsSelected(ProfileDto profile)
    {
        return SelectedProfile?.PFID == profile.PFID;
    }

    private async Task StartMonitoring()
    {
        if (SelectedProfile is null) return;

        StartMonitoringResponseMessage? response = await ProfilesApiService.StartMonitoring(SelectedProfile.PFID);
        if (response is not null && response.Status.Equals(MonitoringResponse.MonitoringStarted))
            IsMonitoring = true;
    }

    private async Task StopMonitoring()
    {
        if (SelectedProfile is null) return;

        StopMonitoringResponseMessage? response = await ProfilesApiService.StopMonitoring();
        if (response is not null)
            IsMonitoring = false;
    }
}