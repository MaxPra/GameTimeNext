@inject AppCircuitHandler Circuit
@inject SocketClient Socket

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RemoteMonitoring.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.ico" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    protected override async Task OnInitializedAsync()
    {
        Socket.Reset();
        // OFDOI: _ = Socket.StartAsync(Circuit.Cts.Token); // Pass canellationToken, so that everything gets aborted, when the browser window closes.
        _ = Socket.StartAsync();
    }
}