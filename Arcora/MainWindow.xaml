<ui:ArcoraWindow
    x:Class="GameTimeNext.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subviews="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uiFramework="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Width="1350"
    Height="1000"
    MinWidth="1350"
    MinHeight="1000"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    ApplicationSearchPlaceholder="Search Application"
    ShowApplicationSearch="False"
    ShowAppIcon="True"
    ShowBigPictureButton="True"
    ShowHelpButton="True"
    Style="{StaticResource ArcoraWindowStyle}"
    Subtitle="beta"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="pnlDevPathsHeader"
            Grid.Row="0"
            Height="26"
            Margin="0"
            Padding="8,2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="#FF8B0000"
            ToolTip="DEVMODE ON: Development paths are being used."
            Visibility="Collapsed">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="DEVMODE ON: Development paths are being used." />

        </Border>

        <Border
            x:Name="pnlUserModeHeader"
            Grid.Row="1"
            Height="26"
            Margin="0"
            Padding="8,2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="#FF6060CB"
            ToolTip="USERMODE ON: User mode is enabled."
            Visibility="Collapsed">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="USERMODE ON: User mode is enabled." />

        </Border>

        <uixsel:UIXTabControl
            x:Name="MainTabControl"
            Grid.Row="2"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            uiFramework:TabControlBehaviors.AddButtonToolTip="Open application menu (Ctrl+M)"
            uiFramework:TabControlBehaviors.FavoritesButtonToolTip="Start order of the favorites"
            uiFramework:TabControlBehaviors.ShowAddButton="True"
            uiFramework:TabControlBehaviors.ShowFavoritesButton="True"
            Background="Transparent"
            BorderThickness="0"
            Style="{StaticResource ModernTabControlStyle}">

            <!--<uixsel:UIXTabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource ModernTabItemStyle}" TargetType="TabItem">

                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                <MenuItem
                                    x:Name="ctxtClose"
                                    Header="Close"
                                    Style="{StaticResource ModernContextMenuItemStyle}">

                                    <MenuItem.Icon>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Font.Icons}"
                                            FontSize="14"
                                            Text="&#xE8BB;" />
                                    </MenuItem.Icon>

                                </MenuItem>
                                <MenuItem
                                    x:Name="ctxtFav"
                                    Header="Add to favorites"
                                    Style="{StaticResource ModernContextMenuItemStyle}">

                                    <MenuItem.Icon>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Font.Icons}"
                                            FontSize="14"
                                            Text="&#xE734;" />
                                    </MenuItem.Icon>

                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </uixsel:UIXTabControl.ItemContainerStyle>-->

        </uixsel:UIXTabControl>

        <!--
            Start order of the favorites (FavAppsStartOrderView), opened by the down arrow in the tab bar
            (template part btnTabFavorites, set as PlacementTarget by the controller)
        -->
        <Popup
            x:Name="popFavAppsStartOrder"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False"
            VerticalOffset="4">
            <Border Style="{StaticResource ModernPopupCardStyle}">
                <ContentPresenter x:Name="cpFavAppsStartOrder" />
            </Border>
        </Popup>

        <!--
            QR code of the remote monitoring (RemoteMonitoringPairingView), opened by the button in the title bar
            (template part btnRemoteMonitoring, set as PlacementTarget by the controller)
        -->
        <Popup
            x:Name="popRemoteMonitoringPairing"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False"
            VerticalOffset="4">
            <Border Style="{StaticResource ModernPopupCardStyle}">
                <ContentPresenter x:Name="cpRemoteMonitoringPairing" />
            </Border>
        </Popup>

        <!--  Big Picture mode (BigPictureApp): full screen layer over the tabs, shown while the mode is active  -->
        <ContentPresenter
            x:Name="cpBigPicture"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Visibility="Collapsed" />

    </Grid>
</ui:ArcoraWindow>