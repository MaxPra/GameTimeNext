<uixcontrols:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.General.Views.RemoteMonitoringPairingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixcontrols="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    Width="300">

    <!--
        Shown inside the remote monitoring popup of the main window (ModernPopupCardStyle), which provides surface and
        padding. QR code and addresses like in the settings; "Reset pairing" stays in the settings.
    -->
    <StackPanel>
        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Connect your phone" />
        <TextBlock
            Margin="0,4,0,12"
            Style="{StaticResource Text.Hint}"
            Text="Scan the QR code with your phone's camera. It opens the remote monitoring and pairs your phone."
            TextWrapping="Wrap" />

        <Border
            x:Name="brdQrCode"
            Width="200"
            Height="200"
            Margin="0,0,0,12"
            Padding="8"
            HorizontalAlignment="Center"
            Background="White"
            CornerRadius="{StaticResource Control.CornerRadius}">
            <Image
                x:Name="imgQrCode"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Stretch="Uniform" />
        </Border>

        <TextBlock
            x:Name="txtAddress"
            Style="{StaticResource Text.Body}"
            TextWrapping="Wrap" />

        <TextBlock
            Margin="0,12,0,0"
            Style="{StaticResource Text.Label}"
            Text="Pairing code" />
        <TextBlock
            x:Name="txtPairingCode"
            FontFamily="Cascadia Mono, Consolas"
            Style="{StaticResource Text.BodyStrong}"
            TextWrapping="Wrap" />
    </StackPanel>
</uixcontrols:UIXUserControlBase>
