<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>

    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />

    <!--
        Icon font for all glyphs: the Windows 11 icons, Segoe MDL2 Assets as fallback on Windows 10 (same code points).
        Used with StaticResource everywhere, so the whole app shows one icon style.
    -->
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--
        Text font of the whole app: Manrope (UI/Fonts, embedded in the assembly, all weights in one family), Segoe UI as fallback.
        Set as default font of TextBlock and TextElement by FnFont.ApplyAsDefault at startup; code that draws text itself uses FnFont.Text().
    -->
    <FontFamily x:Key="Font.Text">pack://application:,,,/UI/Fonts/#Manrope, Segoe UI</FontFamily>

    <!--
        The app icon as a vector (first "a" of Branding/wordmark.svg), so it stays sharp at every size.
        An .ico as Image source would show its first frame (16 px) scaled up.
    -->
    <DrawingImage x:Key="App.Mark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 15.5,-17.4 A 100,100 0 1 0 148.2,-94.0">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="28">
                            <Pen.Brush>
                                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,-114" EndPoint="0,114">
                                    <GradientStop Offset="0" Color="#5DB6F3" />
                                    <GradientStop Offset="1" Color="#2A8FDF" />
                                </LinearGradientBrush>
                            </Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 214,0 L 214,100">
                    <GeometryDrawing.Pen>
                        <Pen EndLineCap="Round" Thickness="28">
                            <Pen.Brush>
                                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,-114" EndPoint="0,114">
                                    <GradientStop Offset="0" Color="#5DB6F3" />
                                    <GradientStop Offset="1" Color="#2A8FDF" />
                                </LinearGradientBrush>
                            </Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 131.4,-98.5 A 100,100 0 0 0 20.0,-34.2">
                    <GeometryDrawing.Pen>
                        <Pen Thickness="28">
                            <Pen.Brush>
                                <LinearGradientBrush MappingMode="Absolute" StartPoint="20,0" EndPoint="120,-100">
                                    <GradientStop Offset="0" Color="#BFE4FF" />
                                    <GradientStop Offset="1" Color="#8ED1FA" />
                                </LinearGradientBrush>
                            </Pen.Brush>
                        </Pen>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        ===== Spacing =====
        4 px grid: 4 / 8 / 12 / 16 / 24 / 32. Gaps between label and input are 12, between cards and sections 16.
    -->

</ResourceDictionary>
