<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="DefaultCornerRadius">4</CornerRadius>

    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />

    <!--
        Icon font for all glyphs: the Windows 11 icons, Segoe MDL2 Assets as fallback on Windows 10 (same code points).
        Used with StaticResource everywhere, so the whole app shows one icon style.
    -->
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--
        Text font of the whole app: Manrope (UI/Fonts, embedded in the assembly, all weights in one family), Segoe UI as fallback.
        Set as default of every window by FnFont.ApplyAsDefault at startup; code that draws text itself uses FnFont.Text().
    -->
    <FontFamily x:Key="Font.Text">pack://application:,,,/GameTimeNext;component/UI/Fonts/#Manrope, Segoe UI</FontFamily>

    <!--
        ===== Spacing =====
        4 px grid: 4 / 8 / 12 / 16 / 24 / 32. Gaps between label and input are 12, between cards and sections 16.
    -->

</ResourceDictionary>
