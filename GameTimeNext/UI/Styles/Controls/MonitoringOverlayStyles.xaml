<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--
        "Currently monitoring" overlay over the profile tiles (the tiles are blurred by ProfilesView while it is visible).
        Glass card like the busy indicator: a calm particle play triangle (CFParticleSpinner) around a game icon.
    -->
    <Style x:Key="MonitoringOverlayHostStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Panel.ZIndex" Value="1000" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Background="#66000000">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!--  Shadow shape behind the card (an effect on the card would blur the text)  -->
                            <Border
                                Background="#FF000000"
                                CornerRadius="16"
                                Effect="{StaticResource Effect.Popup}"
                                IsHitTestVisible="False"
                                Opacity="0.35" />

                            <Border
                                Width="430"
                                Padding="30,22,30,30"
                                Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel>
                                    <Grid
                                        Width="240"
                                        Height="240"
                                        Margin="0,-6,0,4"
                                        HorizontalAlignment="Center">
                                        <ui:CFParticleSpinner Shape="PlayButton" Speed="0.45" />

                                        <!--  Game icon in a small glass disc in the middle of the play triangle  -->
                                        <Grid
                                            Width="76"
                                            Height="76"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="CenterPulseTransform" ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>

                                            <Ellipse Fill="{DynamicResource Brush.Card.Background}" Stroke="{DynamicResource Brush.Card.Border}" StrokeThickness="1" />
                                            <Ellipse
                                                Margin="8"
                                                Fill="{DynamicResource Brush.Accent}"
                                                Opacity="0.14" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                FontSize="30"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="&#xE7FC;" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Currently monitoring game time..."
                                        TextAlignment="Center" />

                                    <TextBlock
                                        x:Name="StatusText"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Opacity="0.9"
                                        Text="Tracking active session"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="MonitoringOverlayStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!--  Slow "heartbeat" of the icon and the status text  -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterPulseTransform" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                                            <SplineDoubleKeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.4" Value="1.05" />
                                            <SplineDoubleKeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2.8" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterPulseTransform" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                                            <SplineDoubleKeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:1.4" Value="1.05" />
                                            <SplineDoubleKeyFrame KeySpline="0.4,0,0.6,1" KeyTime="0:0:2.8" Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatusText" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.7" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="MonitoringOverlayStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
