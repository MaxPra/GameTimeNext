<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:GameTimeNext.Core.Application.Profiles.Converter"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!--  Base size; with TileLayout.AutoSize on the list the actual size is derived from it to fill each row  -->
    <sys:Double x:Key="TileWidth">246</sys:Double>
    <!--  Cover area is 2:3 (246 x 369) so the whole cover is visible, plus 61 for the title bar (rows 315*:52*)  -->
    <sys:Double x:Key="TileHeight">430</sys:Double>

    <!--  Space around the tile; the gap between two tiles is 2 x (TileOuterPadding + TileItemMargin)  -->
    <Thickness x:Key="TileOuterPadding">12</Thickness>

    <sys:Double x:Key="TileGapValue">12</sys:Double>
    <sys:Double x:Key="TileGapHalf">6</sys:Double>

    <!--  Uniform, so the gap between tiles is the same horizontally and vertically  -->
    <Thickness x:Key="TileItemMargin">6</Thickness>

    <Thickness x:Key="TileListPadding">26</Thickness>


    <!--
        Tiles follow the card design (CardStyles.xaml): same corner radius, lit edge instead of a strong sheen,
        title bar on the control surface, selection as accent tint + accent edge (text stays neutral).
    -->
    <CornerRadius x:Key="TileCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="TileImageCornerRadius">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="TileTitleCornerRadius">0,0,6,6</CornerRadius>

    <!--  Title bar surface (= Brush.Popup.Background) and the hairline between cover and title  -->
    <SolidColorBrush x:Key="Brush.TileTitleSurface" Color="#FF17171D" />
    <SolidColorBrush x:Key="Brush.TileTitleDivider" Color="#12FFFFFF" />
    <!--  Platform badge on the cover: dark glass, so it works on every cover  -->
    <SolidColorBrush x:Key="Brush.TileBadgeBackground" Color="#A6000000" />
    <SolidColorBrush x:Key="Brush.TileBadgeBorder" Color="#24FFFFFF" />

    <sys:Double x:Key="TileGlassOpacityNormal">0.00</sys:Double>
    <sys:Double x:Key="TileGlassOpacityHover">0.10</sys:Double>
    <sys:Double x:Key="TileSheenOpacityNormal">0.00</sys:Double>
    <sys:Double x:Key="TileSheenOpacityHover">0.16</sys:Double>
    <!--  Shadow layer opacity (the layer needs a fill, otherwise the DropShadowEffect has nothing to cast)  -->
    <sys:Double x:Key="TileShadowOpacityNormal">0.55</sys:Double>
    <sys:Double x:Key="TileShadowOpacityHover">0.80</sys:Double>

    <sys:Double x:Key="TileTitleAccentOpacityNormal">0.00</sys:Double>
    <sys:Double x:Key="TileTitleAccentOpacitySelected">1.00</sys:Double>
    <sys:Double x:Key="TileAccentStrokeOpacityNormal">0.00</sys:Double>
    <sys:Double x:Key="TileAccentStrokeOpacitySelected">1.00</sys:Double>

    <sys:Double x:Key="TileHoverStrokeOpacityHover">1.00</sys:Double>

    <sys:Double x:Key="TileTiltAngleHover">-5</sys:Double>
    <sys:Double x:Key="TileAccentGlowOpacityHover">0.40</sys:Double>

    <LinearGradientBrush x:Key="Brush.TileGlassFx" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="0.20" Color="#2AFFFFFF" />
        <GradientStop Offset="0.55" Color="#0AFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.TileSheenFx" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#70FFFFFF" />
        <GradientStop Offset="0.22" Color="#22FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGlowMask" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.00" Color="#00FFFFFF" />
        <GradientStop Offset="0.55" Color="#00FFFFFF" />
        <GradientStop Offset="0.72" Color="#C0FFFFFF" />
        <GradientStop Offset="1.00" Color="#FFFFFFFF" />
    </LinearGradientBrush>

    <Style x:Key="TileListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="None" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">

                    <ControlTemplate.Resources>
                        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
                        <CubicEase x:Key="EaseIn" EasingMode="EaseIn" />

                        <Storyboard x:Key="SbHoverIn" FillBehavior="HoldEnd">
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="Glass"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileGlassOpacityHover}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="Sheen"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileSheenOpacityHover}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="ShadowLayer"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileShadowOpacityHover}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="HoverStroke"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileHoverStrokeOpacityHover}"
                                Duration="0:0:0.18" />

                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="AccentGlowSoft"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileAccentGlowOpacityHover}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="AccentGlowTight"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileAccentGlowOpacityHover}"
                                Duration="0:0:0.18" />

                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="TiltRotation"
                                Storyboard.TargetProperty="Angle"
                                To="{StaticResource TileTiltAngleHover}"
                                Duration="0:0:0.18" />
                        </Storyboard>

                        <Storyboard x:Key="SbHoverOut" FillBehavior="HoldEnd">
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="Glass"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileGlassOpacityNormal}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="Sheen"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileSheenOpacityNormal}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="ShadowLayer"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileShadowOpacityNormal}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="HoverStroke"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.18" />

                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="AccentGlowSoft"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="AccentGlowTight"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.18" />

                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="TiltRotation"
                                Storyboard.TargetProperty="Angle"
                                To="0"
                                Duration="0:0:0.18" />
                        </Storyboard>

                        <Storyboard x:Key="SbSelectIn" FillBehavior="HoldEnd">
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="TitleAccent"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileTitleAccentOpacitySelected}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="AccentStroke"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileAccentStrokeOpacitySelected}"
                                Duration="0:0:0.18" />
                        </Storyboard>

                        <Storyboard x:Key="SbSelectOut" FillBehavior="HoldEnd">
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="TitleAccent"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileTitleAccentOpacityNormal}"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseIn}"
                                Storyboard.TargetName="AccentStroke"
                                Storyboard.TargetProperty="Opacity"
                                To="{StaticResource TileAccentStrokeOpacityNormal}"
                                Duration="0:0:0.18" />
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <Border
                        x:Name="HitSurface"
                        Padding="{StaticResource TileOuterPadding}"
                        Background="Transparent"
                        SnapsToDevicePixels="True">

                        <Grid
                            x:Name="Root"
                            Width="{Binding Path=(ui:TileLayout.TileWidth), RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding Path=(ui:TileLayout.TileHeight), RelativeSource={RelativeSource TemplatedParent}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                            <Border
                                x:Name="ShadowLayer"
                                Background="{DynamicResource Brush.TileBackground}"
                                CornerRadius="{StaticResource TileCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="{StaticResource TileShadowOpacityNormal}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="24"
                                        Direction="270"
                                        Opacity="1"
                                        RenderingBias="Quality"
                                        ShadowDepth="10"
                                        Color="#FF000000" />
                                </Border.Effect>
                            </Border>

                            <Border
                                x:Name="AccentGlowSoft"
                                Height="26"
                                Margin="10,0,10,12"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                Opacity="0"
                                OpacityMask="{StaticResource Brush.AccentGlowMask}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="90"
                                        Direction="270"
                                        Opacity="1"
                                        RenderingBias="Quality"
                                        ShadowDepth="30"
                                        Color="{DynamicResource Color.Accent}" />
                                </Border.Effect>
                            </Border>

                            <Border
                                x:Name="AccentGlowTight"
                                Height="18"
                                Margin="22,0,22,14"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.Accent}"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                Opacity="0"
                                OpacityMask="{StaticResource Brush.AccentGlowMask}">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="44"
                                        Direction="270"
                                        Opacity="1"
                                        RenderingBias="Quality"
                                        ShadowDepth="22"
                                        Color="{DynamicResource Color.Accent}" />
                                </Border.Effect>
                            </Border>

                            <Viewport3D ClipToBounds="False" IsHitTestVisible="False">
                                <Viewport3D.Camera>
                                    <!--
                                        FieldOfView = 2 * atan(0.7 / 4.2): the visible width at z = 0 is exactly the mesh width (1.4),
                                        so the card is rendered 1:1 within Root and does not overlap the gap between tiles.
                                    -->
                                    <PerspectiveCamera
                                        FieldOfView="18.9246"
                                        LookDirection="0,0,-4.2"
                                        Position="0,0,4.2"
                                        UpDirection="0,1,0" />
                                </Viewport3D.Camera>

                                <ModelVisual3D>
                                    <ModelVisual3D.Content>
                                        <Model3DGroup>
                                            <AmbientLight Color="#FFFFFF" />
                                            <DirectionalLight Direction="-0.2,-0.5,-1" Color="#FFFFFF" />
                                        </Model3DGroup>
                                    </ModelVisual3D.Content>
                                </ModelVisual3D>

                                <Viewport2DVisual3D>
                                    <Viewport2DVisual3D.Geometry>
                                        <MeshGeometry3D
                                            Positions="-0.7,-1.2236,0  0.7,-1.2236,0  0.7,1.2236,0  -0.7,1.2236,0"
                                            TextureCoordinates="0,1 1,1 1,0 0,0"
                                            TriangleIndices="0 1 2  0 2 3" />
                                    </Viewport2DVisual3D.Geometry>

                                    <Viewport2DVisual3D.Material>
                                        <DiffuseMaterial Brush="#FFFFFFFF" Viewport2DVisual3D.IsVisualHostMaterial="True" />
                                    </Viewport2DVisual3D.Material>

                                    <Viewport2DVisual3D.Transform>
                                        <Transform3DGroup>
                                            <RotateTransform3D
                                                CenterX="0"
                                                CenterY="1.2236"
                                                CenterZ="0">
                                                <RotateTransform3D.Rotation>
                                                    <AxisAngleRotation3D
                                                        x:Name="TiltRotation"
                                                        Angle="0"
                                                        Axis="1,0,0" />
                                                </RotateTransform3D.Rotation>
                                            </RotateTransform3D>
                                        </Transform3DGroup>
                                    </Viewport2DVisual3D.Transform>

                                    <Viewport2DVisual3D.Visual>
                                        <Border
                                            x:Name="Card"
                                            Width="{Binding Width, ElementName=Root}"
                                            Height="{Binding Height, ElementName=Root}"
                                            Background="{DynamicResource Brush.TileBackground}"
                                            BorderThickness="0"
                                            ClipToBounds="True"
                                            CornerRadius="{StaticResource TileCornerRadius}"
                                            SnapsToDevicePixels="True">
                                            <Grid ClipToBounds="True">
                                                <Grid.RowDefinitions>
                                                    <!--
                                                        Proportional (315:52) so the cover area stays 2:3 at any tile size.
                                                        Mesh half-height above = 0.7 * TileHeight / TileWidth; update both when changing the base size.
                                                    -->
                                                    <RowDefinition Height="315*" />
                                                    <RowDefinition Height="52*" />
                                                </Grid.RowDefinitions>

                                                <!--  ImageBrush instead of Image + fixed Clip: the corner radius then follows any tile size  -->
                                                <Border
                                                    Grid.Row="0"
                                                    CornerRadius="{StaticResource TileImageCornerRadius}"
                                                    RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Border.Background>
                                                        <!--  Top/Left like the former Image: overflow is cut at the bottom/right, not on both sides  -->
                                                        <ImageBrush
                                                            AlignmentX="Left"
                                                            AlignmentY="Top"
                                                            ImageSource="{Binding COCOVIM}"
                                                            Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>

                                                <Border
                                                    Grid.Row="0"
                                                    CornerRadius="{StaticResource TileImageCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Opacity="0.82">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Offset="0" Color="#2C000000" />
                                                            <GradientStop Offset="0.28" Color="#00000000" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Border
                                                    Grid.Row="0"
                                                    Margin="0,8,8,0"
                                                    Padding="7"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Panel.ZIndex="4"
                                                    Background="{StaticResource Brush.TileBadgeBackground}"
                                                    BorderBrush="{StaticResource Brush.TileBadgeBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Control.CornerRadius}"
                                                    IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding COPLFPA}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Image
                                                        Width="22"
                                                        Height="22"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        Source="{Binding COPLFPA}" />
                                                </Border>

                                                <Border
                                                    x:Name="TitleHost"
                                                    Grid.Row="1"
                                                    Background="{StaticResource Brush.TileTitleSurface}"
                                                    CornerRadius="{StaticResource TileTitleCornerRadius}"
                                                    SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <!--  Selection: highlight like selected list entries (Brush.Item.Selected)  -->
                                                        <Border
                                                            x:Name="TitleAccent"
                                                            Background="{StaticResource Brush.Item.Selected}"
                                                            CornerRadius="{StaticResource TileTitleCornerRadius}"
                                                            Opacity="{StaticResource TileTitleAccentOpacityNormal}" />

                                                        <Border
                                                            Height="1"
                                                            VerticalAlignment="Top"
                                                            Background="{StaticResource Brush.TileTitleDivider}" />

                                                        <Grid Margin="12,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock
                                                                x:Name="TitleText"
                                                                Grid.Column="0"
                                                                VerticalAlignment="Center"
                                                                FontSize="14"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TileForeground}"
                                                                Text="{Binding ItemObject.GANA}"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <Image
                                                                Grid.Column="2"
                                                                Width="16"
                                                                Height="16"
                                                                Margin="0"
                                                                VerticalAlignment="Center"
                                                                Source="/UI/Ressources/GTN_ICON_PLAYABLE.png"
                                                                Visibility="{Binding COISPLA, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    x:Name="Glass"
                                                    Grid.RowSpan="2"
                                                    Background="{StaticResource Brush.TileGlassFx}"
                                                    CornerRadius="{StaticResource TileCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Opacity="{StaticResource TileGlassOpacityNormal}" />

                                                <Border
                                                    x:Name="Sheen"
                                                    Grid.Row="0"
                                                    Background="{StaticResource Brush.TileSheenFx}"
                                                    CornerRadius="{StaticResource TileImageCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Opacity="{StaticResource TileSheenOpacityNormal}" />

                                                <Border
                                                    x:Name="InnerStroke"
                                                    Grid.RowSpan="2"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource Brush.Control.Edge}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource TileCornerRadius}"
                                                    IsHitTestVisible="False" />

                                                <!--  Hover: accent outline like interactive cards (Card.Interactive)  -->
                                                <Border
                                                    x:Name="HoverStroke"
                                                    Grid.RowSpan="2"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource Brush.Accent.Outline}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource TileCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />

                                                <Border
                                                    x:Name="AccentStroke"
                                                    Grid.RowSpan="2"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource Brush.AccentHover}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="{StaticResource TileCornerRadius}"
                                                    IsHitTestVisible="False"
                                                    Opacity="{StaticResource TileAccentStrokeOpacityNormal}" />
                                            </Grid>
                                        </Border>
                                    </Viewport2DVisual3D.Visual>
                                </Viewport2DVisual3D>
                            </Viewport3D>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Panel.ZIndex" Value="10" />
                            <Trigger.EnterActions>
                                <BeginStoryboard
                                    x:Name="BsHoverIn"
                                    HandoffBehavior="SnapshotAndReplace"
                                    Storyboard="{StaticResource SbHoverIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard
                                    x:Name="BsHoverOut"
                                    HandoffBehavior="SnapshotAndReplace"
                                    Storyboard="{StaticResource SbHoverOut}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Panel.ZIndex" Value="5" />
                            <Trigger.EnterActions>
                                <BeginStoryboard
                                    x:Name="BsSelectIn"
                                    HandoffBehavior="SnapshotAndReplace"
                                    Storyboard="{StaticResource SbSelectIn}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard
                                    x:Name="BsSelectOut"
                                    HandoffBehavior="SnapshotAndReplace"
                                    Storyboard="{StaticResource SbSelectOut}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>