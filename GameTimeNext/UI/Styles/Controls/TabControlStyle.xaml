<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:uiFramework="clr-namespace:GameTimeNext.Core.Framework.UI">

    <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,9" />
        <!--  Gap to the next tab (and to the "+" button), same as the add button's own margin  -->
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Text="{Binding}"
                        VerticalAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border
                            x:Name="SelectedBg"
                            Background="{DynamicResource Brush.Accent}"
                            BorderBrush="{DynamicResource Brush.Accent}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Opacity="0" />

                        <Border
                            x:Name="HoverBg"
                            Background="{StaticResource Brush.Item.Hover}"
                            CornerRadius="{StaticResource Control.CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    x:Name="IconHost"
                                    Margin="0,0,7,0"
                                    Background="Transparent"
                                    Visibility="Visible">
                                    <TextBlock
                                        x:Name="IconText"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Text="{TemplateBinding Uid}" />
                                </Border>

                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                    TextElement.Foreground="{DynamicResource Brush.TextSecondary}"
                                    TextBlock.Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="HoverBg" Property="Opacity" Value="0" />
                            <Setter TargetName="IconText" Property="Foreground" Value="White" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="White" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="White" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>

                        <Trigger Property="Uid" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Uid" Value="">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        "+" after the last tab: small glass square, centered in the track with the same gap on all sides
        (width follows the remaining height). Card brushes via DynamicResource: CardStyles.xaml is merged later.
    -->
    <Style x:Key="TabAddButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Card.Border}" />
        <!--  No left margin: the last tab already brings the gap  -->
        <Setter Property="Margin" Value="0,6,6,6" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bg"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Control.CornerRadius}">
                        <Path
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M4.5,0 L4.5,9 M0,4.5 L9,4.5"
                            Stroke="{TemplateBinding Foreground}"
                            StrokeEndLineCap="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.6" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Card.BackgroundHover}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.Item.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItemStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="uiFramework:TabControlBehaviors.EnableSelectionSwoosh" Value="True" />
        <!--  Views inside the tabs drop their own outer margin, the content area below provides it (View.Root)  -->
        <Setter Property="uiFramework:ViewHost.IsTabContent" Value="True" />

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        SnapsToDevicePixels="True">

                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Segmented tab track  -->
                            <!--
                                Recessed track; the selection runner is a lighter glass surface (card look, neutral
                                instead of accent tinted) with a thin accent line. Card brushes via DynamicResource:
                                CardStyles.xaml is merged later.
                            -->
                            <Border
                                x:Name="TabTrackHost"
                                Grid.Row="0"
                                Margin="12,12,12,0"
                                Padding="3"
                                Background="{StaticResource Brush.Input.Background}"
                                BorderThickness="0"
                                CornerRadius="{StaticResource Popup.CornerRadius}">
                                <Grid x:Name="TabTrackContentHost" ClipToBounds="True">
                                    <Border
                                        x:Name="SelectionRunner"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource Brush.Card.BackgroundHover}"
                                        BorderBrush="{DynamicResource Brush.Card.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Control.CornerRadius}"
                                        IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SelectionRunnerTransform" X="0" />
                                        </Border.RenderTransform>
                                        <Border
                                            Height="2"
                                            Margin="14,0,14,3"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource Brush.Accent}"
                                            CornerRadius="1" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                            Invisible zero-width strut with the metrics of a tab (vertical padding,
                                            icon and header line), so the track keeps its height when all tabs are closed.
                                        -->
                                        <Grid
                                            Width="0"
                                            Margin="0,9"
                                            IsHitTestVisible="False"
                                            Visibility="Hidden">
                                            <!--  NoWrap: the implicit TextBlock style wraps, which would break the text into one line per letter at zero width  -->
                                            <TextBlock
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Text="&#xE710;"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="Ag"
                                                TextWrapping="NoWrap" />
                                        </Grid>

                                        <ItemsPresenter />

                                        <!--
                                            Optional "+" after the last tab (TabControlBehaviors.ShowAddButton).
                                            The click bubbles to the window and is dispatched to the controller as EV_BtnTabAdd.
                                        -->
                                        <Button
                                            x:Name="BtnTabAdd"
                                            Style="{StaticResource TabAddButtonStyle}"
                                            ToolTip="{Binding Path=(uiFramework:TabControlBehaviors.AddButtonToolTip), RelativeSource={RelativeSource TemplatedParent}}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Tab content  -->
                            <!--  Same side inset as the tab track, so every view lines up with it  -->
                            <Grid Grid.Row="1" Margin="12" ClipToBounds="True">
                                <ContentControl
                                    x:Name="SelectedContentHost"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding SelectedContent}"
                                    ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentControl.RenderTransform>
                                        <TranslateTransform x:Name="SelectedContentTransform" X="0" />
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                            </Grid>

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="uiFramework:TabControlBehaviors.ShowAddButton" Value="True">
                            <Setter TargetName="BtnTabAdd" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Without tabs there is no preceding tab margin: same gap on the left as on the other sides  -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="BtnTabAdd" Property="Margin" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid>
                    <Border
                        x:Name="RootBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="3">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                x:Name="DefaultIconHost"
                                Margin="0,0,7,0"
                                Background="Transparent"
                                Visibility="Visible">
                                <TextBlock
                                    x:Name="DefaultIconText"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="{TemplateBinding Uid}" />
                            </Border>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.FontWeight="{TemplateBinding FontWeight}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Border>

                    <!--  Selected tab: accent underline sitting on the header separator  -->
                    <Border
                        x:Name="Underline"
                        Height="2"
                        Margin="8,0"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource Brush.Accent}"
                        CornerRadius="1"
                        Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="0.4" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="DefaultIconText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.6" />
                            <Setter TargetName="DefaultIconText" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>

                        <Trigger Property="Uid" Value="{x:Null}">
                            <Setter TargetName="DefaultIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Uid" Value="">
                            <Setter TargetName="DefaultIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultTabItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  No side insets: the view root (View.Root) already provides the outer margin  -->
                            <Border
                                Grid.Row="0"
                                Padding="0,4,0,0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1">
                                <TabPanel
                                    HorizontalAlignment="Left"
                                    Background="Transparent"
                                    ClipToBounds="False"
                                    IsItemsHost="True"
                                    KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <!--
                                Deliberately not named PART_SelectedContentHost: with that name WPF moves keyboard focus
                                into the content on a tab click, which scrolls the first focusable element to the top.
                            -->
                            <ContentPresenter
                                x:Name="SelectedContentHost"
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                ContentSource="SelectedContent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultTabItemStyle}" TargetType="{x:Type TabItem}" />

    <Style BasedOn="{StaticResource DefaultTabControlStyle}" TargetType="{x:Type TabControl}" />

</ResourceDictionary>
