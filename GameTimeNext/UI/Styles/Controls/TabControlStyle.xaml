<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uiFramework="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine" xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine">

    <!--  Glass track: dark tint, so the muted tab texts stay readable on a bright cover behind it  -->
    <SolidColorBrush x:Key="Brush.Tab.TrackGlass" Color="#660E0E12" />

    <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <!--  Gap to the next tab (and to the "+" button), same as the add button's own margin  -->
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border
                            x:Name="SelectedBg"
                            Background="{DynamicResource Brush.Accent}"
                            BorderBrush="{DynamicResource Brush.Accent}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Opacity="0" />

                        <Border
                            x:Name="HoverBg"
                            Background="{StaticResource Brush.Item.Hover}"
                            CornerRadius="{StaticResource Control.CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    x:Name="IconHost"
                                    Margin="0,0,7,0"
                                    Background="Transparent"
                                    Visibility="Visible">
                                    <TextBlock
                                        x:Name="IconText"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="16"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Text="{TemplateBinding Uid}" />
                                </Border>

                                <ContentPresenter
                                    x:Name="HeaderPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    TextBlock.Foreground="{DynamicResource Brush.TextSecondary}"
                                    TextElement.FontSize="{TemplateBinding FontSize}"
                                    TextElement.FontWeight="{TemplateBinding FontWeight}"
                                    TextElement.Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="White" />
                            <Setter TargetName="IconText" Property="Foreground" Value="White" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="White" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="White" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="HeaderPresenter" Property="TextBlock.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>

                        <Trigger Property="Uid" Value="{x:Null}">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Uid" Value="">
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Hover fades like the buttons; the selected tab has the runner instead  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        "+" after the last tab: small glass square, centered in the track with the same gap on all sides
        (width follows the remaining height). Same template as all buttons, so glass, hover and pressed are the same.
    -->
    <Geometry x:Key="TabAddButton.Glyph">M4.5,0 L4.5,9 M0,4.5 L9,4.5</Geometry>
    <Geometry x:Key="TabFavoritesButton.Glyph">M0.5,2.5 L4.5,6.5 L8.5,2.5</Geometry>

    <!--  The glyph (9 x 9 line drawing) is the button's Tag, so the "favorites" button can share the template  -->
    <Style x:Key="TabAddButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Tag" Value="{StaticResource TabAddButton.Glyph}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Button.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Button.GlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!--  No left margin: the last tab already brings the gap  -->
        <Setter Property="Margin" Value="0,6,6,6" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path
                        Width="9"
                        Height="9"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="1.6" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Down arrow before the "+": opens the start order of the favorites (TabControlBehaviors.ShowFavoritesButton)  -->
    <Style
        x:Key="TabFavoritesButtonStyle"
        BasedOn="{StaticResource TabAddButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Tag" Value="{StaticResource TabFavoritesButton.Glyph}" />
    </Style>

    <Style x:Key="ModernTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernTabItemStyle}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="uiFramework:TabControlBehaviors.EnableSelectionSwoosh" Value="True" />
        <!--  Views inside the tabs drop their own outer margin, the content area below provides it (View.Root)  -->
        <Setter Property="uiFramework:ViewHost.IsTabContent" Value="True" />

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource DefaultCornerRadius}"
                        SnapsToDevicePixels="True">

                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Segmented tab track  -->
                            <!--
                                Glass track like the buttons (translucent fill, diagonal rim, light in the corners); the
                                selection runner is a lighter glass surface with a thin accent line. Padding + rim = 3.
                            -->
                            <Grid
                                Grid.Row="0"
                                Margin="12,12,12,0"
                                IsHitTestVisible="False">
                                <Border Background="{StaticResource Brush.Tab.TrackGlass}" CornerRadius="{StaticResource Popup.CornerRadius}" />
                                <Border Background="{StaticResource Brush.Button.GlassLightStart}" CornerRadius="{StaticResource Popup.CornerRadius}" />
                                <Border Background="{StaticResource Brush.Button.GlassLightEnd}" CornerRadius="{StaticResource Popup.CornerRadius}" />
                            </Grid>

                            <Border
                                x:Name="TabTrackHost"
                                Grid.Row="0"
                                Margin="12,12,12,0"
                                Padding="2"
                                Background="Transparent"
                                BorderBrush="{StaticResource Brush.Button.GlassRim}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Popup.CornerRadius}">
                                <Grid x:Name="TabTrackContentHost" ClipToBounds="True">
                                    <Border
                                        x:Name="SelectionRunner"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{StaticResource Brush.Item.Selected}"
                                        BorderBrush="{StaticResource Brush.Button.GlassRim}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Control.CornerRadius}"
                                        IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SelectionRunnerTransform" X="0" />
                                        </Border.RenderTransform>
                                        <Border
                                            Height="2"
                                            Margin="14,0,14,3"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource Brush.Accent}"
                                            CornerRadius="1" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <!--
                                            Invisible zero-width strut with the metrics of a tab (vertical padding,
                                            icon and header line), so the track keeps its height when all tabs are closed.
                                        -->
                                        <Grid
                                            Width="0"
                                            Margin="0,8"
                                            IsHitTestVisible="False"
                                            Visibility="Hidden">
                                            <!--  NoWrap: the implicit TextBlock style wraps, which would break the text into one line per letter at zero width  -->
                                            <TextBlock
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="16"
                                                Text="&#xE710;"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Text="Ag"
                                                TextWrapping="NoWrap" />
                                        </Grid>

                                        <ItemsPresenter />

                                        <!--
                                            Optional favorites button and "+" after the last tab (TabControlBehaviors.ShowFavoritesButton /
                                            ShowAddButton). The clicks bubble to the window and are dispatched to the controller as
                                            EV_btnTabFavorites / EV_BtnTabAdd.
                                        -->
                                        <Button
                                            x:Name="btnTabFavorites"
                                            Style="{StaticResource TabFavoritesButtonStyle}"
                                            ToolTip="{Binding Path=(uiFramework:TabControlBehaviors.FavoritesButtonToolTip), RelativeSource={RelativeSource TemplatedParent}}"
                                            Visibility="Collapsed" />

                                        <Button
                                            x:Name="BtnTabAdd"
                                            Style="{StaticResource TabAddButtonStyle}"
                                            ToolTip="{Binding Path=(uiFramework:TabControlBehaviors.AddButtonToolTip), RelativeSource={RelativeSource TemplatedParent}}"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Tab content  -->
                            <!--  Same side inset as the tab track, so every view lines up with it  -->
                            <Grid
                                Grid.Row="1"
                                Margin="12"
                                ClipToBounds="True">
                                <ContentControl
                                    x:Name="SelectedContentHost"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding SelectedContent}"
                                    ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                    Opacity="1"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                    <ContentControl.RenderTransform>
                                        <TranslateTransform x:Name="SelectedContentTransform" X="0" />
                                    </ContentControl.RenderTransform>
                                </ContentControl>
                            </Grid>

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="uiFramework:TabControlBehaviors.ShowAddButton" Value="True">
                            <Setter TargetName="BtnTabAdd" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="uiFramework:TabControlBehaviors.ShowFavoritesButton" Value="True">
                            <Setter TargetName="btnTabFavorites" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Without tabs there is no preceding tab margin: same gap on the left as on the other sides  -->
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="BtnTabAdd" Property="Margin" Value="6" />
                            <Setter TargetName="btnTabFavorites" Property="Margin" Value="6" />
                        </Trigger>

                        <!--  The favorites button brings the left gap, the "+" follows it  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasItems" Value="False" />
                                <Condition Property="uiFramework:TabControlBehaviors.ShowFavoritesButton" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="BtnTabAdd" Property="Margin" Value="0,6,6,6" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!--  Height, not vertical padding: with the track's padding and edge it adds up to Control.Height  -->
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontSize" Value="13" />
        <!--  Same weight in all states: a tab that changes its width on selection would move its neighbors  -->
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <!--  Explicit color of the tab item (muted / hovered / selected / error): the implicit TextBlock style would pin the header to white  -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                        Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid Background="Transparent">
                        <!--  The selection is the SelectionRunner of the tab control, which slides between the tabs  -->
                        <Border
                            x:Name="HoverBg"
                            Background="{StaticResource Brush.Item.Hover}"
                            CornerRadius="{StaticResource Control.CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border x:Name="RootBorder" Padding="{TemplateBinding Padding}">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    x:Name="DefaultIconHost"
                                    Margin="0,0,7,0"
                                    Background="Transparent"
                                    Visibility="Visible">
                                    <TextBlock
                                        x:Name="DefaultIconText"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Text="{TemplateBinding Uid}" />
                                </Border>

                                <!--  Validation error on a field of this tab (UIXTabValidation.HasErrors, set by the engine); takes the place of the tab icon  -->
                                <TextBlock
                                    x:Name="ErrorIcon"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource Font.Icons}"
                                    FontSize="14"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Text="&#xE783;"
                                    Visibility="Collapsed" />

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="DefaultIconText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="DefaultIconText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <!--  Hover fades like the buttons; the selected tab has the runner instead  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBg"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.6" />
                            <Setter TargetName="DefaultIconText" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>

                        <Trigger Property="Uid" Value="{x:Null}">
                            <Setter TargetName="DefaultIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Uid" Value="">
                            <Setter TargetName="DefaultIconHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Last, so it wins over hover: the header stays in the danger color  -->
                        <Trigger Property="uixprops:UIXTabValidation.HasErrors" Value="True">
                            <Setter TargetName="DefaultIconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DefaultTabItemStyle}" />
        <!--  The selection runner slides between the tabs (TabControlBehaviors), the content has no transition  -->
        <Setter Property="uiFramework:TabControlBehaviors.EnableSelectionSwoosh" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                Unlike the app tab bar (full width, raised glass, accent line) this one belongs to the content:
                                a compact track recessed like the input fields, with a glass runner with an accent edge inside it
                                (no accent fill: it looks muddy with a bright accent on the dark track).
                                No side insets: the view root (View.Root) already provides the outer margin.
                                Padding + edge = 3, so track and tabs add up to Control.Height.
                            -->
                            <Border
                                Grid.Row="0"
                                Padding="2"
                                HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Input.Glass}"
                                BorderBrush="{StaticResource Brush.Input.Edge}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Popup.CornerRadius}">
                                <Grid x:Name="TabTrackContentHost">
                                    <Border
                                        x:Name="SelectionRunner"
                                        Width="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{StaticResource Brush.Item.Selected}"
                                        BorderBrush="{DynamicResource Brush.Accent.Outline}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Control.CornerRadius}"
                                        IsHitTestVisible="False">
                                        <!--  Named: unnamed freezables in templates get frozen and can't be animated  -->
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SelectionRunnerTransform" />
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Border Background="{StaticResource Brush.Button.GlassLightStart}" CornerRadius="5" />
                                            <Border Background="{StaticResource Brush.Button.GlassLightEnd}" CornerRadius="5" />
                                        </Grid>
                                    </Border>

                                    <!--  StackPanel like the app tab bar: drag and drop needs it, and the keyboard settings are the ones of a TabPanel  -->
                                    <StackPanel
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabIndex="1"
                                        KeyboardNavigation.TabNavigation="Once"
                                        Orientation="Horizontal" />
                                </Grid>
                            </Border>

                            <!--
                                Deliberately not named PART_SelectedContentHost: with that name WPF moves keyboard focus
                                into the content on a tab click, which scrolls the first focusable element to the top.
                            -->
                            <ContentPresenter
                                x:Name="SelectedContentHost"
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                ContentSource="SelectedContent" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultTabItemStyle}" TargetType="{x:Type TabItem}" />

    <Style BasedOn="{StaticResource DefaultTabControlStyle}" TargetType="{x:Type TabControl}" />

    <!--  Engine TabControl (UIXTabControl): implicit styles only apply to the exact type  -->
    <Style BasedOn="{StaticResource {x:Type TabControl}}" TargetType="{x:Type uixsel:UIXTabControl}" />

</ResourceDictionary>
