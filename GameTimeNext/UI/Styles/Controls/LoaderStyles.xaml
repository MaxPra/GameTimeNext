<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Accent Brushes (Dynamic)  -->
    <SolidColorBrush x:Key="Brush.LoaderAccent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.LoaderAccentHover" Color="{DynamicResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.LoaderAccentPressed" Color="{DynamicResource Color.AccentPressed}" />

    <!--  Loader Overlay Style  -->
    <Style x:Key="GTNLoadingOverlayStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Panel.ZIndex" Value="999" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">

                    <Grid
                        x:Name="Root"
                        Background="#7A000000"
                        IsHitTestVisible="True">

                        <Grid
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                            </Grid.RenderTransform>

                            <Path
                                Data="M 12,36 A 24,24 0 0 1 60,36"
                                Stroke="{DynamicResource Brush.Accent}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="4">
                                <Path.Effect>
                                    <DropShadowEffect
                                        BlurRadius="8"
                                        Opacity="0.45"
                                        ShadowDepth="0"
                                        Color="{DynamicResource Color.Accent}" />
                                </Path.Effect>
                            </Path>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoaderStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LoaderStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>