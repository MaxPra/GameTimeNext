<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixcb="clr-namespace:UIX.ViewController.Engine.FrameworkElements.ComboBoxes;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine">

    <!--  Same values as the Input/Popup/Item tokens (ControlTokens.xaml)  -->
    <SolidColorBrush x:Key="Brush.ComboBox.PopupBackground" Color="#FF17171D" />
    <SolidColorBrush x:Key="Brush.ComboBox.BorderHover" Color="#FF383843" />
    <SolidColorBrush x:Key="Brush.ComboBox.ItemHover" Color="#FF212129" />
    <SolidColorBrush x:Key="Brush.ComboBox.ItemSelected" Color="#FF26262F" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource Color.TextPrimary}" />

    <!--
        Codetable entry of a UIXComboBox (UIXManualCodetable, UIXAttachedProperty.Source): the key as a badge in front of the text,
        in the drop down and in the selection box. The text takes the foreground of the item / ComboBox (disabled state).
        The key column is shared by all entries (SharedSizeGroup, scope set by the UIXComboBox style), so the badges
        have the width of the longest key and all texts start on one line.
        The bottom margin of the texts lifts them to the line of the TextBox text (the text line of Manrope sits low); the badge stays centered.
    -->
    <DataTemplate DataType="{x:Type uixcb:UIXComboBoxEntry}">
        <Grid>
            <Grid x:Name="EntryGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="UIXComboBoxKey" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    x:Name="KeyBadge"
                    Grid.Column="0"
                    MinWidth="28"
                    Margin="0,0,8,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource Brush.ComboBox.BorderHover}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Item.CornerRadius}">
                    <TextBlock
                        x:Name="txKey"
                        Margin="0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="{Binding Key}"
                        TextWrapping="NoWrap" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,2"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Control}}}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>

            <!--  "(None)" / "(All)": no key, muted text, not indented to the text column  -->
            <TextBlock
                x:Name="AdditionalText"
                Margin="0,0,0,2"
                Foreground="{DynamicResource Brush.TextSecondary}"
                Text="{Binding Text}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Visibility="Collapsed" />

            <!--  "Add new entry" (UIXComboBox.NewEntryText): an action at the top, accent colored with a plus  -->
            <StackPanel
                x:Name="NewEntryPanel"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource Font.Icons}"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.Accent}"
                    Text="&#xE710;" />
                <TextBlock
                    Margin="0,0,0,2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.Accent}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ShowKey}" Value="False">
                <Setter TargetName="KeyBadge" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsNewEntry}" Value="True">
                <Setter TargetName="EntryGrid" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="NewEntryPanel" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsAdditional}" Value="True">
                <Setter TargetName="EntryGrid" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="AdditionalText" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Control}}}" Value="False">
                <Setter TargetName="txKey" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                <Setter TargetName="AdditionalText" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <!--  With the border and margin of the drop down: below the text of the selection box  -->
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border
                        x:Name="ItemBorder"
                        Margin="0,1"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{StaticResource Item.CornerRadius}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Item.Hover}" />
                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Item.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Item.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="ItemBorder" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Input.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Input.Edge}" />
        <Setter Property="BorderThickness" Value="{StaticResource Control.BorderThickness}" />
        <!--  Text starts at the same position as the text of a TextBox (its padding plus the inset of the text host)  -->
        <Setter Property="Padding" Value="13,0,6,0" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Height" Value="{StaticResource Control.Height}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border
                            x:Name="OuterBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Control.CornerRadius}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>

                                <!--  Spans the whole box, so a click anywhere opens the drop down (not only on the arrow)  -->
                                <ToggleButton
                                    x:Name="ToggleButton"
                                    Grid.ColumnSpan="2"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    ClickMode="Press"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <Path
                                                    x:Name="pthArrow"
                                                    Width="10"
                                                    Height="6"
                                                    Margin="0,0,13,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Data="M 0.75 0.75 L 4.75 4.75 L 8.75 0.75"
                                                    Stroke="{DynamicResource Brush.TextSecondary}"
                                                    StrokeEndLineCap="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="1.5" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="pthArrow" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!--  Not hit test visible: clicks pass through to the toggle button below  -->
                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    RecognizesAccessKey="True" />
                            </Grid>
                        </Border>

                        <Border x:Name="HoverRim" Style="{StaticResource Input.HoverRim}" />
                        <Border x:Name="FocusRim" Style="{StaticResource Input.FocusRim}" />
                        <Border x:Name="OpenRim" Style="{StaticResource Input.OpenRim}" />

                        <Popup
                            x:Name="Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade"
                            VerticalOffset="4">
                            <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <!--  Glass like the context menus. No outer margin: the drop down lines up with the field (the gap is the offset of the popup, the blur fills the popup window)  -->
                                <Border Margin="0" Style="{StaticResource Popup.Surface}">
                                    <ScrollViewer
                                        Margin="4"
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="OuterBorder" Property="Opacity" Value="0.65" />
                        </Trigger>

                        <!--  Marked by the engine (red adorner on top): no hover / focus outline next to the mark  -->
                        <Trigger Property="uixprops:UIXFieldValidation.HasError" Value="True">
                            <Setter TargetName="HoverRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="OpenRim" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Implicit styles only match the exact type, so the codetable ComboBox takes over the ComboBox look.
        Shared size scope: the key column of the entries (drop down and selection box) has one width.
    -->
    <Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="{x:Type uixcb:UIXComboBox}">
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    </Style>

</ResourceDictionary>