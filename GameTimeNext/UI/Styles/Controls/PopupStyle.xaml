<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />

    <!--  Outer margin of opaque popups: room for the shadow, otherwise the popup window cuts it off  -->
    <Thickness x:Key="Popup.ShadowMargin">6,2,6,10</Thickness>

    <!--
        Surface of a popup (context menu, filter popup, ...). Glass where supported (see PopupGlass):
        translucent tint over the blurred background, no margin / shadow because the blur fills the popup window.
        Otherwise opaque with shadow. Opening and closing are animated by PopupMotion, which also switches the blur on.
    -->
    <Style x:Key="Popup.Surface" TargetType="{x:Type Border}">
        <Setter Property="ui:PopupGlass.IsEnabled" Value="True" />
        <Setter Property="ui:PopupMotion.IsEnabled" Value="True" />
        <Setter Property="Background" Value="{StaticResource Brush.Popup.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
        <Setter Property="Margin" Value="{StaticResource Popup.ShadowMargin}" />
        <Setter Property="Effect" Value="{StaticResource Effect.Popup}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="ui:PopupGlass.IsActive" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Popup.Glass}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Popup.GlassBorder}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="ModernPopupCardStyle"
        BasedOn="{StaticResource Popup.Surface}"
        TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="14" />
    </Style>

</ResourceDictionary>