<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--  Same values as the Brush.Input.* tokens (ControlTokens.xaml); the keys are used by other styles too  -->
    <SolidColorBrush x:Key="Brush.TextBox.Background" Color="#590A0A0E" />
    <SolidColorBrush x:Key="Brush.TextBox.Border" Color="#FF292932" />
    <SolidColorBrush x:Key="Brush.TextBox.BorderHover" Color="#FF383843" />

    <!--  Focus changes the color, not the thickness (no layout jump)  -->
    <Thickness x:Key="Thickness.TextBox.Border">1</Thickness>
    <Thickness x:Key="Thickness.TextBox.BorderFocused">1</Thickness>

    <Style x:Key="TextBox.Default" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />

        <Setter Property="Background" Value="{DynamicResource Brush.TextBox.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Input.Edge}" />
        <Setter Property="BorderThickness" Value="{DynamicResource Thickness.TextBox.Border}" />

        <!--  One pixel higher: the text line of Manrope sits low, this aligns it with the text of buttons and combo boxes next to it  -->
        <Setter Property="Padding" Value="11,5,11,7" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Height" Value="{StaticResource Control.Height}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />

        <Setter Property="ui:TextBoxBehaviors.SelectAllOnFocus" Value="True" />

        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />

        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Height="{TemplateBinding Height}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Control.CornerRadius}"
                            SnapsToDevicePixels="True">

                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="0"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Focusable="False" />

                                <TextBlock
                                    x:Name="Watermark"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    IsHitTestVisible="False"
                                    Opacity="0.70"
                                    Text="{TemplateBinding Tag}"
                                    Visibility="Collapsed">
                                    <!--  The margin moves it further than the text in the text host: same line as the typed text, no jump  -->
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform Y="1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border x:Name="HoverRim" Style="{StaticResource Input.HoverRim}" />
                        <Border x:Name="FocusRim" Style="{StaticResource Input.FocusRim}" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                        </Trigger>

                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="{DynamicResource Thickness.TextBox.BorderFocused}" />
                            <Setter TargetName="HoverRim" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="FocusRim" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocusWithin" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.TextBox.Background}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource TextBox.Default}" TargetType="{x:Type TextBox}" />

</ResourceDictionary>