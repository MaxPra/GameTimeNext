<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Button.Background" Color="#20242D" />
    <SolidColorBrush x:Key="Brush.Button.Border" Color="#3B4150" />
    <SolidColorBrush x:Key="Brush.Button.HoverBorder" Color="#576176" />

    <SolidColorBrush x:Key="Brush.TitleBarButton.Background" Color="#1B1B22" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Border" Color="#353542" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Hover" Color="#272733" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Pressed" Color="#17171F" />

    <SolidColorBrush x:Key="Brush.TitleBarButton.Close" Color="#C65B5B" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Icon" Color="#C3C3CD" />

    <!--  Title Bar Buttons  -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.TitleBarButton.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.TitleBarButton.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TitleBarButton.Icon}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <Border
                            x:Name="HoverOverlay"
                            Background="{DynamicResource Brush.TitleBarButton.Hover}"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border
                            x:Name="PressedOverlay"
                            Background="{DynamicResource Brush.TitleBarButton.Pressed}"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            x:Name="IconPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            Opacity="0.92"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#4B4B5B" />
                            <Setter TargetName="IconPresenter" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.14" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Chrome"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="-0.75"
                                            Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Chrome"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="IconPresenter" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            <Setter TargetName="IconPresenter" Property="Opacity" Value="0" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TitleBarMinButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TitleBarButton.Icon}" />
    </Style>

    <Style
        x:Key="TitleBarMaxButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TitleBarButton.Icon}" />
    </Style>

    <!--  Title Bar Close Button  -->
    <Style
        x:Key="TitleBarCloseButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TitleBarButton.Icon}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0" />
                            </Border.RenderTransform>
                        </Border>

                        <Border
                            x:Name="CloseHoverOverlay"
                            Background="#4A2222"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border
                            x:Name="ClosePressedOverlay"
                            Background="#3A1A1A"
                            CornerRadius="4"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            x:Name="IconPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.92"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.TitleBarButton.Close}" />
                            <Setter TargetName="IconPresenter" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FFE6E6E8" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CloseHoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.14" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Chrome"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="-0.75"
                                            Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="CloseHoverOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Chrome"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.TitleBarButton.Close}" />
                            <Setter TargetName="ClosePressedOverlay" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            <Setter TargetName="IconPresenter" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="BorderThickness" Value="2.2" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid SnapsToDevicePixels="True">

                        <Border
                            x:Name="Base"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource DefaultCornerRadius}" />

                        <Border
                            x:Name="Hover"
                            Background="{DynamicResource Brush.AccentHover}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border
                            x:Name="Pressed"
                            Background="{DynamicResource Brush.AccentPressed}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            x:Name="Content"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            RecognizesAccessKey="True" />

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Hover"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Hover"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pressed" Property="Opacity" Value="1" />
                            <Setter TargetName="Hover" Property="Opacity" Value="0" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Base" Property="Opacity" Value="0.55" />
                            <Setter TargetName="Hover" Property="Opacity" Value="0" />
                            <Setter TargetName="Pressed" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Button.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Button.Border}" />
        <Setter Property="BorderThickness" Value="1.6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Border
                            x:Name="Base"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{TemplateBinding Foreground}"
                                RecognizesAccessKey="True" />
                        </Border>

                        <Border
                            x:Name="HoverBorder"
                            BorderBrush="{StaticResource Brush.Button.HoverBorder}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <Border
                            x:Name="PressedBorder"
                            BorderBrush="{DynamicResource Brush.AccentPressed}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverBorder"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="HoverBorder" Property="Opacity" Value="0" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Base" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProfileAccentColorToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <Border
                            x:Name="OuterGlow"
                            Margin="-3"
                            Background="Transparent"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="16"
                                    Opacity="0.35"
                                    ShadowDepth="0"
                                    Color="{DynamicResource Color.Accent}" />
                            </Border.Effect>
                        </Border>

                        <Border
                            x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource DefaultCornerRadius}"
                            SnapsToDevicePixels="True">

                            <Grid>
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="#12FFFFFF"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Opacity="0" />

                                <Border
                                    x:Name="SelectionBorder"
                                    Margin="-10"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="3"
                                    CornerRadius="{StaticResource DefaultCornerRadius}"
                                    Opacity="0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="SelectionBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="1" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionBorder" Property="Opacity" Value="1" />
                            <Setter TargetName="OuterGlow" Property="Opacity" Value="1" />
                        </MultiTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>