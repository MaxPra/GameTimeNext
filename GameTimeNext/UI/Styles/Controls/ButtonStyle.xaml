<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Former neutral button brushes, kept for compatibility (see ControlTokens.xaml for the current ones)  -->
    <SolidColorBrush x:Key="Brush.Button.Background" Color="#FF1E1E26" />
    <SolidColorBrush x:Key="Brush.Button.Border" Color="#FF292932" />
    <SolidColorBrush x:Key="Brush.Button.HoverBorder" Color="#FF383843" />

    <!--
        ===== Title bar buttons =====
        Borderless, the icon is the content (glyph bound to the button Foreground, see WindowStyle.xaml).
        Hover: light glass tint; close: red fill with white icon like the Windows caption buttons.
    -->
    <SolidColorBrush x:Key="Brush.TitleBarButton.Icon" Color="#FFB4B4BE" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Pressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Close" Color="#FFD9434B" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.ClosePressed" Color="#FFB23A41" />

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TitleBarButton.Icon}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Control.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TitleBarMinButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button" />

    <Style
        x:Key="TitleBarMaxButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button" />

    <Style
        x:Key="TitleBarCloseButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Control.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Close}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.ClosePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== Buttons =====
        One flat template for all buttons: fill without border, hover/pressed as overlay (works on any fill),
        accent focus ring only for keyboard navigation (FocusVisualStyle).

          (implicit)        neutral button
          Button.Primary    accent fill, the main action of a view (Button.Secondary is the old name, kept for compatibility)
          Button.Ghost      no fill until hovered, for icon buttons and secondary actions
          Button.Icon       square neutral button for a single icon (no padding, otherwise the icon gets clipped)
    -->

    <Style x:Key="FocusVisual.Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Template.Button" TargetType="{x:Type ButtonBase}">
        <ControlTemplate.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ControlTemplate.Resources>

        <Grid x:Name="Root" SnapsToDevicePixels="True">
            <!--  Shadow only on the background shape (an effect on the content would blur the text)  -->
            <Border
                x:Name="Base"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Control.CornerRadius}"
                Effect="{StaticResource Effect.Control}" />

            <Border
                x:Name="Overlay"
                Background="Transparent"
                CornerRadius="{StaticResource Control.CornerRadius}"
                IsHitTestVisible="False" />

            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True"
                TextElement.Foreground="{TemplateBinding Foreground}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource Brush.Control.HoverOverlay}" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Overlay" Property="Background" Value="{StaticResource Brush.Control.PressedOverlay}" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Control.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Control}" />
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
        <Style.Triggers>
            <!--  Accent outline on hover (drawn by the background border, so the content doesn't move)  -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="Button.Primary"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Control.Edge}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Former name of Button.Primary, still used by existing views  -->
    <Style
        x:Key="Button.Secondary"
        BasedOn="{StaticResource Button.Primary}"
        TargetType="Button" />

    <Style
        x:Key="Button.Ghost"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Icon only: same height as inputs, square, the icon is centered without the text padding  -->
    <Style
        x:Key="Button.Icon"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Control.Height}" />
        <Setter Property="Height" Value="{StaticResource Control.Height}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--
        Accent color swatch (profile edit): round color dot; selected shows a ring in its own color and a check mark,
        hover lifts it slightly. The color comes from Background (set by the controller).
    -->
    <Style x:Key="ProfileAccentColorToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="Transparent">

                        <!--  Selection ring in the swatch color, separated from the dot by a small gap  -->
                        <Ellipse
                            x:Name="SelectionRing"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="2.5" />

                        <Grid
                            x:Name="Swatch"
                            Margin="7"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SwatchScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Ellipse
                                x:Name="Dot"
                                Fill="{TemplateBinding Background}"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.35"
                                        ShadowDepth="2"
                                        Color="Black" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!--  Soft top highlight for some depth  -->
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#30FFFFFF" />
                                        <GradientStop Offset="0.55" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <TextBlock
                                x:Name="CheckMark"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Text="&#xE73E;">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="0.35" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="1" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Swatch" Property="Opacity" Value="0.4" />
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>