<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine">

    <!--  Former neutral button brushes, kept for compatibility (see ControlTokens.xaml for the current ones)  -->
    <SolidColorBrush x:Key="Brush.Button.Background" Color="#FF1E1E26" />
    <SolidColorBrush x:Key="Brush.Button.Border" Color="#FF292932" />
    <SolidColorBrush x:Key="Brush.Button.HoverBorder" Color="#FF383843" />

    <!--
        ===== Title bar buttons =====
        Borderless, the icon is the content (glyph bound to the button Foreground, see WindowStyle.xaml).
        Hover: light glass tint; close: red fill with white icon like the Windows caption buttons.
    -->
    <SolidColorBrush x:Key="Brush.TitleBarButton.Icon" Color="#FFB4B4BE" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Hover" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Pressed" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.Close" Color="#FFD9434B" />
    <SolidColorBrush x:Key="Brush.TitleBarButton.ClosePressed" Color="#FFB23A41" />

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TitleBarButton.Icon}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Control.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="TitleBarMinButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button" />

    <Style
        x:Key="TitleBarMaxButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button" />

    <Style
        x:Key="TitleBarCloseButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Control.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.Close}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.TitleBarButton.ClosePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== Buttons =====
        One template for all buttons: fill with a glass layer on top (white light, so it works on any fill),
        hover/pressed fade in as overlays (the hover outline comes from Brush.Accent.Outline, which a style can override
        in its Style.Resources), accent focus ring only for keyboard navigation (FocusVisualStyle).
        Without a border (Button.Ghost) there is no surface, so the glass layer is off.

        (implicit)        neutral button
        Button.Primary    accent fill, the main action of a view (Button.Secondary is the old name, kept for compatibility)
        Button.Ghost      no fill until hovered, for icon buttons and secondary actions
        Button.Icon       square neutral button for a single icon (no padding, otherwise the icon gets clipped)
    -->

    <Style x:Key="FocusVisual.Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource Brush.Accent}"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Glass: translucent fill of neutral buttons, the background shows through  -->
    <SolidColorBrush x:Key="Brush.Button.Glass" Color="#0FFFFFFF" />

    <!--  Glass: thin diagonal rim, the light catches the upper left and the lower right corner, almost nothing between them  -->
    <LinearGradientBrush x:Key="Brush.Button.GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#52FFFFFF" />
        <GradientStop Offset="0.3" Color="#12FFFFFF" />
        <GradientStop Offset="0.7" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#2EFFFFFF" />
    </LinearGradientBrush>

    <!--  Glass: soft light inside the same two corners, no gradient across the whole surface  -->
    <RadialGradientBrush x:Key="Brush.Button.GlassLightStart" Center="0,0" GradientOrigin="0,0" RadiusX="0.8" RadiusY="1.6">
        <GradientStop Offset="0" Color="#0DFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Brush.Button.GlassLightEnd" Center="1,1" GradientOrigin="1,1" RadiusX="0.6" RadiusY="1.2">
        <GradientStop Offset="0" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </RadialGradientBrush>

    <!--  Check of the save confirmation, on the circle in the text color  -->
    <SolidColorBrush x:Key="Brush.Button.SavedCheck" Color="#FF14141A" />

    <ControlTemplate x:Key="Template.Button" TargetType="{x:Type ButtonBase}">
        <ControlTemplate.Resources>
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ControlTemplate.Resources>

        <Grid
            x:Name="Root"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <!--  Shadow only on the background shape (an effect on the content would blur the text)  -->
            <Border
                x:Name="Base"
                Background="{TemplateBinding Background}"
                CornerRadius="{StaticResource Control.CornerRadius}"
                Effect="{StaticResource Effect.Control}" />

            <!--  Light inside the glass  -->
            <Grid x:Name="Glass" IsHitTestVisible="False">
                <Border Background="{StaticResource Brush.Button.GlassLightStart}" CornerRadius="{StaticResource Control.CornerRadius}" />
                <Border Background="{StaticResource Brush.Button.GlassLightEnd}" CornerRadius="{StaticResource Control.CornerRadius}" />
            </Grid>

            <!--  Rim in its own layer: under the shadow effect the fine line would be rasterized and look uneven  -->
            <Border
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Control.CornerRadius}"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True" />

            <!--  Hover and pressed states are layers that fade, so nothing changes abruptly  -->
            <Border
                x:Name="HoverRim"
                BorderBrush="{DynamicResource Brush.Accent.Outline}"
                BorderThickness="1"
                CornerRadius="{StaticResource Control.CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0"
                SnapsToDevicePixels="True" />

            <Border
                x:Name="Overlay"
                Background="{StaticResource Brush.Control.HoverOverlay}"
                CornerRadius="{StaticResource Control.CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />

            <Border
                x:Name="PressedOverlay"
                Background="{StaticResource Brush.Control.PressedOverlay}"
                CornerRadius="{StaticResource Control.CornerRadius}"
                IsHitTestVisible="False"
                Opacity="0" />


            <ContentPresenter
                x:Name="Content"
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                RecognizesAccessKey="True"
                TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter.RenderTransform>
                    <TranslateTransform />
                </ContentPresenter.RenderTransform>
            </ContentPresenter>

            <!--  Save confirmation (UIXSaveFeedback.IsSaved, set by the engine after a successful save): a filled circle with a check in place of the content  -->
            <Grid
                x:Name="SavedBadge"
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                </Grid.RenderTransform>

                <Ellipse Fill="{TemplateBinding Foreground}" />

                <Path
                    x:Name="SavedCheck"
                    Width="11"
                    Height="9"
                    Margin="0,1,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M 1,4.5 L 4,7.5 L 10,1"
                    Stroke="{StaticResource Brush.Button.SavedCheck}"
                    StrokeDashArray="7 20"
                    StrokeDashOffset="7"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="2" />
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <!--  One trigger for showing and hiding (see "Trigger animations" in CLAUDE.md)  -->
            <Trigger Property="uixprops:UIXSaveFeedback.IsSaved" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Content"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.12" />
                            <DoubleAnimation
                                Storyboard.TargetName="Content"
                                Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                To="-4"
                                Duration="0:0:0.12" />
                            <DoubleAnimation
                                BeginTime="0:0:0.08"
                                Storyboard.TargetName="SavedBadge"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:0.1" />
                            <DoubleAnimation
                                BeginTime="0:0:0.08"
                                Storyboard.TargetName="SavedBadge"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                From="0.6"
                                To="1"
                                Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                BeginTime="0:0:0.08"
                                Storyboard.TargetName="SavedBadge"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                From="0.6"
                                To="1"
                                Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                BeginTime="0:0:0.16"
                                Storyboard.TargetName="SavedCheck"
                                Storyboard.TargetProperty="StrokeDashOffset"
                                From="7"
                                To="0"
                                Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SavedBadge"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                BeginTime="0:0:0.1"
                                Storyboard.TargetName="Content"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.15" />
                            <DoubleAnimation
                                BeginTime="0:0:0.1"
                                Storyboard.TargetName="Content"
                                Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                From="4"
                                To="0"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Overlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0.7"
                                Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverRim"
                                Storyboard.TargetProperty="Opacity"
                                To="0.8"
                                Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="Overlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverRim"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="BorderThickness" Value="0">
                <Setter TargetName="Glass" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <!--  Pressed: sinks in quickly, springs back softly on release  -->
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressedOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="Glass"
                                Storyboard.TargetProperty="Opacity"
                                To="0.5"
                                Duration="0:0:0.08" />
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                To="0.98"
                                Duration="0:0:0.09">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                To="0.96"
                                Duration="0:0:0.09">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressedOverlay"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="Glass"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                To="1"
                                Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetName="Root"
                                Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                To="1"
                                Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase Amplitude="0.5" EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="Button">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Button.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Button.GlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Control}" />
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
        <!--  Save buttons (btnSave): wait for the check before the view closes, keep it while the view stays open  -->
        <Setter Property="uixprops:UIXSaveFeedback.WaitTime" Value="0:0:0.45" />
        <Setter Property="uixprops:UIXSaveFeedback.ShowTime" Value="0:0:1.4" />
    </Style>

    <Style
        x:Key="Button.Primary"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Style.Resources>
            <!--  Hover rim of the template: the glass rim, brighter (an accent line would not stand out on the fill)  -->
            <LinearGradientBrush x:Key="Brush.Accent.Outline" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#80FFFFFF" />
                <GradientStop Offset="0.3" Color="#2EFFFFFF" />
                <GradientStop Offset="0.7" Color="#1AFFFFFF" />
                <GradientStop Offset="1" Color="#59FFFFFF" />
            </LinearGradientBrush>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Glass}" />
    </Style>

    <!--  Former name of Button.Primary, still used by existing views  -->
    <Style
        x:Key="Button.Secondary"
        BasedOn="{StaticResource Button.Primary}"
        TargetType="Button" />

    <Style
        x:Key="Button.Ghost"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Icon only: same height as inputs, square, the icon is centered without the text padding  -->
    <Style
        x:Key="Button.Icon"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Control.Height}" />
        <Setter Property="Height" Value="{StaticResource Control.Height}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--
        Accent color swatch (profile edit): round color dot; selected shows a ring in its own color and a check mark,
        hover lifts it slightly. The color comes from Background (set by the controller).
    -->
    <Style x:Key="ProfileAccentColorToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="Transparent">

                        <!--  Selection ring in the swatch color, separated from the dot by a small gap  -->
                        <Ellipse
                            x:Name="SelectionRing"
                            IsHitTestVisible="False"
                            Opacity="0"
                            Stroke="{TemplateBinding Background}"
                            StrokeThickness="2.5" />

                        <Grid
                            x:Name="Swatch"
                            Margin="7"
                            RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SwatchScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <Ellipse
                                x:Name="Dot"
                                Fill="{TemplateBinding Background}"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.35"
                                        ShadowDepth="2"
                                        Color="Black" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!--  Soft top highlight for some depth  -->
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Offset="0" Color="#30FFFFFF" />
                                        <GradientStop Offset="0.55" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>

                            <TextBlock
                                x:Name="CheckMark"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Font.Icons}"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="White"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Text="&#xE73E;">
                                <TextBlock.Effect>
                                    <DropShadowEffect
                                        BlurRadius="4"
                                        Opacity="0.8"
                                        ShadowDepth="0"
                                        Color="Black" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="0.35" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="SwatchScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="1" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Swatch" Property="Opacity" Value="0.4" />
                            <Setter TargetName="SelectionRing" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>