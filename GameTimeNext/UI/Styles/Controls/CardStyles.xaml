<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Card system (first used in the profile detail view, to be adopted across GTN step by step).

        Glass surfaces (translucent light + lit edge) so cards blend with any background, headings in normal case,
        information as label/value rows separated by hairlines instead of a box per value.

        Building blocks:
          GroupBox.Card         heading above + content on a card       (replacement for the classic GroupBox)
          GroupBox.Section      heading above + content without card
          Card                  plain card surface (Border)
          Card.Inset            recessed area inside a card (lists, nested boxes)
          Card.Interactive      card with hover feedback (clickable cards)
          Card.Row              label/value row inside a card; rows after the first get a hairline on top
          Card.RowLabel         muted label (left)
          Card.RowValue         value (right)
          Card.Caption          small muted text, e.g. above a prominent value
    -->

    <!--  ===== Values =====  -->

    <CornerRadius x:Key="Card.CornerRadius">6</CornerRadius>
    <Thickness x:Key="Card.Padding">14,12</Thickness>
    <!--  Cards that only contain rows: the rows bring their own vertical spacing  -->
    <Thickness x:Key="Card.RowsPadding">14,2</Thickness>
    <Thickness x:Key="Card.SectionMargin">0,0,0,18</Thickness>
    <Thickness x:Key="Card.HeaderMargin">0,0,0,8</Thickness>

    <!--
        Glass cards: translucent light over whatever is behind (window gradient, tinted glass of sub windows,
        hero backdrop), with a lit edge that is brighter at the top. Nothing opaque, so cards never look pasted on.
    -->
    <LinearGradientBrush x:Key="Brush.Card.Background" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#12FFFFFF" />
        <GradientStop Offset="1" Color="#0AFFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Card.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF" />
        <GradientStop Offset="1" Color="#12FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Card.Border" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#24FFFFFF" />
        <GradientStop Offset="1" Color="#08FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Card.Divider" Color="#12FFFFFF" />
    <!--  Recessed area inside a card (lists, nested boxes): darkens instead of lightening  -->
    <SolidColorBrush x:Key="Brush.Card.Inset" Color="#38000000" />

    <!--  ===== Card =====  -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource Card.Padding}" />
        <Setter Property="CornerRadius" Value="{StaticResource Card.CornerRadius}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Recessed area inside a card, e.g. a list or a nested box  -->
    <Style
        x:Key="Card.Inset"
        BasedOn="{StaticResource Card}"
        TargetType="Border">
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="{StaticResource Brush.Card.Inset}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style
        x:Key="Card.Interactive"
        BasedOn="{StaticResource Card}"
        TargetType="Border">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Card.BackgroundHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ===== Rows =====  -->

    <Style x:Key="Card.Row" TargetType="Border">
        <Setter Property="Padding" Value="0,9" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style
        x:Key="Card.FirstRow"
        BasedOn="{StaticResource Card.Row}"
        TargetType="Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Card.RowLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Card.RowValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Card.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--  ===== GroupBox =====  -->

    <Style x:Key="GroupBox.Card" TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="{StaticResource Card.Padding}" />
        <Setter Property="Margin" Value="{StaticResource Card.SectionMargin}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <ContentPresenter
                            x:Name="HeaderHost"
                            Margin="{StaticResource Card.HeaderMargin}"
                            ContentSource="Header"
                            DockPanel.Dock="Top"
                            RecognizesAccessKey="True"
                            TextElement.FontSize="13"
                            TextElement.FontWeight="SemiBold"
                            TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Border Padding="{TemplateBinding Padding}" Style="{StaticResource Card}">
                            <ContentPresenter />
                        </Border>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="GroupBox.Section"
        BasedOn="{StaticResource GroupBox.Card}"
        TargetType="{x:Type GroupBox}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <DockPanel>
                        <ContentPresenter
                            x:Name="HeaderHost"
                            Margin="{StaticResource Card.HeaderMargin}"
                            ContentSource="Header"
                            DockPanel.Dock="Top"
                            RecognizesAccessKey="True"
                            TextElement.FontSize="13"
                            TextElement.FontWeight="SemiBold"
                            TextElement.Foreground="{TemplateBinding Foreground}" />

                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
