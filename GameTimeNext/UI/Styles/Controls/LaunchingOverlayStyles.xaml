<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--
        Overlay over the profile tiles while a game is launched, running or quitting.
        Launching (Content = name of the game): glass card like the monitoring overlay with a particle launch
        animation (CFParticleSpinner, Shape Launch: counter-rotating rings and warp streaks) around a game icon;
        the tiles are blurred by ProfilesView. Quitting (Content = name of the game, Tag = "Quitting"): the same card,
        the warp streaks fly inwards. Running (no Content): only the dimmed background.
    -->
    <Style x:Key="GameStartOverlayHostStyle" TargetType="{x:Type ContentControl}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Panel.ZIndex" Value="1000" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Background="#96060A10">
                        <Grid
                            x:Name="LaunchCard"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <!--  Shadow shape behind the card (an effect on the card would blur the text)  -->
                            <Border
                                Background="#FF000000"
                                CornerRadius="16"
                                Effect="{StaticResource Effect.Popup}"
                                IsHitTestVisible="False"
                                Opacity="0.35" />

                            <Border
                                Width="430"
                                Padding="30,22,30,30"
                                Background="{DynamicResource Brush.Card.Background}"
                                BorderBrush="{DynamicResource Brush.Card.Border}"
                                BorderThickness="1"
                                CornerRadius="16">
                                <StackPanel>
                                    <Grid
                                        Width="240"
                                        Height="240"
                                        Margin="0,-6,0,4"
                                        HorizontalAlignment="Center">
                                        <ui:CFParticleSpinner
                                            x:Name="Spinner"
                                            Shape="Launch"
                                            Speed="1.1" />

                                        <!--  Game icon in a small glass disc in the middle of the rings, lifting off slightly  -->
                                        <Grid
                                            Width="62"
                                            Height="62"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="CenterPulseTransform" ScaleX="1" ScaleY="1" />
                                                    <TranslateTransform x:Name="CenterLiftTransform" Y="0" />
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <Ellipse
                                                Fill="{DynamicResource Brush.Card.Background}"
                                                Stroke="{DynamicResource Brush.Card.Border}"
                                                StrokeThickness="1" />
                                            <Ellipse
                                                Margin="7"
                                                Fill="{DynamicResource Brush.Accent}"
                                                Opacity="0.18" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="26"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="&#xE7FC;" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock
                                        x:Name="TitleText"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="Launching game..."
                                        TextAlignment="Center" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        x:Name="StatusText"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Opacity="0.9"
                                        Text="Waiting for the game to start"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  Running game: only the dimmed background  -->
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="LaunchCard" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--  Quitting game: same card, the warp streaks fly inwards  -->
                        <Trigger Property="Tag" Value="Quitting">
                            <Setter TargetName="Spinner" Property="Reverse" Value="True" />
                            <Setter TargetName="TitleText" Property="Text" Value="Quitting game..." />
                            <Setter TargetName="StatusText" Property="Text" Value="Waiting for the game to close" />
                        </Trigger>

                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LaunchingOverlayStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!--  The icon lifts off and settles again, a bit faster than the monitoring heartbeat  -->
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterLiftTransform" Storyboard.TargetProperty="Y">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:0.9"
                                                Value="-5" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:1.8"
                                                Value="0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterPulseTransform" Storyboard.TargetProperty="ScaleX">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:0.9"
                                                Value="1.06" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:1.8"
                                                Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterPulseTransform" Storyboard.TargetProperty="ScaleY">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:0.9"
                                                Value="1.06" />
                                            <SplineDoubleKeyFrame
                                                KeySpline="0.4,0,0.6,1"
                                                KeyTime="0:0:1.8"
                                                Value="1.0" />
                                        </DoubleAnimationUsingKeyFrames>

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatusText" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.6" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.8" Value="0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LaunchingOverlayStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
