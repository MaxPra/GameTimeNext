                            <Setter TargetName="Box" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="ContentHost" Property="Opacity" Value="0.7" />
