<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Global default ToolTip: plain popup surface, no accents  -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{StaticResource Brush.Popup.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Popup.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="420" />
        <!--  Explicit, otherwise the tooltip inherits the font of its owner (e.g. an icon font on an icon button)  -->
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <!--  Margin leaves room for the shadow inside the popup window  -->
                    <Border
                        Margin="6,4,6,8"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource Control.CornerRadius}"
                        Effect="{StaticResource Effect.Popup}">
                        <ContentPresenter RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="TextTrimming" Value="None" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tooltip for (long) profile titles: a bit larger text  -->
    <Style
        x:Key="ProfileTitleToolTipStyle"
        BasedOn="{StaticResource {x:Type ToolTip}}"
        TargetType="{x:Type ToolTip}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

</ResourceDictionary>
