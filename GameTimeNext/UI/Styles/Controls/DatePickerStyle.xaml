<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DatePicker and its drop down calendar in the input look (TextBox / ComboBox): dark field, accent outline on hover / focus,
        drop down on the popup surface like the ComboBox. The implicit TextBlock style pins white text and a margin, so the templates
        use their own TextBlocks with local values (otherwise inactive days wouldn't be dimmed and the cells would shift).
    -->

    <!--  ===== Calendar: day of the month view =====  -->

    <Style x:Key="DatePicker.CalendarDayButton" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Item.CornerRadius}">
                        <TextBlock
                            x:Name="Text"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                            TextWrapping="NoWrap" />
                    </Border>

                    <!--  Later triggers win: selected over today over inactive  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Text" Property="Foreground" Value="White" />
                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Calendar: month / year of the year and decade view =====  -->

    <Style x:Key="DatePicker.CalendarButton" TargetType="{x:Type CalendarButton}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Item.CornerRadius}">
                        <TextBlock
                            x:Name="Text"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                            TextWrapping="NoWrap" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Calendar: header buttons (month title, previous / next) =====  -->

    <Style x:Key="DatePicker.CalendarHeaderButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Item.CornerRadius}">
                        <TextBlock
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="SemiBold"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                            TextWrapping="NoWrap" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Item.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Calendar: month / year / decade view with header =====  -->

    <Style x:Key="DatePicker.CalendarItem" TargetType="{x:Type CalendarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <!--  Weekday titles above the days  -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                Text="{Binding}"
                                TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ControlTemplate.Resources>

                    <Grid x:Name="PART_Root">
                        <Border
                            Padding="8"
                            Background="{StaticResource Brush.Popup.Background}"
                            BorderBrush="{StaticResource Brush.Popup.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Popup.CornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="PART_PreviousButton"
                                        Grid.Column="0"
                                        Padding="0"
                                        Content="&#xE76B;"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="12"
                                        Style="{StaticResource DatePicker.CalendarHeaderButton}" />

                                    <Button
                                        x:Name="PART_HeaderButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource DatePicker.CalendarHeaderButton}" />

                                    <Button
                                        x:Name="PART_NextButton"
                                        Grid.Column="2"
                                        Padding="0"
                                        Content="&#xE76C;"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="12"
                                        Style="{StaticResource DatePicker.CalendarHeaderButton}" />
                                </Grid>

                                <!--  Filled by the CalendarItem: first row weekday titles, then 6 weeks  -->
                                <Grid
                                    x:Name="PART_MonthView"
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>

                                <!--  Filled by the CalendarItem: 12 months or years  -->
                                <Grid
                                    x:Name="PART_YearView"
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Hidden">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </Grid>
                        </Border>

                        <Rectangle
                            x:Name="PART_DisabledVisual"
                            Fill="{StaticResource Brush.Popup.Background}"
                            Opacity="0"
                            RadiusX="8"
                            RadiusY="8"
                            Stretch="Fill"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Calendar (drop down of the DatePicker; also the implicit Calendar style) =====  -->

    <Style x:Key="DatePicker.Calendar" TargetType="{x:Type Calendar}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource DatePicker.CalendarItem}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DatePicker.CalendarDayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource DatePicker.CalendarButton}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem
                            x:Name="PART_CalendarItem"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{TemplateBinding CalendarItemStyle}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DatePicker.Calendar}" TargetType="{x:Type Calendar}" />

    <!--  ===== Text field of the DatePicker =====  -->

    <Style x:Key="DatePicker.TextBox" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <!--  Visual states set by the DatePickerTextBox: the watermark shows while no date is entered  -->
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked" />
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Watermark"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_ContentHost"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Margin="0"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />

                        <ContentControl
                            x:Name="PART_Watermark"
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0"
                                        FontSize="14"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        Text="{Binding}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== DatePicker (implicit) =====  -->

    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Input.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Input.Border}" />
        <Setter Property="BorderThickness" Value="{StaticResource Control.BorderThickness}" />
        <Setter Property="Height" Value="{StaticResource Control.Height}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.Height}" />
        <Setter Property="Padding" Value="11,0,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CalendarStyle" Value="{StaticResource DatePicker.Calendar}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Grid>
                        <!--  Shadow shape behind the field (an effect on Bd would blur the text)  -->
                        <Border
                            Background="{StaticResource Brush.Input.Background}"
                            CornerRadius="{StaticResource Control.CornerRadius}"
                            Effect="{StaticResource Effect.Control}"
                            IsHitTestVisible="False" />

                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Control.CornerRadius}">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox
                                    x:Name="PART_TextBox"
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Stretch"
                                    Focusable="{TemplateBinding Focusable}"
                                    Style="{StaticResource DatePicker.TextBox}" />

                                <Button
                                    x:Name="PART_Button"
                                    Grid.Column="1"
                                    Cursor="Hand"
                                    Focusable="False"
                                    ToolTip="Choose date">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="Transparent">
                                                <TextBlock
                                                    x:Name="Icon"
                                                    Margin="0,0,4,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource Font.Icons}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                                    Text="&#xE787;" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!--  The DatePicker puts its Calendar into this popup  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=Bd}"
                            PopupAnimation="Fade"
                            StaysOpen="False" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Outline}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
