<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--
        Dashboard: cards with the same header (accent icon + title), values in stat tiles (caption, icon, value)
        or label/value rows like the profile detail. The most played card is the hero with the blurred cover behind it.
    -->

    <!--  ===== Card header =====  -->

    <Style x:Key="Dashboard.CardHeader" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,16,16,0" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style x:Key="Dashboard.CardHeaderIcon" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style
        x:Key="Dashboard.CardHeaderText"
        BasedOn="{StaticResource Text.BodyStrong}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
    </Style>

    <!--  Content below the header  -->
    <Thickness x:Key="Dashboard.CardContentMargin">16,12,16,16</Thickness>

    <!--  ===== Stat tile: icon + caption on top (like the card header), value below =====  -->

    <Style
        x:Key="Dashboard.StatTile"
        BasedOn="{StaticResource Card.Inset}"
        TargetType="Border">
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <Style
        x:Key="Dashboard.StatCaption"
        BasedOn="{StaticResource Card.Caption}"
        TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Dashboard.StatIcon" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="Dashboard.StatValue" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--  The main value of a card (total playtime)  -->
    <Style
        x:Key="Dashboard.StatValue.Large"
        BasedOn="{StaticResource Dashboard.StatValue}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
    </Style>

    <!--  " · " between the values of a muted caption line  -->
    <Style
        x:Key="Dashboard.CaptionSeparator"
        BasedOn="{StaticResource Text.Caption}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="Text" Value="·" />
    </Style>

    <!--  ===== Playtime per day (bar chart) =====  -->

    <!--
        One day (DashboardDayBar): bar relative to the peak day (star rows), rounded top, anchored on the baseline.
        Single series: accent fill, text in the text colors; only the peak day carries its value, all days show it
        in the tooltip (the whole column is the hover target). Today's weekday is emphasized.
    -->
    <DataTemplate x:Key="Dashboard.DayBarTemplate">
        <Grid Background="Transparent" ToolTip="{Binding ToolTipText}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{Binding RestHeight}" />
                    <RowDefinition Height="{Binding BarHeight}" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Style="{StaticResource Text.BodyStrong}"
                    Text="{Binding ValueText}"
                    TextWrapping="NoWrap"
                    Visibility="{Binding IsPeak, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Border
                    Grid.Row="1"
                    MaxWidth="22"
                    Margin="3,0"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource Brush.Accent}"
                    CornerRadius="4,4,0,0" />
            </Grid>

            <!--  Baseline  -->
            <Border
                Grid.Row="1"
                Height="1"
                Background="{StaticResource Brush.Card.Divider}" />

            <TextBlock
                x:Name="DayLabel"
                Grid.Row="2"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Style="{StaticResource Text.Caption}"
                Text="{Binding Label}"
                TextWrapping="NoWrap" />
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter TargetName="DayLabel" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  ===== Hero (most played) =====  -->

    <!--
        Blurred cover behind the card, strongest behind the showcase, fading out towards the text.
        A Border with the cover as ImageBrush background (set in the view): unlike an Image it has no size of its own,
        so it fills the card instead of making the card as tall as the stretched picture.
    -->
    <Style x:Key="Dashboard.HeroBackdrop" TargetType="Border">
        <Setter Property="Margin" Value="-80" />
        <Setter Property="Opacity" Value="0.38" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <BlurEffect Radius="70" RenderingBias="Performance" />
            </Setter.Value>
        </Setter>
        <Setter Property="OpacityMask">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="0.45" Color="#99000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="Dashboard.HeroTitle"
        BasedOn="{StaticResource Text.Display}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0" />
        <Setter Property="LineHeight" Value="34" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <!--  max. 2 lines  -->
        <Setter Property="MaxHeight" Value="68" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <!--  Values in the stat tiles of the hero: a step larger than in the other tiles  -->
    <Style
        x:Key="Dashboard.HeroValue"
        BasedOn="{StaticResource Dashboard.StatValue}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!--  ===== Games played list =====  -->

    <Style
        x:Key="DashboardRecentGamesItemStyle"
        BasedOn="{StaticResource ListViewItem.Default}"
        TargetType="{x:Type ListViewItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  Row of the list: hairline below, like the label/value rows of the cards  -->
    <Style x:Key="Dashboard.GameRow" TargetType="Border">
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  Small portrait cover (2:3) with the lit edge; the cover is the Background (ImageBrush follows the corner radius)  -->
    <Style x:Key="Dashboard.GameThumb" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="39" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
