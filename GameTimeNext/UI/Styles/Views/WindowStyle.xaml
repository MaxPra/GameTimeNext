

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:baseViews="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--
        Windows with backdrop blur (GTNWindow.IsBackdropActive; main window without dynamic background): "tinted glass".
        The acrylic alone turns into a gray veil over colorless content (settings, code tables, ...),
        so it is tinted with the application background and the accent glow of the main window.
        Opacity of the layers below = how much of the blurred content shines through.
    -->
    <!--  App background (same gradient as the main window), mostly opaque  -->
    <LinearGradientBrush x:Key="Brush.Window.TranslucentBase" Opacity="0.82" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.Background}" />
        <GradientStop Offset="0.30" Color="#0C0C12" />
        <GradientStop Offset="0.62" Color="#0E0E15" />
        <GradientStop Offset="1" Color="{DynamicResource Color.Background}" />
    </LinearGradientBrush>

    <!--
        Accent tints of the glass, replaced at runtime by FnTheme (profile accent): reference with DynamicResource.
        Top left, stronger than in the main window: the glass needs the color.
    -->
    <RadialGradientBrush x:Key="GradientBrush.Window.AccentGlowPrimary" Center="0.2,0.1" GradientOrigin="0.2,0.1" Opacity="0.22" RadiusX="1.1" RadiusY="1.1">
        <GradientStop Offset="0" Color="{DynamicResource Color.Accent}" />
        <GradientStop Offset="1" Color="Transparent" />
    </RadialGradientBrush>

    <!--  Bottom right  -->
    <RadialGradientBrush x:Key="GradientBrush.Window.AccentGlowSecondary" Center="0.9,0.9" GradientOrigin="0.9,0.9" Opacity="0.10" RadiusX="1" RadiusY="1">
        <GradientStop Offset="0" Color="{DynamicResource Color.AccentHover}" />
        <GradientStop Offset="1" Color="Transparent" />
    </RadialGradientBrush>

    <!--
        Base and accent tints combined in one brush, for the splash screen (shown at startup, default accent only).
        GTNWindow layers them in its template instead, so the accent tints follow the profile accent.
    -->
    <DrawingBrush x:Key="Brush.Window.Translucent" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Brush.Window.TranslucentBase}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  Accent tint, top left  -->
                <GeometryDrawing Brush="{StaticResource GradientBrush.Window.AccentGlowPrimary}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  Accent tint, bottom right  -->
                <GeometryDrawing Brush="{StaticResource GradientBrush.Window.AccentGlowSecondary}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <SolidColorBrush x:Key="Brush.Window.TitleBarTranslucent" Color="#33000000" />

    <!--
        Root grid of a view: outer margin when shown in its own window, none inside a main window tab
        (the tab content area already insets it, see ModernTabControlStyle).
    -->
    <Style x:Key="View.Root" TargetType="Grid">
        <Setter Property="Margin" Value="20,16,20,20" />
        <Style.Triggers>
            <Trigger Property="ui:ViewHost.IsTabContent" Value="True">
                <Setter Property="Margin" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  How strongly the blurred wallpaper shows through the dark background (GTNWindow.UseWallpaperBackground)  -->
    <sys:Double x:Key="Window.WallpaperOpacity">0.3</sys:Double>
    <SolidColorBrush x:Key="Brush.Window.BorderTranslucent" Color="#1FFFFFFF" />

    <Style x:Key="GTNWindowStyle" TargetType="{x:Type baseViews:GTNWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="{DynamicResource GradientBrush.ProfileDetailView.Background}" />

        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome
                    CaptionHeight="36"
                    CornerRadius="10"
                    GlassFrameThickness="0"
                    ResizeBorderThickness="6"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>


        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type baseViews:GTNWindow}">
                    <AdornerDecorator>
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>

                            <Border
                                x:Name="ClipBorder"
                                ClipToBounds="True"
                                CornerRadius="10">
                                <Grid x:Name="LayoutRoot" SnapsToDevicePixels="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!--  Accent tints of the tinted glass (IsBackdropActive), follow the profile accent  -->
                                    <Border
                                        x:Name="BackdropAccentGlowPrimary"
                                        Grid.RowSpan="2"
                                        Background="{DynamicResource GradientBrush.Window.AccentGlowPrimary}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />

                                    <Border
                                        x:Name="BackdropAccentGlowSecondary"
                                        Grid.RowSpan="2"
                                        Background="{DynamicResource GradientBrush.Window.AccentGlowSecondary}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />

                                    <!--
                                        Blurred desktop wallpaper (UseWallpaperBackground) between the window background and the content.
                                        Partly transparent, so the dark background tints it; the vignette calms the edges.
                                    -->
                                    <Border
                                        x:Name="WallpaperLayer"
                                        Grid.RowSpan="2"
                                        Background="{DynamicResource Brush.App.Wallpaper}"
                                        IsHitTestVisible="False"
                                        Opacity="{StaticResource Window.WallpaperOpacity}"
                                        Visibility="Collapsed" />

                                    <Border
                                        x:Name="WallpaperVignette"
                                        Grid.RowSpan="2"
                                        Background="{DynamicResource GradientBrush.ProfileDetailView.Vignette}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />

                                    <!--  Title bar with a thin accent line below  -->
                                    <Border
                                        x:Name="TitleBarHost"
                                        Grid.Row="0"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Accent.Muted}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">

                                        <Grid
                                            x:Name="PART_TitleBar"
                                            Height="36"
                                            HorizontalAlignment="Stretch"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="TitleBarTranslateTransform" Y="-6" />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Grid.Column="0"
                                                Margin="15,0,12,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    Text="{TemplateBinding Title}" />

                                                <Border
                                                    x:Name="PART_SubtitleHost"
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="Visible">
                                                    <TextBlock
                                                        x:Name="PART_SubtitleText"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{TemplateBinding Subtitle}" />
                                                </Border>
                                            </Grid>

                                            <Border
                                                x:Name="PART_ApplicationSearchHost"
                                                Grid.Column="1"
                                                Width="420"
                                                Height="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Background="Transparent"
                                                Visibility="Collapsed">

                                                <ComboBox
                                                    x:Name="PART_ApplicationSearchBox"
                                                    IsEditable="True"
                                                    IsTextSearchEnabled="False"
                                                    ItemsSource="{TemplateBinding ApplicationSearchItemsSource}"
                                                    SelectedItem="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ApplicationSearchSelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    StaysOpenOnEdit="True"
                                                    Style="{StaticResource TitleBarSearchComboBoxStyle}"
                                                    Tag="{TemplateBinding ApplicationSearchPlaceholder}" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <!--
                                                    Caption buttons: the chrome glyphs of Segoe Fluent Icons (hinted for caption buttons, crisp at any DPI).
                                                    The icon font is set on the TextBlocks, not on the buttons, so tooltips keep the normal font.
                                                -->

                                                <!--  Big Picture (ShowBigPictureButton): like the help button dispatched to the controller (EV_btnBigPicture)  -->
                                                <Button
                                                    x:Name="btnBigPicture"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource TitleBarButtonStyle}"
                                                    ToolTip="Big Picture mode (for TV and controller)"
                                                    Visibility="Collapsed">
                                                    <TextBlock
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="14"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        Text="&#xE7FC;" />
                                                </Button>

                                                <!--  Help (ShowHelpButton): not a PART_, the click bubbles to the window and is dispatched to the controller as EV_BtnHelp  -->
                                                <Button
                                                    x:Name="BtnHelp"
                                                    Margin="0,0,8,0"
                                                    Style="{StaticResource TitleBarButtonStyle}"
                                                    ToolTip="Help for GameTimeNext"
                                                    Visibility="Collapsed">
                                                    <TextBlock
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="13"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        Text="&#xE897;" />
                                                </Button>

                                                <Button
                                                    x:Name="PART_MinButton"
                                                    Margin="0,0,2,0"
                                                    Style="{StaticResource TitleBarMinButtonStyle}">
                                                    <TextBlock
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        Text="&#xE921;" />
                                                </Button>

                                                <Button
                                                    x:Name="PART_MaxButton"
                                                    Margin="0,0,2,0"
                                                    Style="{StaticResource TitleBarMaxButtonStyle}">
                                                    <Grid>
                                                        <TextBlock
                                                            x:Name="MaxIcon"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Text="&#xE922;" />
                                                        <!--  Restore (maximized)  -->
                                                        <TextBlock
                                                            x:Name="RestoreIcon"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            FontSize="12"
                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                            Text="&#xE923;"
                                                            Visibility="Collapsed" />
                                                    </Grid>
                                                </Button>

                                                <Button x:Name="PART_CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}">
                                                    <TextBlock
                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="12"
                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                        Text="&#xE8BB;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="ContentRoot" Grid.Row="1">
                                        <ContentPresenter
                                            x:Name="WindowContentHost"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                                        <!--
                                            Busy indicator (UIXLoader): the window content is blurred and dimmed (trigger below),
                                            a glass card in the middle shows the particle ring and the text.
                                        -->
                                        <Grid
                                            x:Name="PART_Loader"
                                            Panel.ZIndex="999"
                                            Background="#59000000"
                                            Visibility="Collapsed">

                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!--  Shadow shape behind the card (an effect on the card would blur the text)  -->
                                                <Border
                                                    Background="#FF000000"
                                                    CornerRadius="12"
                                                    Effect="{StaticResource Effect.Popup}"
                                                    IsHitTestVisible="False"
                                                    Opacity="0.35" />

                                                <Border
                                                    MinWidth="200"
                                                    Padding="28,18,28,22"
                                                    Background="{DynamicResource Brush.Card.Background}"
                                                    BorderBrush="{DynamicResource Brush.Card.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                    <StackPanel>
                                                        <ui:CFParticleSpinner
                                                            Width="120"
                                                            Height="120"
                                                            HorizontalAlignment="Center" />

                                                        <TextBlock
                                                            x:Name="LoaderTextBlock"
                                                            MaxWidth="320"
                                                            Margin="0,4,0,0"
                                                            HorizontalAlignment="Center"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                                            Opacity="0.95"
                                                            Text=""
                                                            TextAlignment="Center"
                                                            TextWrapping="Wrap"
                                                            Visibility="Visible" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                    </AdornerDecorator>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="PART_TitleBar"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.24" />
                                    <DoubleAnimation
                                        Storyboard.TargetName="TitleBarTranslateTransform"
                                        Storyboard.TargetProperty="Y"
                                        From="-6"
                                        To="0"
                                        Duration="0:0:0.24" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaxButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowApplicationSearch" Value="True">
                            <Setter TargetName="PART_ApplicationSearchHost" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowHelpButton" Value="True">
                            <Setter TargetName="BtnHelp" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ShowBigPictureButton" Value="True">
                            <Setter TargetName="btnBigPicture" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="PART_SubtitleHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="PART_SubtitleHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="UseWallpaperBackground" Value="True">
                            <Setter TargetName="WallpaperLayer" Property="Visibility" Value="Visible" />
                            <Setter TargetName="WallpaperVignette" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TitleBarHost" Property="Background" Value="{StaticResource Brush.Window.TitleBarTranslucent}" />
                        </Trigger>

                        <Trigger Property="IsBackdropActive" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource Brush.Window.TranslucentBase}" />
                            <Setter TargetName="BackdropAccentGlowPrimary" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BackdropAccentGlowSecondary" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource Brush.Window.BorderTranslucent}" />
                            <!--  match the rounding DWM applies to the window  -->
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="8" />
                            <Setter TargetName="ClipBorder" Property="CornerRadius" Value="8" />
                            <Setter TargetName="TitleBarHost" Property="Background" Value="{StaticResource Brush.Window.TitleBarTranslucent}" />
                        </Trigger>

                        <Trigger Property="IsNativeFrameActive" Value="True">
                            <!--  match the rounding DWM applies to the window  -->
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="8" />
                            <Setter TargetName="ClipBorder" Property="CornerRadius" Value="8" />
                        </Trigger>

                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="MaxIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="0" />
                        </Trigger>

                        <!--  Full screen (Big Picture): no title bar, the content takes the whole window  -->
                        <Trigger Property="IsFullScreen" Value="True">
                            <Setter TargetName="TitleBarHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentRoot" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentRoot" Property="Grid.RowSpan" Value="2" />
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="ClipBorder" Property="CornerRadius" Value="0" />
                        </Trigger>

                        <Trigger SourceName="PART_Loader" Property="Visibility" Value="Visible">
                            <!--  Frosted glass: blur the content behind the busy indicator  -->
                            <Setter TargetName="WindowContentHost" Property="Effect">
                                <Setter.Value>
                                    <BlurEffect
                                        KernelType="Gaussian"
                                        Radius="10"
                                        RenderingBias="Performance" />
                                </Setter.Value>
                            </Setter>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoaderSlotsStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoaderTextBlock" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.75" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:1.1" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LoaderSlotsStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!--
                Minimal DWM frame instead of the rounded window region (GlassFrameThickness 0): DWM rounds the corners
                and draws the native drop shadow. The opaque content covers the 1px glass.
            -->
            <Trigger Property="IsNativeFrameActive" Value="True">
                <Setter Property="shell:WindowChrome.WindowChrome">
                    <Setter.Value>
                        <shell:WindowChrome
                            CaptionHeight="36"
                            CornerRadius="8"
                            GlassFrameThickness="0,0,0,1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
            </Trigger>

            <Trigger Property="IsBackdropActive" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="shell:WindowChrome.WindowChrome">
                    <Setter.Value>
                        <shell:WindowChrome
                            CaptionHeight="36"
                            CornerRadius="8"
                            GlassFrameThickness="-1"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
            </Trigger>

            <!--  Full screen: no caption (drag area) and no resize border; last, so it wins over the frame variants above  -->
            <Trigger Property="IsFullScreen" Value="True">
                <Setter Property="shell:WindowChrome.WindowChrome">
                    <Setter.Value>
                        <shell:WindowChrome
                            CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>