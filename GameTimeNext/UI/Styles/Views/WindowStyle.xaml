

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:baseViews="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <Style x:Key="GTNWindowStyle" TargetType="{x:Type baseViews:GTNWindow}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Background" Value="{DynamicResource GradientBrush.ProfileDetailView.Background}" />

        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome
                    CaptionHeight="36"
                    CornerRadius="10"
                    GlassFrameThickness="0"
                    ResizeBorderThickness="6"
                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type baseViews:GTNWindow}">
                    <AdornerDecorator>
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5"
                            SnapsToDevicePixels="True">

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ScaleTf" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>

                            <Border ClipToBounds="True" CornerRadius="10">
                                <Grid x:Name="LayoutRoot" SnapsToDevicePixels="True">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border
                                        Grid.Row="0"
                                        Background="{DynamicResource Brush.Surface}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,0,0,1"
                                        SnapsToDevicePixels="True">

                                        <Grid
                                            x:Name="PART_TitleBar"
                                            Height="36"
                                            HorizontalAlignment="Stretch"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="TitleBarTranslateTransform" Y="-6" />
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid
                                                Grid.Column="0"
                                                Margin="15,0,12,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    Text="{TemplateBinding Title}" />

                                                <Border
                                                    x:Name="PART_SubtitleHost"
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    Visibility="Visible">
                                                    <TextBlock
                                                        x:Name="PART_SubtitleText"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                                        Text="{TemplateBinding Subtitle}" />
                                                </Border>
                                            </Grid>

                                            <Border
                                                x:Name="PART_ApplicationSearchHost"
                                                Grid.Column="1"
                                                Width="420"
                                                Height="26"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                Background="Transparent"
                                                Visibility="Collapsed">

                                                <ComboBox
                                                    x:Name="PART_ApplicationSearchBox"
                                                    IsEditable="True"
                                                    IsTextSearchEnabled="False"
                                                    ItemsSource="{TemplateBinding ApplicationSearchItemsSource}"
                                                    SelectedItem="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ApplicationSearchSelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    StaysOpenOnEdit="True"
                                                    Style="{StaticResource TitleBarSearchComboBoxStyle}"
                                                    Tag="{TemplateBinding ApplicationSearchPlaceholder}" />
                                            </Border>

                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="0,0,12,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    x:Name="PART_MinButton"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Content="&#xE921;"
                                                    Style="{StaticResource TitleBarMinButtonStyle}" />

                                                <Button
                                                    x:Name="PART_MaxButton"
                                                    Width="24"
                                                    Height="24"
                                                    Margin="0,0,4,0"
                                                    Content="&#xE922;"
                                                    Style="{StaticResource TitleBarMaxButtonStyle}" />

                                                <Button
                                                    x:Name="PART_CloseButton"
                                                    Width="24"
                                                    Height="24"
                                                    Content="&#xE8BB;"
                                                    Style="{StaticResource TitleBarCloseButtonStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1">
                                        <ContentPresenter
                                            Margin="0"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                                        <Grid
                                            x:Name="PART_Loader"
                                            Panel.ZIndex="999"
                                            Background="#8A000000"
                                            Visibility="Collapsed">

                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="14" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid
                                                    Grid.Row="0"
                                                    Width="72"
                                                    Height="72"
                                                    RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <RotateTransform x:Name="LoaderSpinnerRotate" Angle="0" />
                                                    </Grid.RenderTransform>

                                                    <Path
                                                        Data="M 12,36 A 24,24 0 0 1 60,36"
                                                        Stroke="#23FFFFFF"
                                                        StrokeEndLineCap="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="4" />

                                                    <Path
                                                        Data="M 12,36 A 24,24 0 0 1 60,36"
                                                        Stroke="{DynamicResource Brush.Accent}"
                                                        StrokeEndLineCap="Round"
                                                        StrokeStartLineCap="Round"
                                                        StrokeThickness="4.2">
                                                        <Path.Effect>
                                                            <DropShadowEffect
                                                                BlurRadius="9"
                                                                Opacity="0.45"
                                                                ShadowDepth="0"
                                                                Color="{DynamicResource Color.Accent}" />
                                                        </Path.Effect>
                                                    </Path>
                                                </Grid>

                                                <TextBlock
                                                    x:Name="LoaderTextBlock"
                                                    Grid.Row="2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    Opacity="0.95"
                                                    Text=""
                                                    TextAlignment="Center"
                                                    Visibility="Visible" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                    </AdornerDecorator>

                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="PART_TitleBar"
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.24" />
                                    <DoubleAnimation
                                        Storyboard.TargetName="TitleBarTranslateTransform"
                                        Storyboard.TargetProperty="Y"
                                        From="-6"
                                        To="0"
                                        Duration="0:0:0.24" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <Trigger Property="ShowMinimizeButton" Value="False">
                            <Setter TargetName="PART_MinButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowMaximizeButton" Value="False">
                            <Setter TargetName="PART_MaxButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="ShowApplicationSearch" Value="True">
                            <Setter TargetName="PART_ApplicationSearchHost" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="PART_SubtitleHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="PART_SubtitleHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="RootBorder" Property="BorderThickness" Value="0" />
                            <Setter TargetName="RootBorder" Property="CornerRadius" Value="0" />
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger SourceName="PART_Loader" Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoaderSlotsStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="LoaderSpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:0.9" />

                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoaderTextBlock" Storyboard.TargetProperty="Opacity">
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.0" Value="0.84" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.45" Value="1.0" />
                                            <SplineDoubleKeyFrame KeyTime="0:0:0.9" Value="0.84" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="LoaderSlotsStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>