<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <SolidColorBrush x:Key="Brush.SettingsTab.NormalBackground" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.SettingsTab.SelectedBackground" Color="Transparent" />
    <SolidColorBrush x:Key="Brush.SettingsTab.Separator" Color="#2A2A34" />
    <SolidColorBrush x:Key="Brush.SettingsTab.Edge" Color="#2A2A34" />
    <SolidColorBrush x:Key="Brush.SettingsSegment.Background" Color="#FF0F0F1A" />
    <SolidColorBrush x:Key="Brush.SettingsSegment.Active" Color="#FF7B6E73" />
    <SolidColorBrush x:Key="Brush.SettingsSegment.Border" Color="#FF2A2A3E" />

    <Style x:Key="SettingsPageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="SettingsPageSubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!--  Same as Text.Subtitle (TextBlockStyle.xaml is merged later, so not based on it)  -->
    <Style x:Key="SettingsGroupTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="SettingsSegmentButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="{StaticResource Brush.SettingsSegment.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SettingsSegment.Border}" />
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1A1A22" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.SettingsSegment.Active}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.SettingsSegment.Active}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalSettingsTabControlStyle" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!--  Vertical strip: the selection runner slides up / down (TabControlBehaviors), like the main tabs  -->
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="ui:TabControlBehaviors.EnableSelectionSwoosh" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid Background="Transparent" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Left navigation  -->
                        <Border Grid.Column="0" Background="Transparent">
                            <Grid x:Name="TabTrackContentHost" VerticalAlignment="Top">
                                <!--  Selection: glass surface with an accent bar, glides to the selected entry  -->
                                <Border
                                    x:Name="SelectionRunner"
                                    Height="0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource Brush.Item.Selected}"
                                    CornerRadius="{StaticResource Control.CornerRadius}"
                                    IsHitTestVisible="False">
                                    <!--  Named: unnamed freezables in templates get frozen and can't be animated  -->
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SelectionRunnerTransform" />
                                    </Border.RenderTransform>
                                    <Border
                                        Width="4"
                                        Margin="0,9"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="1" />
                                </Border>

                                <!--  StackPanel instead of TabPanel: TabPanel lays tabs out in rows and doesn't size the entries reliably  -->
                                <StackPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Grid>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{StaticResource Brush.Card.Divider}" />

                        <!--  Right content  -->
                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0">
                            <!--
                                Deliberately not named PART_SelectedContentHost: with that name WPF moves keyboard focus
                                into the content on a tab click, which scrolls the first focusable element to the top.
                            -->
                            <!--  The transform is used by TabControlBehaviors for the content transition on a page change  -->
                            <ContentPresenter
                                x:Name="SelectedContentHost"
                                Margin="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                ContentSource="SelectedContent">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="SelectedContentTransform" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VerticalSettingsTabItemStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Background" Value="{StaticResource Brush.SettingsTab.NormalBackground}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!--  Text headers inherit color and weight from the tab item (muted / hovered / selected), not the white default  -->
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ControlTemplate.Resources>

                    <!--
                        Hover: neutral glass highlight over the whole entry, like list / menu entries and the main tabs.
                        The selection (glass + accent bar) is the SelectionRunner of the tab control, which slides between the entries.
                    -->
                    <Border
                        x:Name="RootBorder"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource Control.CornerRadius}"
                        SnapsToDevicePixels="True">
                        <!--  Left: room for the accent bar of the runner  -->
                        <StackPanel
                            Margin="16,0,12,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  Validation error on a field of this tab (UIXTabValidation.HasErrors, set by the engine)  -->
                            <TextBlock
                                x:Name="ErrorIcon"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Font.Icons}"
                                FontSize="14"
                                Foreground="{DynamicResource Brush.Danger}"
                                Text="&#xE783;"
                                Visibility="Collapsed" />

                            <ContentPresenter
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource Brush.Item.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter TargetName="RootBorder" Property="Cursor" Value="Hand" />
                        </Trigger>

                        <!--  No hover on the selected entry: the runner already highlights it  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource Brush.SettingsTab.SelectedBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <!--  Last, so it wins over hover: the header stays in the danger color  -->
                        <Trigger Property="uixprops:UIXTabValidation.HasErrors" Value="True">
                            <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>