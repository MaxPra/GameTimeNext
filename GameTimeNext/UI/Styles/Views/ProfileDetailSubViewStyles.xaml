<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <!--
        Profile detail ("game sheet"):
        blurred cover backdrop, header with cover + title + total playtime,
        activity tiles, current playthrough, estimated playtime, actions pinned at the bottom.
    -->

    <!--  Header cover width follows the panel width within these bounds (2:3, see code-behind)  -->
    <sys:Double x:Key="ProfileDetail.HeaderCoverMinWidth">96</sys:Double>
    <sys:Double x:Key="ProfileDetail.HeaderCoverMaxWidth">150</sys:Double>

    <Thickness x:Key="ProfileDetail.SideMargin">16,0,16,0</Thickness>

    <!--  Glass panel like the cards (translucent light over the window background), not an opaque surface  -->
    <Style x:Key="ProfileDetail.Root" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource Brush.Card.Background}" />
        <Setter Property="ClipToBounds" Value="True" />
        <!--  Rounded panel corners, same radius as cards and tiles  -->
        <Setter Property="ui:ClipBehaviors.CornerRadius" Value="6" />
    </Style>

    <!--  Lit edge of the glass panel, on top of everything (the root grid itself has no border)  -->
    <Style x:Key="ProfileDetail.Edge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Card.CornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ===== Backdrop =====  -->

    <!--  Blurred cover behind the header, fading out towards the content  -->
    <Style x:Key="ProfileDetail.Backdrop" TargetType="Image">
        <Setter Property="Height" Value="320" />
        <Setter Property="Margin" Value="-60,-60,-60,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="Opacity" Value="0.42" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Effect">
            <Setter.Value>
                <BlurEffect Radius="60" RenderingBias="Performance" />
            </Setter.Value>
        </Setter>
        <Setter Property="OpacityMask">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FF000000" />
                    <GradientStop Offset="0.55" Color="#99000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Header =====  -->

    <Style x:Key="ProfileDetail.Header" TargetType="Grid">
        <Setter Property="Margin" Value="0,20,0,22" />
    </Style>

    <Style x:Key="ProfileDetail.CoverFrame" TargetType="Border">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="168" />
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Background}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="22"
                    Direction="270"
                    Opacity="0.55"
                    ShadowDepth="6"
                    Color="#FF000000" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProfileDetail.CoverImage" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <!--  Clip (rounded corners) is set in code-behind, it depends on the current cover size  -->
    </Style>

    <Style x:Key="ProfileDetail.HeaderText" TargetType="StackPanel">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!--  Profile rating above the title: small stars + value  -->
    <Style x:Key="ProfileDetail.Rating" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="ProfileDetail.RatingValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProfileDetail.Title" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <!--  max. 3 lines  -->
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="25" />
        <Setter Property="MaxHeight" Value="75" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <Style x:Key="ProfileDetail.HeroValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!--  ===== Playthrough =====  -->

    <Style x:Key="ProfileDetail.PlaythroughName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>

    <Style x:Key="ProfileDetail.PlaythroughTime" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ===== Progress =====  -->

    <Style x:Key="ProfileDetail.ProgressTrack" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style x:Key="ProfileDetail.ProgressFill" TargetType="Border">
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <!--  Progress is applied as ScaleX in the controller, so it stays correct when the card is resized  -->
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
    </Style>

    <!--  ===== Actions =====  -->

    <!--  Pinned at the bottom; the separator shows that the content above can scroll underneath. Transparent: the glass panel shows through  -->
    <Style x:Key="ProfileDetail.ActionBar" TargetType="Border">
        <Setter Property="Padding" Value="0,16" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Card.Divider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

</ResourceDictionary>
