<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI">

    <CornerRadius x:Key="ToastAccentBarCornerRadius">1.5</CornerRadius>

    <LinearGradientBrush x:Key="Toast.BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0B0F15" />
        <GradientStop Offset="0.55" Color="#FF0A0D13" />
        <GradientStop Offset="1" Color="#FF090C11" />
    </LinearGradientBrush>

    <!--  Glass tint over the blurred desktop: dark enough for the text, light enough to see through  -->
    <LinearGradientBrush x:Key="Toast.GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5A14141C" />
        <GradientStop Offset="1" Color="#700C0C12" />
    </LinearGradientBrush>

    <!--  Light sheen on top (like Brush.Card.Background, a bit stronger at the top edge)  -->
    <LinearGradientBrush x:Key="Toast.SheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF" />
        <GradientStop Offset="0.45" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#04FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Toast.DividerBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="Toast.ProgressTrackBrush" Color="#38000000" />

    <!--  Glass surface; without blur (AcrylicBlur.IsActive false) the opaque background is kept, a translucent tint would show the desktop unblurred  -->
    <Style x:Key="ToastRootBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Toast.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Popup.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(ui:AcrylicBlur.IsActive), RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="{StaticResource Toast.GlassBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToastSheenStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Toast.SheenBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--  Accent marker inset on the left (like the selection bar of lists), stays inside the rounded corners  -->
    <Style x:Key="ToastAccentBarStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="10,16,0,16" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="CornerRadius" Value="{StaticResource ToastAccentBarCornerRadius}" />
    </Style>

    <Style x:Key="ToastTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToastCategoryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style x:Key="ToastMessageTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxHeight" Value="58" />
    </Style>

    <Style x:Key="ToastSecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="ToastDividerStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Toast.DividerBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
    </Style>

    <Style x:Key="ToastProgressTrackStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{StaticResource Toast.ProgressTrackBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
    </Style>

    <Style x:Key="ToastProgressBarStyle" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="CornerRadius" Value="{StaticResource DefaultCornerRadius}" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
    </Style>

</ResourceDictionary>