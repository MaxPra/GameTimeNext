<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Opaque surface: while the toast pops in (no blur yet) and when the blur isn't supported  -->
    <LinearGradientBrush x:Key="Toast.BackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF0B0F15" />
        <GradientStop Offset="0.55" Color="#FF0A0D13" />
        <GradientStop Offset="1" Color="#FF090C11" />
    </LinearGradientBrush>

    <!--  Glass tint over the blurred desktop: dark enough for the text, light enough to see through  -->
    <LinearGradientBrush x:Key="Toast.GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#5A14141C" />
        <GradientStop Offset="1" Color="#700C0C12" />
    </LinearGradientBrush>

    <!--  Light sheen on top (like Brush.Card.Background, a bit stronger at the top edge)  -->
    <LinearGradientBrush x:Key="Toast.SheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1CFFFFFF" />
        <GradientStop Offset="0.45" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#04FFFFFF" />
    </LinearGradientBrush>

    <Style x:Key="ToastGlassStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Toast.GlassBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
    </Style>

    <Style x:Key="ToastSolidStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Toast.BackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
    </Style>

    <Style x:Key="ToastSheenStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource Toast.SheenBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!--  Lit edge like the glass popups, holds the content  -->
    <Style x:Key="ToastFrameStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Popup.GlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Popup.CornerRadius}" />
        <Setter Property="Padding" Value="14,11,16,12" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <Style x:Key="ToastIconStyle" TargetType="{x:Type Image}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style
        x:Key="ToastTitleTextStyle"
        BasedOn="{StaticResource Text.BodyStrong}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!--  At most three lines (e.g. the games of the automatic import)  -->
    <Style
        x:Key="ToastMessageTextStyle"
        BasedOn="{StaticResource Text.Body}"
        TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxHeight" Value="54" />
    </Style>

</ResourceDictionary>
