    <!--  Basis  -->
    <LinearGradientBrush x:Key="GradientBrush.ProfileDetailView.Background" Opacity="1" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{DynamicResource Color.Background}" />
        <GradientStop Offset="0.30" Color="#0C0C12" />
        <GradientStop Offset="0.62" Color="#0E0E15" />
        <GradientStop Offset="1" Color="{DynamicResource Color.Background}" />
    </LinearGradientBrush>

    <!--  Accent Hauptglow  -->
    <RadialGradientBrush x:Key="GradientBrush.ProfileDetailView.AccentGlowPrimary" Center="0.28,0.22" GradientOrigin="0.28,0.22" Opacity="0.06" RadiusX="1.1" RadiusY="1.1">
        <GradientStop Offset="0" Color="{DynamicResource Color.Accent}" />
        <GradientStop Offset="1" Color="Transparent" />
    </RadialGradientBrush>

    <!--  Accent Sekundär  -->
    <RadialGradientBrush x:Key="GradientBrush.ProfileDetailView.AccentGlowSecondary" Center="0.85,0.75" GradientOrigin="0.85,0.75" Opacity="0.03" RadiusX="1.2" RadiusY="1.2">
        <GradientStop Offset="0" Color="{DynamicResource Color.AccentHover}" />
        <GradientStop Offset="1" Color="Transparent" />
    </RadialGradientBrush>

    <!--  Randabdunklung  -->
    <RadialGradientBrush x:Key="GradientBrush.ProfileDetailView.Vignette" Center="0.5,0.5" Opacity="0.45" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Offset="0.55" Color="Transparent" />
        <GradientStop Offset="1" Color="#CC000000" />
    </RadialGradientBrush>

    <!--  Kombination  -->
    <DrawingBrush x:Key="Brush.ProfileDetailView.Background" Stretch="Fill">
        <DrawingBrush.Drawing>
            <DrawingGroup>

                <GeometryDrawing Brush="{DynamicResource GradientBrush.ProfileDetailView.Background}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{DynamicResource GradientBrush.ProfileDetailView.AccentGlowPrimary}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{DynamicResource GradientBrush.ProfileDetailView.AccentGlowSecondary}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{DynamicResource GradientBrush.ProfileDetailView.Vignette}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
