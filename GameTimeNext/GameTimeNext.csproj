<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Authors>CryLoud Studios</Authors>
		<Copyright>© $(Authors)</Copyright>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<PlatformTarget>x64</PlatformTarget>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<OutputType>WinExe</OutputType>

		<ApplicationIcon>UI\Ressources\GTN_APP_ICON.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup>
		<VersionSemantic>0.4.0</VersionSemantic>
		<VersionTag>beta</VersionTag>
		<BuildDate>2026-06-21</BuildDate>

		<AssemblyVersion>$(VersionSemantic)</AssemblyVersion>
		<FileVersion>$(AssemblyVersion)</FileVersion>
		<VersionPrefix>$(AssemblyVersion)</VersionPrefix>
		<VersionSuffix>$(VersionTag)</VersionSuffix>

		<InformationalVersion>$(VersionSemantic)-$(VersionTag)+$(BuildDate)</InformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Changelogs (UpdateChanges_v*), read from the output directory at startup -->
		<None Remove="Core\Application\UpdateChanges\**" />
		<Content Include="Core\Application\UpdateChanges\**" CopyToOutputDirectory="PreserveNewest" />

		<!-- Images, embedded in the assembly and referenced as pack URIs (/UI/Ressources/...); not copied to the output -->
		<None Remove="UI\Ressources\**" />
		<Resource Include="UI\Ressources\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Native e_sqlite3 library required by System.Data.SQLite 2.x -->
		<PackageReference Include="SourceGear.sqlite3" Version="3.53.4" />
		<PackageReference Include="System.Data.SQLite" Version="2.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\UIX.ViewController.Engine\UIX.ViewController.Engine.csproj" />
		<ProjectReference Include="..\..\UIXMonitorTweaks\UIXMonitorTweaks.csproj" />
	</ItemGroup>

</Project>
