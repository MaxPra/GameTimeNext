<ui:GTNWindow
    x:Class="GameTimeNext.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:subviews="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uiFramework="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Width="1350"
    Height="1000"
    MinWidth="1350"
    MinHeight="1000"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    ApplicationSearchPlaceholder="Search Application"
    ShowApplicationSearch="False"
    ShowAppIcon="True"
    ShowBigPictureButton="True"
    ShowHelpButton="True"
    Style="{StaticResource GTNWindowStyle}"
    Subtitle="beta"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="pnlDevPathsHeader"
            Grid.Row="0"
            Height="26"
            Margin="0"
            Padding="8,2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="#FF8B0000"
            ToolTip="DEVMODE ON: Development paths are being used."
            Visibility="Collapsed">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="DEVMODE ON: Development paths are being used." />

        </Border>

        <Border
            x:Name="pnlUserModeHeader"
            Grid.Row="1"
            Height="26"
            Margin="0"
            Padding="8,2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Panel.ZIndex="10"
            Background="#FF6060CB"
            ToolTip="USERMODE ON: User mode is enabled."
            Visibility="Collapsed">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="USERMODE ON: User mode is enabled." />

        </Border>

        <uixsel:UIXTabControl
            x:Name="MainTabControl"
            Grid.Row="2"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            uiFramework:TabControlBehaviors.AddButtonToolTip="Open application menu (Ctrl+M)"
            uiFramework:TabControlBehaviors.FavoritesButtonToolTip="Start order of the favorites"
            uiFramework:TabControlBehaviors.ShowAddButton="True"
            uiFramework:TabControlBehaviors.ShowFavoritesButton="True"
            Background="Transparent"
            BorderThickness="0"
            Style="{StaticResource ModernTabControlStyle}">

            <!--<uixsel:UIXTabControl.ItemContainerStyle>
                <Style BasedOn="{StaticResource ModernTabItemStyle}" TargetType="TabItem">

                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                <MenuItem
                                    x:Name="ctxtClose"
                                    Header="Close"
                                    Style="{StaticResource ModernContextMenuItemStyle}">

                                    <MenuItem.Icon>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Font.Icons}"
                                            FontSize="14"
                                            Text="&#xE8BB;" />
                                    </MenuItem.Icon>

                                </MenuItem>
                                <MenuItem
                                    x:Name="ctxtFav"
                                    Header="Add to favorites"
                                    Style="{StaticResource ModernContextMenuItemStyle}">

                                    <MenuItem.Icon>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="{StaticResource Font.Icons}"
                                            FontSize="14"
                                            Text="&#xE734;" />
                                    </MenuItem.Icon>

                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </uixsel:UIXTabControl.ItemContainerStyle>-->

        </uixsel:UIXTabControl>

        <!--
            Start order of the favorites (FavAppsStartOrderView), opened by the down arrow in the tab bar
            (template part btnTabFavorites, set as PlacementTarget by the controller)
        -->
        <Popup
            x:Name="popFavAppsStartOrder"
            AllowsTransparency="True"
            Placement="Bottom"
            StaysOpen="False"
            VerticalOffset="4">
            <Border Style="{StaticResource ModernPopupCardStyle}">
                <ContentPresenter x:Name="cpFavAppsStartOrder" />
            </Border>
        </Popup>

        <!--  Welcome screen while no application is open: welcome card on the left, help cards on the right  -->
        <StackPanel
            x:Name="pnlEmptyTabMessage"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">

        <!--  Welcome card: what the user can do next  -->
        <Border
            Width="560"
            Padding="36,32"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">
            <Border.Resources>
                <!--  Key cap, e.g. "Ctrl", "M" or the help glyph of the title bar  -->
                <Style x:Key="EmptyState.Key" TargetType="Border">
                    <Setter Property="MinWidth" Value="34" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Padding" Value="9,0" />
                    <Setter Property="Background" Value="{StaticResource Brush.Input.Background}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.TextBox.Border}" />
                    <Setter Property="BorderThickness" Value="1,1,1,2" />
                    <Setter Property="CornerRadius" Value="{StaticResource Control.CornerRadius}" />
                </Style>
                <Style x:Key="EmptyState.KeyText" TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                </Style>
                <Style x:Key="EmptyState.Plus" TargetType="TextBlock">
                    <Setter Property="Margin" Value="6,0" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </Style>
                <Style x:Key="EmptyState.Title" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                </Style>
                <Style x:Key="EmptyState.Hint" TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,2,0,0" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </Style>
            </Border.Resources>

            <StackPanel>
                <!--  Header  -->
                <Border
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    Background="{StaticResource Brush.Item.Selected}"
                    CornerRadius="32">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.Icons}"
                        FontSize="30"
                        Foreground="{DynamicResource Brush.Accent}"
                        Text="&#xE7FC;" />
                </Border>

                <TextBlock
                    x:Name="txWelcomeTitle"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}" />

                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="No application is open yet. Here is how to get going:" />

                <Border
                    Height="1"
                    Margin="0,24"
                    Background="{StaticResource Brush.Card.Border}" />

                <!--  What the user can do: keys on the left, explanation on the right  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Open an application  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border Style="{StaticResource EmptyState.Key}">
                            <TextBlock Style="{StaticResource EmptyState.KeyText}" Text="Ctrl" />
                        </Border>
                        <TextBlock Style="{StaticResource EmptyState.Plus}" Text="+" />
                        <Border Style="{StaticResource EmptyState.Key}">
                            <TextBlock Style="{StaticResource EmptyState.KeyText}" Text="M" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Style="{StaticResource EmptyState.Title}" Text="Open an application" />
                        <TextBlock Style="{StaticResource EmptyState.Hint}" Text="Or click + next to the tabs. Start with Profiles to add your games." />
                    </StackPanel>

                    <!--  Help on GameTimeNext: same glyph as the help button of the title bar (BtnHelp)  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource EmptyState.Key}">
                        <TextBlock
                            FontFamily="{StaticResource Font.Icons}"
                            Style="{StaticResource EmptyState.KeyText}"
                            Text="&#xE897;" />
                    </Border>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock x:Name="txHelpTitle" Style="{StaticResource EmptyState.Title}" />
                        <TextBlock Style="{StaticResource EmptyState.Hint}" Text="Click the question mark at the top right of the title bar." />
                    </StackPanel>

                    <!--  Help on an application  -->
                    <Border
                        Grid.Row="4"
                        Grid.Column="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource EmptyState.Key}">
                        <TextBlock
                            FontFamily="{StaticResource Font.Icons}"
                            Style="{StaticResource EmptyState.KeyText}"
                            Text="&#xE962;" />
                    </Border>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <TextBlock Style="{StaticResource EmptyState.Title}" Text="Get help on an application" />
                        <TextBlock Style="{StaticResource EmptyState.Hint}" Text="Right-click its tab and choose Help." />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!--
            Help cards: a click opens the help text of the application (application definition, field help text),
            the same text as "Help" in the context menu of its tab
        -->
        <StackPanel Width="320" Margin="16,0,0,0" VerticalAlignment="Center">
            <StackPanel.Resources>
                <Style x:Key="EmptyState.CardTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                </Style>
                <Style x:Key="EmptyState.CardText" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                </Style>
                <Style x:Key="EmptyState.CardIcon" TargetType="TextBlock">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                </Style>
            </StackPanel.Resources>

            <TextBlock
                Margin="4,0,0,8"
                Style="{StaticResource Text.Label}"
                Text="Learn what you can do" />

            <Button x:Name="btnHelpProfiles" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE7FC;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="Add your games" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Profiles: your library, one profile per game, with Steam import." />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="btnHelpPlaythroughs" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE768;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="Track your playthroughs" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Playthroughs: every run of a game with its own playtime and progress." />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="btnHelpDashboard" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE9F9;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="See your playtime" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Dashboard: statistics and an overview of what you played." />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="btnHelpScreensetups" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE7F4;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="Set up your displays" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Screensetups: switch monitors, resolution and audio device for a game." />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="btnHelpBigPicture" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE740;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="Play from the couch" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Big Picture mode: your library full screen, for TV and game controller." />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button x:Name="btnHelpSettings" Style="{StaticResource Card.Button}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource EmptyState.CardIcon}" Text="&#xE713;" />
                    <StackPanel Width="236">
                        <TextBlock Style="{StaticResource EmptyState.CardTitle}" Text="Make it yours" />
                        <TextBlock Style="{StaticResource EmptyState.CardText}" Text="Settings: appearance, hotkeys, API keys and backups." />
                    </StackPanel>
                </StackPanel>
            </Button>
        </StackPanel>
        </StackPanel>

        <!--  Big Picture mode (BigPictureApp): full screen layer over the tabs, shown while the mode is active  -->
        <ContentPresenter
            x:Name="cpBigPicture"
            Grid.Row="0"
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Visibility="Collapsed" />

    </Grid>
</ui:GTNWindow>