<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Codetables.Views.CodetablesEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    xmlns:uixcb="clr-namespace:UIX.ViewController.Engine.FrameworkElements.ComboBoxes;assembly=UIX.ViewController.Engine"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Codetable"
    Width="1100"
    Height="500"
    ResizeMode="NoResize"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <uixsel:UIXTabControl x:Name="tabControl" Grid.Row="0">
            <TabItem Header="General">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Text type" />

                    <TextBox
                        x:Name="TxbTextType"
                        Grid.Row="0"
                        Grid.Column="2"
                        Width="100"
                        Height="36"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.TXTYP" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Description" />

                    <TextBox
                        x:Name="TxbDescription"
                        Grid.Row="2"
                        Grid.Column="2"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.DESCR" />

                    <uixcb:UIXComboBox
                        x:Name="CmbPermission"
                        Grid.Row="4"
                        Grid.Column="2"
                        Height="36"
                        VerticalAlignment="Center"
                        AdditionalEntry="(None)"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PERMI"
                        uixprops:UIXAttachedProperty.Source="From=T1CTABD;Where=TXTYP:cP;Text=DESCR;Value=TXNUM"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Permission" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Number Range active" />

                    <StackPanel
                        Grid.Row="6"
                        Grid.Column="2"
                        Orientation="Horizontal">
                        <CheckBox
                            x:Name="ChbNumberRangeActive"
                            Padding="0"
                            VerticalAlignment="Center"
                            uixprops:UIXAttachedProperty.Path="T1CTABH.NRANA" />

                        <CheckBox
                            x:Name="ChbExportIntoImportPackage"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            uixprops:UIXAttachedProperty.Path="T1CTABH.EXPRT"
                            Content="Export into import package" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Parameters">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Active" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Description" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Tooltip" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Required Field" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="8"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Control-Type" />
                    <TextBlock
                        x:Name="LblParamCodetable"
                        Grid.Row="0"
                        Grid.Column="10"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Codetable" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="12"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Button API (CTAPI_&lt;Name&gt;)" />

                    <CheckBox
                        x:Name="ChbParam1Active"
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PAAC1" />
                    <TextBox
                        x:Name="TxbParam1Description"
                        Grid.Row="2"
                        Grid.Column="2"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PADE1" />
                    <TextBox
                        x:Name="TxbParam1Tooltip"
                        Grid.Row="2"
                        Grid.Column="4"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PTOL1" />
                    <CheckBox
                        x:Name="ChbParam1Required"
                        Grid.Row="2"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PARF1" />
                    <uixcb:UIXComboBox
                        x:Name="CmbParam1ControlType"
                        Grid.Row="2"
                        Grid.Column="8"
                        Height="36"
                        VerticalAlignment="Center"
                        AdditionalEntry="(None)"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PACO1"
                        uixprops:UIXAttachedProperty.Source="From=T1CTABD;Where=TXTYP:cO;Text=DESCR;Value=TXNUM"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />
                    <uixcb:UIXComboBox
                        x:Name="CmbParam1Codetable"
                        Grid.Row="2"
                        Grid.Column="10"
                        Height="36"
                        VerticalAlignment="Center"
                        AdditionalEntry="(None)"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PACT1"
                        uixprops:UIXAttachedProperty.Source="From=T1CTABH;Text=DESCR;Value=TXTYP"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />
                    <TextBox
                        x:Name="txbParam1ButtonApi"
                        Grid.Row="2"
                        Grid.Column="12"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PAAP1"
                        ToolTip="Name of the API class without the prefix, e.g. ImageImport for CTAPI_ImageImport. The parameter then gets a button that runs it." />
                    <CheckBox
                        x:Name="ChbParam2Active"
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PAAC2" />
                    <TextBox
                        x:Name="TxbParam2Description"
                        Grid.Row="4"
                        Grid.Column="2"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PADE2" />
                    <TextBox
                        x:Name="TxbParam2Tooltip"
                        Grid.Row="4"
                        Grid.Column="4"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PTOL2" />
                    <CheckBox
                        x:Name="ChbParam2Required"
                        Grid.Row="4"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PARF2" />
                    <uixcb:UIXComboBox
                        x:Name="CmbParam2ControlType"
                        Grid.Row="4"
                        Grid.Column="8"
                        Height="36"
                        VerticalAlignment="Center"
                        AdditionalEntry="(None)"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PACO2"
                        uixprops:UIXAttachedProperty.Source="From=T1CTABD;Where=TXTYP:cO;Text=DESCR;Value=TXNUM"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />
                    <uixcb:UIXComboBox
                        x:Name="CmbParam2Codetable"
                        Grid.Row="4"
                        Grid.Column="10"
                        Height="36"
                        VerticalAlignment="Center"
                        AdditionalEntry="(None)"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PACT2"
                        uixprops:UIXAttachedProperty.Source="From=T1CTABH;Text=DESCR;Value=TXTYP"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />
                    <TextBox
                        x:Name="txbParam2ButtonApi"
                        Grid.Row="4"
                        Grid.Column="12"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABH.PAAP2"
                        ToolTip="Name of the API class without the prefix, e.g. ImageImport for CTAPI_ImageImport. The parameter then gets a button that runs it." />
                </Grid>
            </TabItem>
        </uixsel:UIXTabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BtnSave"
                Grid.Column="1"
                Width="140"
                Height="36"
                Content="Save"
                IsDefault="True"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
