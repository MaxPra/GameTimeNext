<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Codetables.Views.CodetablesEntryEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Codetable entry"
    Width="760"
    Height="430"
    ResizeMode="NoResize"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Textnumber" />

                <TextBox
                    x:Name="TxbTextNumber"
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="100"
                    Height="36"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1CTABD.TXNUM" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Description" />

                <TextBox
                    x:Name="TxbDescription"
                    Grid.Row="2"
                    Grid.Column="2"
                    Height="36"
                    VerticalContentAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1CTABD.DESCR" />

                <TextBlock
                    x:Name="LblParam1"
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Parameter 1"
                    Visibility="Collapsed" />

                <Grid Grid.Row="4" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox
                        x:Name="CmbParam1"
                        Grid.Row="0"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABD.PARM1"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="TxtParam1"
                        Grid.Row="2"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABD.PARM1"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        Visibility="Collapsed" />

                    <CheckBox
                        x:Name="CbParam1"
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        Content="Aktiv"
                        Visibility="Collapsed" />
                </Grid>

                <Grid Grid.Row="6" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox
                        x:Name="CmbParam2"
                        Grid.Row="0"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABD.PARM2"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag"
                        Visibility="Collapsed" />

                    <TextBox
                        x:Name="TxtParam2"
                        Grid.Row="2"
                        Height="36"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1CTABD.PARM2"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        Visibility="Collapsed" />

                    <CheckBox
                        x:Name="CbParam2"
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.SkipNotVisible="True"
                        Content="Aktiv"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="LblParam2"
                    Grid.Row="6"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Parameter 2"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BtnSkip"
                Grid.Column="1"
                Width="140"
                Height="36"
                Content="Skip" />

            <Button
                x:Name="BtnSave"
                Grid.Column="3"
                Width="140"
                Height="36"
                Content="Save"
                IsDefault="True" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
