<Window
    x:Class="GameTimeNext.Core.Application.General.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="GameTimeNext"
    Width="640"
    Height="360"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Padding="30"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        CornerRadius="{StaticResource DefaultCornerRadius}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Content  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Border
                    Width="150"
                    Height="150"
                    Padding="0"
                    Background="#14FFFFFF"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0.5"
                    CornerRadius="{DynamicResource DefaultCornerRadius}">
                    <Image Source="/UI/Ressources/GTN_CLS_ICON.png" Stretch="Uniform" />
                </Border>

                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="GameTimeNext" />

                        <Border
                            Margin="10,0,0,0"
                            Padding="8,2"
                            Background="{DynamicResource Brush.Accent}"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="BETA" />
                        </Border>

                        <Border
                            x:Name="DevBadge"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            Background="#FF8B0000"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="DEV-Mode" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="by CryLoud Studios" />

                    <TextBlock
                        x:Name="txtDevelopmentPathActive"
                        Margin="0,10,0,0"
                        FontSize="14"
                        Foreground="#FF8B0000"
                        Text="Developmentpaths active!" />
                </StackPanel>
            </StackPanel>

            <!--  Footer  -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextDisabled}"
                    Text="Initializing..." />

                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextDisabled}"
                    Text="{Binding AppVersion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

        </Grid>
    </Border>
</Window>