<Window
    x:Class="GameTimeNext.Core.Application.General.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI"
    Title="GameTimeNext"
    Width="640"
    Height="360"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    ui:AcrylicBlur.IsEnabled="True"
    mc:Ignorable="d">

    <!--
        Glass like the sub windows: acrylic blur behind the window (AcrylicBlur on the window),
        tinted with the app background and accent glow. The blur fills the whole window and gets the
        system corner radius (8), so no outer margin / shadow here. Without blur the opaque app background is used.
    -->
    <Border
        BorderBrush="{StaticResource Brush.Popup.GlassBorder}"
        BorderThickness="1"
        CornerRadius="{StaticResource Popup.CornerRadius}"
        SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <!--  Without blur the translucent tint would show the desktop unblurred  -->
                <Setter Property="Background" Value="{DynamicResource Brush.ProfileDetailView.Background}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Path=(ui:AcrylicBlur.IsActive), RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.Window.Translucent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="32,28,32,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Content  -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal">

                <!--  Logo: rounded image with a lit edge (the image itself is the surface, no frame around it)  -->
                <Grid Width="120" Height="120">
                    <Border
                        Background="#FF000000"
                        CornerRadius="{StaticResource Card.CornerRadius}"
                        Effect="{StaticResource Effect.Popup}" />
                    <Border CornerRadius="{StaticResource Card.CornerRadius}" RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush ImageSource="/UI/Ressources/GTN_CLS_ICON.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Card.CornerRadius}" />
                </Grid>

                <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="GameTimeNext" />

                        <Border
                            Margin="12,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Accent.Muted}"
                            BorderBrush="{DynamicResource Brush.Accent.Outline}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Item.CornerRadius}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="BETA" />
                        </Border>

                        <Border
                            x:Name="DevBadge"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Item.CornerRadius}">
                            <Border.Background>
                                <SolidColorBrush Opacity="0.18" Color="{DynamicResource Color.Danger}" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Opacity="0.6" Color="{DynamicResource Color.Danger}" />
                            </Border.BorderBrush>
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="DEV-Mode" />
                        </Border>
                    </StackPanel>

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="by CryLoud Studios" />

                    <TextBlock
                        x:Name="txtDevelopmentPathActive"
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Brush.Danger}"
                        Text="Developmentpaths active!" />
                </StackPanel>
            </StackPanel>

            <!--  Footer  -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Indeterminate loading line: an accent segment sliding over a hairline track  -->
                <Border
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Height="2"
                    Background="{StaticResource Brush.Card.Divider}"
                    ClipToBounds="True"
                    CornerRadius="1">
                    <Border
                        Width="140"
                        HorizontalAlignment="Left"
                        CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="Transparent" />
                                <GradientStop Offset="0.5" Color="{DynamicResource Color.AccentHover}" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoadingLineTransform" X="-140" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="LoadingLineTransform"
                                            Storyboard.TargetProperty="X"
                                            From="-140"
                                            To="580"
                                            Duration="0:0:1.6">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Initializing..." />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="{Binding AppVersion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Grid>
    </Border>
</Window>
