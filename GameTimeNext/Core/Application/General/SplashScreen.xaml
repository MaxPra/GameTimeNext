<Window
    x:Class="GameTimeNext.Core.Application.General.SplashScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI"
    Width="720"
    Height="440"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <!--
        The splash runs on its own UI thread (SplashHost), so the application resources are not available here:
        every color is a literal (values of Colors.xaml / CardStyles.xaml / ControlTokens.xaml) and nothing may use
        DynamicResource or StaticResource of the application.
    -->
    <Window.Resources>
        <!--  The "a" mark (same geometry as Branding/icon_large.svg, without tile), scaled by a Viewbox  -->
        <LinearGradientBrush x:Key="Splash.MarkLine" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#5DB6F3" />
            <GradientStop Offset="0.5" Color="#3498E5" />
            <GradientStop Offset="1" Color="#2289DA" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Splash.MarkSegment" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Offset="0" Color="#BFE4FF" />
            <GradientStop Offset="1" Color="#8ED1FA" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Splash.WordmarkLine" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#5DB6F3" />
            <GradientStop Offset="1" Color="#2A8FDF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Splash.CardBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#24FFFFFF" />
            <GradientStop Offset="1" Color="#08FFFFFF" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Splash.TextPrimary" Color="#FFD5D5D8" />
        <SolidColorBrush x:Key="Splash.TextSecondary" Color="#FF94949B" />
        <SolidColorBrush x:Key="Splash.TextDisabled" Color="#FF6F6F7F" />
        <SolidColorBrush x:Key="Splash.Danger" Color="#FFFF4C66" />
        <Canvas
            x:Key="Splash.Mark"
            x:Shared="False"
            Width="568"
            Height="568">
            <Path
                Canvas.Left="-196"
                Canvas.Top="-228"
                Data="M 247.6,471.0 A 236,236 0 1 0 560.7,290.2"
                Stroke="{StaticResource Splash.MarkLine}"
                StrokeThickness="66" />
            <Path
                Canvas.Left="-196"
                Canvas.Top="-228"
                Data="M 716,512 L 716,748"
                Stroke="{StaticResource Splash.MarkLine}"
                StrokeEndLineCap="Round"
                StrokeThickness="66" />
            <Path
                Canvas.Left="-196"
                Canvas.Top="-228"
                Data="M 521.0,279.6 A 236,236 0 0 0 258.2,431.3"
                Stroke="{StaticResource Splash.MarkSegment}"
                StrokeThickness="66" />
        </Canvas>

        <!--  Wordmark strokes (geometry from Branding/wordmark.svg, baseline at y = 0), shared by the paths and the particles  -->
        <Geometry x:Key="Splash.WordmarkRings">M 15.5,-17.4 A 100,100 0 1 0 148.2,-94.0 M 770.8,0 A 100,100 0 1 0 970.8,0 A 100,100 0 1 0 770.8,0 Z M 1281.4,0 A 100,100 0 1 0 1481.4,0 A 100,100 0 1 0 1281.4,0 Z</Geometry>
        <Geometry x:Key="Splash.WordmarkStems">M 214.0,0 L 214.0,100 M 294.0,-100 L 294.0,100 M 294.0,0 A 100,100 0 0 1 470.6,-64.3 M 701.2,-64.3 A 100,100 0 1 0 701.2,64.3 M 1050.8,-100 L 1050.8,100 M 1050.8,0 A 100,100 0 0 1 1227.4,-64.3 M 1481.4,0 L 1481.4,100</Geometry>
        <Geometry x:Key="Splash.WordmarkSegment">M 131.4,-98.5 A 100,100 0 0 0 20.0,-34.2</Geometry>
        <GeometryGroup x:Key="Splash.WordmarkTargets">
            <StaticResource ResourceKey="Splash.WordmarkRings" />
            <StaticResource ResourceKey="Splash.WordmarkStems" />
            <StaticResource ResourceKey="Splash.WordmarkSegment" />
        </GeometryGroup>

        <!--  Timing of the writing animation: reveal, glow front and particles (SplashWordmarkParticles) share it  -->
        <sys:TimeSpan x:Key="Splash.WriteBegin">0:0:0.55</sys:TimeSpan>
        <Duration x:Key="Splash.WriteDuration">0:0:1.5</Duration>

        <Style x:Key="Splash.Badge" TargetType="Border">
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Padding" Value="7,2,7,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Splash.BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Splash.TextPrimary}" />
        </Style>
    </Window.Resources>

    <!--
        Writing animation of the wordmark. The splash has its own UI thread, so nothing blocks it. The particles are drawn
        by SplashWordmarkParticles; here the solid wordmark is revealed behind them (linear, because the particles are
        timed to the edge) and the tagline follows.
    -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard BeginTime="{StaticResource Splash.WriteBegin}">
                    <DoubleAnimation
                        Storyboard.TargetName="gstRevealStart"
                        Storyboard.TargetProperty="Offset"
                        From="-0.12"
                        To="1"
                        Duration="{StaticResource Splash.WriteDuration}" />
                    <DoubleAnimation
                        Storyboard.TargetName="gstRevealEnd"
                        Storyboard.TargetProperty="Offset"
                        From="0"
                        To="1.12"
                        Duration="{StaticResource Splash.WriteDuration}" />
                    <DoubleAnimation
                        Storyboard.TargetName="trfWriteGlow"
                        Storyboard.TargetProperty="X"
                        From="-90"
                        To="1586"
                        Duration="{StaticResource Splash.WriteDuration}" />
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ellWriteGlow" Storyboard.TargetProperty="Opacity">
                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                        <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="0.8" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="0.8" />
                        <LinearDoubleKeyFrame KeyTime="0:0:1.75" Value="0" />
                    </DoubleAnimationUsingKeyFrames>

                    <!--  Tagline and badges when the wordmark is nearly written  -->
                    <DoubleAnimation
                        BeginTime="0:0:0.9"
                        Storyboard.TargetName="txtTagline"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.5" />
                    <DoubleAnimation
                        BeginTime="0:0:1.1"
                        Storyboard.TargetName="brdBeta"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.4" />
                    <DoubleAnimation
                        BeginTime="0:0:1.1"
                        Storyboard.TargetName="brdDevBadge"
                        Storyboard.TargetProperty="Opacity"
                        To="1"
                        Duration="0:0:0.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!--
        Opaque dark card with a shadow (the margin leaves room for it), so the splash looks the same on every desktop.
        Rounded clip of the content: ClipBehaviors.CornerRadius on the inner grid.
    -->
    <Grid>
        <!--
            The shadow sits on its own static layer and is cached as a bitmap: an effect on the animated card would
            be blurred again in every frame (in software over remote desktop), which made the animation stutter.
        -->
        <Border
            Margin="24"
            Background="#FF0C0C10"
            CacheMode="BitmapCache"
            CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Opacity="0.55"
                    ShadowDepth="6"
                    Color="#000000" />
            </Border.Effect>
        </Border>

        <Border Margin="24" CornerRadius="16">
            <Grid ui:ClipBehaviors.CornerRadius="16">

            <!--  Background: dark gradient, accent light top left, large brand mark cut off at the right  -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF1A1A22" />
                        <GradientStop Offset="1" Color="#FF0A0A0E" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <RadialGradientBrush Center="0.12,0.1" GradientOrigin="0.12,0.1" RadiusX="0.75" RadiusY="0.95">
                        <GradientStop Offset="0" Color="#2E3498E5" />
                        <GradientStop Offset="1" Color="#003498E5" />
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Viewbox
                Width="420"
                Height="420"
                Margin="0,0,-120,-150"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Child="{StaticResource Splash.Mark}"
                Opacity="0.07" />

            <!--  Fine lit edge  -->
            <Border
                BorderBrush="{StaticResource Splash.CardBorder}"
                BorderThickness="1"
                CornerRadius="16" />

            <Grid Margin="44,44,44,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Brand: wordmark (the first "a" is the mark), tagline  -->
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!--  Wordmark, geometry from Branding/wordmark.svg (viewBox 0 -114 1496 228)  -->
                            <Viewbox Height="44" VerticalAlignment="Center">
                                <Grid Width="1496" Height="228">

                                    <!--
                                        The solid wordmark appears behind the particles: a soft-edged opacity mask moves over it
                                        from left to right (stops animated in Window.Triggers).
                                    -->
                                    <Canvas Width="1496" Height="228">
                                        <Canvas.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop x:Name="gstRevealStart" Offset="-0.12" Color="Black" />
                                                <GradientStop x:Name="gstRevealEnd" Offset="0" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Canvas.OpacityMask>
                                        <!--  Soft halo: wider, faint strokes instead of a blur effect (an effect is redrawn in every frame)  -->
                                        <Path
                                            Canvas.Top="114"
                                            Data="{StaticResource Splash.WordmarkTargets}"
                                            Opacity="0.07"
                                            Stroke="#3498E5"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="76" />
                                        <Path
                                            Canvas.Top="114"
                                            Data="{StaticResource Splash.WordmarkTargets}"
                                            Opacity="0.1"
                                            Stroke="#3498E5"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="54" />
                                        <Path
                                            Canvas.Top="114"
                                            Data="{StaticResource Splash.WordmarkRings}"
                                            Stroke="{StaticResource Splash.WordmarkLine}"
                                            StrokeThickness="28" />
                                        <Path
                                            Canvas.Top="114"
                                            Data="{StaticResource Splash.WordmarkStems}"
                                            Stroke="{StaticResource Splash.WordmarkLine}"
                                            StrokeEndLineCap="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeThickness="28" />
                                        <Path
                                            Canvas.Top="114"
                                            Data="{StaticResource Splash.WordmarkSegment}"
                                            Stroke="{StaticResource Splash.MarkSegment}"
                                            StrokeThickness="28" />
                                    </Canvas>

                                    <!--  Glow at the writing edge  -->
                                    <Canvas
                                        Width="1496"
                                        Height="228"
                                        IsHitTestVisible="False">
                                        <Ellipse
                                            x:Name="ellWriteGlow"
                                            Canvas.Left="-60"
                                            Canvas.Top="-40"
                                            Width="120"
                                            Height="308"
                                            Opacity="0">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0" Color="#D0FFFFFF" />
                                                    <GradientStop Offset="0.3" Color="#703498E5" />
                                                    <GradientStop Offset="1" Color="#003498E5" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform x:Name="trfWriteGlow" X="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Canvas>

                                    <!--  Particles that form the strokes, drawn by the element itself  -->
                                    <ui:SplashWordmarkParticles
                                        Width="1496"
                                        Height="228"
                                        IsHitTestVisible="False"
                                        Targets="{StaticResource Splash.WordmarkTargets}"
                                        WriteBegin="{StaticResource Splash.WriteBegin}"
                                        WriteDuration="{StaticResource Splash.WriteDuration}" />
                                </Grid>
                            </Viewbox>

                            <Border
                                x:Name="brdBeta"
                                Background="#523498E5"
                                BorderBrush="#BF1A7FCB"
                                Opacity="0"
                                Style="{StaticResource Splash.Badge}">
                                <TextBlock Style="{StaticResource Splash.BadgeText}" Text="BETA" />
                            </Border>

                            <Border
                                x:Name="brdDevBadge"
                                Background="#2EFF4C66"
                                BorderBrush="#99FF4C66"
                                Opacity="0"
                                Style="{StaticResource Splash.Badge}">
                                <TextBlock Style="{StaticResource Splash.BadgeText}" Text="DEV" />
                            </Border>
                        </StackPanel>

                        <TextBlock
                            x:Name="txtTagline"
                            Margin="2,14,0,0"
                            FontSize="14"
                            Foreground="{StaticResource Splash.TextSecondary}"
                            Opacity="0"
                            Text="Game library and playtime tracking" />
                    </StackPanel>
                </StackPanel>

                <!--  Status, version, publisher  -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="txtDevelopmentPathActive"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,10"
                        FontSize="12"
                        Foreground="{StaticResource Splash.Danger}"
                        Text="Development paths active" />

                    <TextBlock
                        Grid.Row="1"
                        FontSize="13"
                        Foreground="{StaticResource Splash.TextPrimary}"
                        Text="Starting…" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="12"
                        Foreground="{StaticResource Splash.TextSecondary}"
                        Text="{Binding AppVersion, Mode=OneWay}" />

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,14,0,0"
                        Orientation="Horizontal">
                        <Border
                            Width="16"
                            Height="16"
                            CornerRadius="4"
                            RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush ImageSource="/UI/Ressources/GTN_CLS_ICON.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource Splash.TextDisabled}"
                            Text="© CryLoud Studios" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Indeterminate loading line on the bottom edge: an accent segment sliding over a hairline track  -->
            <Border
                Height="2"
                VerticalAlignment="Bottom"
                Background="#12FFFFFF"
                ClipToBounds="True">
                <Border Width="180" HorizontalAlignment="Left">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#3498E5" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="LoadingLineTransform" X="-180" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="LoadingLineTransform"
                                        Storyboard.TargetProperty="X"
                                        From="-180"
                                        To="672"
                                        Duration="0:0:1.6">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
