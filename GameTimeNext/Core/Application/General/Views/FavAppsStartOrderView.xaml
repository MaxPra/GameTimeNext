<uixcontrols:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.General.Views.FavAppsStartOrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixcontrols="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Width="380">

    <!--  Shown inside the favorites popup of the main window (ModernPopupCardStyle), which provides surface and padding  -->
    <StackPanel>
        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Start order of the favorites" />
        <TextBlock
            Margin="0,4,0,12"
            Style="{StaticResource Text.Hint}"
            Text="These applications open when GameTimeNext starts, in this order. Drag a row to move it."
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="txNoFavApps"
            Style="{StaticResource Text.Hint}"
            Text="No favorites yet. Right-click a tab and choose &quot;Add to favorites&quot;."
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Rows are reordered by dragging (EV_dgFavApps_DragAndDrop in the controller)  -->
        <uixsel:UIXDataGrid
            x:Name="dgFavApps"
            MaxHeight="420"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <uixsel:UIXDataGrid.Columns>
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Font.Icons}"
                                FontSize="14"
                                Text="{Binding COICON}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding CONAME}"
                    Header="Application" />
                <DataGridCheckBoxColumn
                    Width="110"
                    Binding="{Binding COPRST}"
                    Header="Primary start" />
            </uixsel:UIXDataGrid.Columns>
        </uixsel:UIXDataGrid>
    </StackPanel>
</uixcontrols:UIXUserControlBase>
