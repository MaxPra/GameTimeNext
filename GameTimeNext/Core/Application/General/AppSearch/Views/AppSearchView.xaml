<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.General.AppSearch.Views.AppSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.General.AppSearch.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    Title="Application Search"
    Width="600"
    Height="400"
    MinWidth="400"
    MinHeight="300"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Search Bar: one TextBox with the icon inside, so hover/focus outline wraps the whole bar  -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBox
                x:Name="txbSearch"
                Height="40"
                MinHeight="40"
                Padding="36,6,11,6"
                FontSize="13"
                Tag="Search applications..." />

            <TextBlock
                Margin="14,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="Segoe MDL2 Assets"
                FontSize="14"
                Foreground="{DynamicResource Brush.TextSecondary}"
                IsHitTestVisible="False"
                Text="&#xE721;" />
        </Grid>

        <!--  Applications List  -->
        <Border
            Grid.Row="1"
            Padding="0"
            Style="{StaticResource Card}">
            <ListView
                x:Name="lvApplicationSearch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding SearchableApplications}"
                SelectedItem="{Binding SelectedSearchableApplication, Mode=TwoWay}"
                SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.Accent}"
                                Text="{Binding Code, StringFormat='[{0}]'}" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>
        </Border>
    </Grid>
</ui:GTNWindowView>
