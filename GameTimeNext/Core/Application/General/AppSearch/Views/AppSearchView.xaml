<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.General.AppSearch.Views.AppSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Title="Application Search"
    Width="760"
    Height="560"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Search bar: one TextBox with the icon inside, so hover/focus outline wraps the whole bar  -->
        <Grid Grid.Row="0">
            <TextBox
                x:Name="txbSearch"
                Height="44"
                MinHeight="44"
                Padding="40,6,12,6"
                FontSize="14"
                Tag="Search applications and folders..." />

            <TextBlock
                Margin="14,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource Font.Icons}"
                FontSize="16"
                Foreground="{DynamicResource Brush.TextSecondary}"
                IsHitTestVisible="False"
                Text="&#xE721;" />
        </Grid>

        <!--  Menu calls as tree: folders and the applications in them  -->
        <Grid Grid.Row="2">
            <uixsel:UIXTreeGrid
                x:Name="dgApplications"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserResizeColumns="False"
                CanUserResizeRows="False"
                EnterMovesToNextRow="False"
                HeadersVisibility="None"
                IsReadOnly="True"
                KeepExpansionState="False"
                SelectionMode="Single"
                SelectionUnit="FullRow">
                <uixsel:UIXTreeGrid.Columns>
                    <uixsel:UIXTreeGridTextColumn Width="*" Binding="{Binding COMEDE}">
                        <uixsel:UIXTreeGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </uixsel:UIXTreeGridTextColumn.ElementStyle>
                    </uixsel:UIXTreeGridTextColumn>
                </uixsel:UIXTreeGrid.Columns>
            </uixsel:UIXTreeGrid>

            <!--  Empty state: shown by the controller when nothing matches  -->
            <StackPanel
                x:Name="pnlNoResults"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="{StaticResource Font.Icons}"
                    FontSize="28"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="&#xE721;" />
                <TextBlock
                    x:Name="txNoResults"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Subtitle}" />
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Text.Hint}"
                    Text="Only applications that are part of a menu are listed." />
            </StackPanel>
        </Grid>

        <!--  Footer: number of applications and the keys  -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="txResultCount"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource Text.Caption}" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource Text.Caption}"
                Text="↑ ↓  Navigate     Enter  Open     Esc  Close" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
