<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Metadata.Views.MetadataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Type" />

                    <ComboBox
                        x:Name="CmbType"
                        Grid.Column="2"
                        Height="36"
                        VerticalAlignment="Center"
                        SelectedIndex="0"
                        SelectedValue=""
                        SelectedValuePath="Tag" />
                </Grid>

                <Grid Grid.Column="2" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Table Object" />

                    <TextBox
                        x:Name="TxbTableObjectName"
                        Grid.Column="2"
                        Style="{StaticResource TextBox.Default}" />
                </Grid>

                <Grid Grid.Column="4" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Description" />

                    <TextBox
                        x:Name="TxbDescription"
                        Grid.Column="2"
                        Style="{StaticResource TextBox.Default}" />
                </Grid>

                <Button
                    x:Name="BtnAdd"
                    Grid.Column="6"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    ToolTip="Add metadata">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE710;" />
                </Button>

                <Button
                    x:Name="BtnRefresh"
                    Grid.Column="8"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    ToolTip="Refresh metadata">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE72C;" />
                </Button>

                <Button
                    x:Name="BtnOpenGenClass"
                    Grid.Column="10"
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    IsDefault="True"
                    ToolTip="Open genClass folder">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE8B7;" />
                </Button>
            </Grid>
        </Border>

        <uixsel:UIXDataGrid
            x:Name="DgMetadata"
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding MetadataDataGridRows}"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <uixsel:UIXDataGrid.Columns>
                <DataGridTextColumn
                    Width="250"
                    Binding="{Binding COMENAM}"
                    Header="Table Object" />
                <DataGridTextColumn
                    Width="400"
                    Binding="{Binding CODESCR}"
                    Header="Description" />
                <DataGridTextColumn
                    Width="250"
                    Binding="{Binding COMTYPE}"
                    Header="Type" />
            </uixsel:UIXDataGrid.Columns>
        </uixsel:UIXDataGrid>
    </Grid>
</uix:UIXUserControlBase>
