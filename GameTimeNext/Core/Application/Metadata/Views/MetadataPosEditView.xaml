<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Metadata.Views.MetadataPosEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Metadata Field"
    Width="840"
    Height="520"
    ResizeMode="NoResize"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /> <!-- Row for Elements with own margin (dynamic visibility) -->
                </Grid.RowDefinitions>

                <!-- Order -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Order" />
                <TextBox
                    x:Name="txbOrder"
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="120"
                    Height="36"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1METAP.PORDE" />

                <!-- Field -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Field" />
                <Grid
                    Grid.Row="2"
                    Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="txbField"
                        Grid.Column="0"
                        Width="200"
                        Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1METAP.PONAM" />
                    <CheckBox
                        x:Name="chbPrimaryKey"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        uixprops:UIXAttachedProperty.Path="T1METAP.PRIMK"
                        Content="Primary Key" />
                    <CheckBox
                        x:Name="chbAutoIncrement"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        uixprops:UIXAttachedProperty.Path="T1METAP.AUTOI"
                        Content="Autoincrement" />
                </Grid>

                <!-- Description -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Description" />
                <TextBox
                    x:Name="txbDescription"
                    Grid.Row="4"
                    Grid.Column="2"
                    Width="300"
                    Height="36"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    VerticalContentAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DESCR" />

                <!-- Datatype -->
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Datatype" />
                <ComboBox
                    x:Name="cmbDataType"
                    Grid.Row="6"
                    Grid.Column="2"
                    Width="300"
                    Height="36"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DATYP"
                    SelectedValuePath="Tag" />

                <Grid
                    Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Length -->
                    <TextBlock
                        x:Name="lblLength"
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="0,10,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Length" />
                    <TextBox
                        x:Name="txbLength"
                        Grid.Column="2"
                        Grid.Row="0"
                        Width="120"
                        Height="36"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left"
                        VerticalContentAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1METAP.DALEN" />

                    <!-- Default -->
                    <TextBlock
                        x:Name="lblDefault"
                        Grid.Column="0"
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Default" />
                    <Grid
                        Grid.Column="2"
                        Grid.Row="1"
                        Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            x:Name="chbDefault"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="Active" />
                        <CheckBox
                            x:Name="chbDefaultBool"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Content="Value" />
                        <TextBox
                            x:Name="txbDefault"
                            Grid.Column="2"
                            Width="300"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center" />
                        <!-- OFDOI: uixprops:UIXAttachedProperty.Path="T1METAP.DALEN" /> -->
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BtnSave"
                Grid.Column="1"
                Width="140"
                Height="36"
                Content="Save"
                IsDefault="True" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
