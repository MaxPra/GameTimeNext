<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Metadata.Views.MetadataPosEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixcb="clr-namespace:UIX.ViewController.Engine.FrameworkElements.ComboBoxes;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Metadata Field"
    Width="760"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Field: name, description, order  -->
        <GroupBox
            Grid.Row="0"
            Header="Field"
            Style="{StaticResource GroupBox.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource Text.Label}"
                    Text="Name" />
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="txbField"
                        Width="160"
                        uixprops:UIXAttachedProperty.Path="T1METAP.PONAM" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Style="{StaticResource Text.Hint}"
                        Text="4–5 characters, A–Z and 0–9, starting with a letter" />
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource Text.Label}"
                    Text="Description" />
                <TextBox
                    x:Name="txbDescription"
                    Grid.Row="2"
                    Grid.Column="2"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DESCR" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource Text.Label}"
                    Text="Order" />
                <TextBox
                    x:Name="txbOrder"
                    Grid.Row="4"
                    Grid.Column="2"
                    Width="120"
                    HorizontalAlignment="Left"
                    uixprops:UIXAttachedProperty.Path="T1METAP.PORDE" />
            </Grid>
        </GroupBox>

        <!--  Column: key, data type, length  -->
        <GroupBox
            Grid.Row="1"
            Header="Column"
            Style="{StaticResource GroupBox.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <!--  Length: spacing as margin, so nothing remains when it is hidden  -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource Text.Label}"
                    Text="Key" />
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Orientation="Horizontal">
                    <CheckBox
                        x:Name="chbPrimaryKey"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1METAP.PRIMK"
                        Content="Primary key" />
                    <!--  Only for a primary key; forces the data type  -->
                    <CheckBox
                        x:Name="chbAutoIncrement"
                        Margin="24,0,0,0"
                        VerticalAlignment="Center"
                        uixprops:UIXAttachedProperty.Path="T1METAP.AUTOI"
                        Content="Autoincrement" />
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource Text.Label}"
                    Text="Data type" />
                <uixcb:UIXComboBox
                    x:Name="cmbDataType"
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="300"
                    HorizontalAlignment="Left"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DATYP"
                    SelectedValuePath="Tag" />

                <TextBlock
                    x:Name="lblLength"
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,12,0,0"
                    Style="{StaticResource Text.Label}"
                    Text="Length" />
                <TextBox
                    x:Name="txbLength"
                    Grid.Row="3"
                    Grid.Column="2"
                    Width="120"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Left"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DALEN" />
            </Grid>
        </GroupBox>

        <!--  Default value: hidden for data types without default  -->
        <GroupBox
            x:Name="grpDefault"
            Grid.Row="2"
            Header="Default value"
            Style="{StaticResource GroupBox.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox
                    x:Name="chbDefault"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1METAP.DEFAK"
                    Content="Active" />

                <!--  Value input depends on the data type (checkbox for boolean, text box otherwise)  -->
                <CheckBox
                    x:Name="chbDefaultBool"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="True" />
                <TextBox
                    x:Name="txbDefault"
                    Grid.Column="2"
                    Width="300"
                    HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>

        <Button
            x:Name="btnSave"
            Grid.Row="3"
            Width="140"
            Height="36"
            HorizontalAlignment="Right"
            Content="Save"
            IsDefault="True"
            Style="{StaticResource Button.Primary}" />
    </Grid>
</ui:GTNWindowView>
