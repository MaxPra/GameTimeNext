<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Playthroughs.Views.PlaythroughEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Playthrough"
    Width="760"
    Height="250"
    MinWidth="760"
    MinHeight="250"
    ResizeMode="CanResize"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource DefaultCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Description" />

                <TextBox
                    x:Name="txbDescription"
                    Grid.Row="0"
                    Grid.Column="2"
                    Height="36"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1PLTHR.PTDE"
                    Style="{StaticResource TextBox.Default}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Type" />

                <ComboBox
                    x:Name="cmbType"
                    Grid.Row="2"
                    Grid.Column="2"
                    Height="36"
                    VerticalAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1PLTHR.PTTY"
                    SelectedIndex="0"
                    SelectedValue=""
                    SelectedValuePath="Tag" />
            </Grid>
        </Border>

        <Button
            x:Name="btnSave"
            Grid.Row="2"
            Width="140"
            Height="36"
            HorizontalAlignment="Right"
            Content="Save" />
    </Grid>
</ui:GTNWindowView>
