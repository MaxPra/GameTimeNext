<Window
    x:Class="GameTimeNext.Core.Application.TimeMonitoring.Views.MonitoringIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MonitoringIndicator"
    Width="16"
    Height="16"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid
        Width="12"
        Height="12"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Ellipse
            Width="12"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="{DynamicResource Brush.Accent}">
            <Ellipse.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Opacity="0.8"
                    ShadowDepth="0"
                    Color="{DynamicResource Color.Accent}" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse
            Width="12"
            Height="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Fill="Transparent"
            Stroke="#3FFFFFFF"
            StrokeThickness="2" />
    </Grid>

</Window>
