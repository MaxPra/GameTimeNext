<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Dashboard.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="900"
    d:DesignWidth="1150"
    mc:Ignorable="d">

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ===== Header =====  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="Dashboard" />
                <TextBlock
                    Margin="0,2,0,0"
                    FontSize="13"
                    FontWeight="Normal"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Overview of your playtime and statistics" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="grdTimeSpanOffset"
                    Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BtnDecreaseTimeSpan"
                        Grid.Column="0"
                        Width="40"
                        Height="36"
                        VerticalAlignment="Center"
                        ToolTip="Decrease Time Span">
                        <TextBlock
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Text="&#xE738;" />
                    </Button>

                    <TextBlock
                        x:Name="txtTimeSpanOffset"
                        Grid.Column="2"
                        Width="36"
                        TextAlignment="Center"
                        Text="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{DynamicResource Brush.TextPrimary}" />

                    <Button
                        x:Name="BtnIncreaseTimeSpan"
                        Grid.Column="4"
                        Width="40"
                        Height="36"
                        VerticalAlignment="Center"
                        ToolTip="Increase Time Span">
                        <TextBlock
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Text="&#xE710;" />
                    </Button>
                </Grid>
                
                <ComboBox
                    x:Name="CmbTimeRange"
                    Grid.Column="2"
                    Width="190"
                    Height="36"
                    VerticalAlignment="Center"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Last 7 Days" />
                    <ComboBoxItem Content="Last 30 Days" />
                    <ComboBoxItem Content="Last 365 Days" />
                    <ComboBoxItem Content="Week" />
                    <ComboBoxItem Content="Month" />
                    <ComboBoxItem Content="All Time" />
                </ComboBox>

                <Button
                    x:Name="BtnRefresh"
                    Grid.Column="4"
                    Width="40"
                    Height="36"
                    VerticalAlignment="Center"
                    ToolTip="Refresh">
                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="9"
                        Text="&#xE72C;" />
                </Button>
            </Grid>
        </Grid>

        <!--  ===== Top Row: Meist gespielt + Zuletzt gespielt =====  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="380" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Meist gespielt  -->
            <Border
                x:Name="MostPlayedCard"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Card header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE7FC;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Most Played" />
                    </StackPanel>

                    <!--  Game image + info  -->
                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Portrait cover image (2:3 ratio – 600x900)  -->
                        <Viewbox
                            Grid.Column="0"
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="Uniform">
                            <Grid Width="600" Height="900">
                                <Border
                                    Background="{DynamicResource Brush.Background}"
                                    ClipToBounds="True"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Image
                                        x:Name="imgMostPlayedCover"
                                        SnapsToDevicePixels="True"
                                        Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry
                                                RadiusX="8"
                                                RadiusY="8"
                                                Rect="0,0,600,900" />
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <!--  Gradient overlay at bottom  -->
                                <Border ClipToBounds="True" CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0.6" Color="Transparent" />
                                            <GradientStop Offset="1" Color="#CC000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!--  Rank badge  -->
                                <Border
                                    Margin="0,10,10,0"
                                    Padding="8,4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource Brush.Accent}"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="#1" />
                                </Border>
                            </Grid>
                        </Viewbox>

                        <!--  Game info on the right  -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Game title  -->
                            <TextBlock
                                x:Name="txtMostPlayedTitle"
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="n.A."
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <!--  Stats row  -->
                            <Border
                                Grid.Row="2"
                                Padding="10,8"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Background}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Spielzeit  -->
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.Accent}"
                                                Text="&#xE823;" />
                                            <TextBlock
                                                x:Name="txtMostPlayedPlaytime"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="n.A." />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Text="Playtime" />
                                    </StackPanel>

                                    <!--  Tage gespielt  -->
                                    <StackPanel Grid.Column="2" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.Accent}"
                                                Text="&#xE787;" />
                                            <TextBlock
                                                x:Name="txtMostPlayedDays"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="n.A." />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Text="Days Played" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <!--  Zuletzt gespielt  -->
            <Border
                Grid.Column="2"
                Height="{Binding ElementName=MostPlayedCard, Path=ActualHeight}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Card header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE7FC;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Last Played Game" />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        Margin="16,12,16,16"
                        VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Portrait cover image (2:3 ratio – 600x900)  -->
                        <Viewbox
                            Grid.Column="0"
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="Uniform">
                            <Grid Width="600" Height="900">
                                <Border
                                    Background="{DynamicResource Brush.Background}"
                                    ClipToBounds="True"
                                    CornerRadius="{StaticResource DefaultCornerRadius}">
                                    <Image
                                        x:Name="imgLastPlayedCover"
                                        SnapsToDevicePixels="True"
                                        Stretch="UniformToFill">
                                        <Image.Clip>
                                            <RectangleGeometry
                                                RadiusX="8"
                                                RadiusY="8"
                                                Rect="0,0,600,900" />
                                        </Image.Clip>
                                    </Image>
                                </Border>
                            </Grid>
                        </Viewbox>

                        <!--  Game info on the right  -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="txtLastPlayedTitle"
                                Grid.Row="0"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="n.A."
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Row="2"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Background}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <TextBlock
                                    x:Name="txtLastPlayedDate"
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="n.A." />
                            </Border>

                            <Border
                                Grid.Row="4"
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Background}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE823;" />
                                    <TextBlock
                                        x:Name="txtLastPlayedTime"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>


                </Grid>
            </Border>
        </Grid>

        <!--  ===== Bottom Row: 3 cards =====  -->
        <Grid Grid.Row="4" MinHeight="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Zuletzt gespielt  -->
            <Border
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE823;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Games Played" />
                    </StackPanel>

                    <!--  Recent game list  -->
                    <ListView
                        x:Name="ListViewRecentGames"
                        Grid.Row="1"
                        Margin="16,12,16,16"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        ItemContainerStyle="{StaticResource DashboardRecentGamesItemStyle}"
                        ItemsSource="{Binding T1Profis}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10,8"
                                    Background="{DynamicResource Brush.Background}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Height="46"
                                            Background="{DynamicResource Brush.Surface}"
                                            ClipToBounds="True"
                                            CornerRadius="{StaticResource DefaultCornerRadius}">
                                            <Image
                                                SnapsToDevicePixels="True"
                                                Source="{Binding COCOVIM}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding ItemObject.GANA}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                Text="{Binding ItemObject.LAPL, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <!--  Spielzeit Übersicht  -->
            <Border
                Grid.Column="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE823;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Playtime Overview" />
                    </StackPanel>

                    <!--  2x2 stat grid  -->
                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Gesamtspielzeit  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14,12"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE823;" />
                                    <TextBlock
                                        x:Name="txtTotalPlaytime"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Total Playtime" />
                            </StackPanel>
                        </Border>

                        <!--  Tage gespielt  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="14,12"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE787;" />
                                    <TextBlock
                                        x:Name="txtDaysPlayed"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Days Played" />
                            </StackPanel>
                        </Border>

                        <!--  Spiele gespielt  -->
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Padding="14,12"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DefaultCornerRadius}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE7FC;" />
                                    <TextBlock
                                        x:Name="txtGamesPlayed"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Games Played" />
                            </StackPanel>
                        </Border>

                        <!--  Achievements  -->

                    </Grid>
                </Grid>
            </Border>

            <!--  Gesamtstatistiken  -->
            <Border
                Grid.Column="4"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource DefaultCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,14,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE9D9;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Overall Statistics" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="12,10"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Played today" />
                                <TextBlock
                                    x:Name="txtStatPlayedToday"
                                    Margin="0,4,0,0"
                                    FontSize="19"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="n.A." />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="12,10"
                            Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Longest session" />
                                <TextBlock
                                    x:Name="txtStatLongestSession"
