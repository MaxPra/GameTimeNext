<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Dashboard.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="900"
    d:DesignWidth="1150"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ===== Toolbar: time span selection =====  -->
        <Border
            Grid.Row="0"
            Padding="16"
            Style="{StaticResource Card}">

            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="grdTimeSpanOffset"
                    Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="BtnDecreaseTimeSpan"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        ToolTip="Decrease Time Span"
                        Style="{StaticResource Button.Icon}">
                        <TextBlock
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="14"
                            Text="&#xE738;" />
                    </Button>

                    <TextBlock
                        x:Name="txtTimeSpanOffset"
                        Grid.Column="2"
                        Width="36"
                        TextAlignment="Center"
                        Text="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextPrimary}" />

                    <Button
                        x:Name="BtnIncreaseTimeSpan"
                        Grid.Column="4"
                        VerticalAlignment="Center"
                        ToolTip="Increase Time Span"
                        Style="{StaticResource Button.Icon}">
                        <TextBlock
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="14"
                            Text="&#xE710;" />
                    </Button>
                </Grid>
                
                <ComboBox
                    x:Name="CmbTimeRange"
                    Grid.Column="2"
                    Width="190"
                    Height="36"
                    VerticalAlignment="Center"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Last 7 Days" />
                    <ComboBoxItem Content="Last 30 Days" />
                    <ComboBoxItem Content="Last 365 Days" />
                    <ComboBoxItem Content="Day" />
                    <ComboBoxItem Content="Week" />
                    <ComboBoxItem Content="Month" />
                    <ComboBoxItem Content="All Time" />
                </ComboBox>

                <Button
                    x:Name="BtnRefresh"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    ToolTip="Refresh"
                    Style="{StaticResource Button.Icon}">
                    <TextBlock
                        FontFamily="{StaticResource Font.Icons}"
                        FontSize="14"
                        Text="&#xE72C;" />
                </Button>
            </Grid>
        </Border>

        <!--  ===== Top Row: Most played + Last played =====  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" MinWidth="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--  Most played  -->
            <Border
                x:Name="MostPlayedCard"
                Grid.Column="0"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Card header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE7FC;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Most Played" />
                    </StackPanel>

                    <!--  Game image + info  -->
                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Showcase: the case wide open on a plinth, the disc in front (style GameCase.Showcase, base 340 x 430)  -->
                        <Viewbox
                            Grid.Column="0"
                            MaxHeight="440"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="Uniform">
                            <ContentControl x:Name="ccMostPlayedCase" Style="{StaticResource GameCase.Showcase}" />
                        </Viewbox>

                        <!--  Game info on the right  -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  Game title  -->
                            <TextBlock
                                x:Name="txtMostPlayedTitle"
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                FontSize="28"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="n.A."
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <!--  Stats row  -->
                            <Border
                                Grid.Row="2"
                                Padding="10,8"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Card.Inset}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Playtime  -->
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.Accent}"
                                                Text="&#xE823;" />
                                            <TextBlock
                                                x:Name="txtMostPlayedPlaytime"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="n.A." />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Text="Playtime" />
                                    </StackPanel>

                                    <!--  Days played  -->
                                    <StackPanel Grid.Column="2" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.Accent}"
                                                Text="&#xE787;" />
                                            <TextBlock
                                                x:Name="txtMostPlayedDays"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="n.A." />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Normal"
                                            Foreground="{DynamicResource Brush.TextSecondary}"
                                            Text="Days Played" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>

            <!--  Last played  -->
            <Border
                Grid.Column="2"
                Height="{Binding ElementName=MostPlayedCard, Path=ActualHeight}"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Card header  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE81C;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Last Played Game" />
                    </StackPanel>

                    <Grid
                        Grid.Row="1"
                        Margin="16,12,16,16"
                        VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Game case (style GameCase, base 246 x 366 drawn at 280 x 417), opens while hovered  -->
                        <Viewbox
                            Grid.Column="0"
                            MaxWidth="280"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Stretch="Uniform">
                            <ContentControl
                                x:Name="ccLastPlayedCase"
                                Width="280"
                                Height="417"
                                Style="{StaticResource GameCase}" />
                        </Viewbox>

                        <!--  Game info on the right  -->
                        <Grid Grid.Column="2" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                x:Name="txtLastPlayedTitle"
                                Grid.Row="0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="n.A."
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />

                            <Border
                                Grid.Row="2"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Card.Inset}">
                                <TextBlock
                                    x:Name="txtLastPlayedDate"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="n.A." />
                            </Border>

                            <Border
                                Grid.Row="4"
                                Padding="8,6"
                                HorizontalAlignment="Left"
                                Style="{StaticResource Card.Inset}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="14"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE823;" />
                                    <TextBlock
                                        x:Name="txtLastPlayedTime"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>


                </Grid>
            </Border>
        </Grid>

        <!--  ===== Bottom Row: 3 cards =====  -->
        <Grid Grid.Row="4" MinHeight="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Games played  -->
            <Border
                Grid.Column="0"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE8FD;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Games Played" />
                    </StackPanel>

                    <!--  Recent game list  -->
                    <ListView
                        x:Name="ListViewRecentGames"
                        Grid.Row="1"
                        Margin="16,12,16,16"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        ItemContainerStyle="{StaticResource DashboardRecentGamesItemStyle}"
                        ItemsSource="{Binding T1Profis}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="12,8"
                                    Style="{StaticResource Card.Inset}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Height="46"
                                            Background="{DynamicResource Brush.Surface}"
                                            ClipToBounds="True"
                                            CornerRadius="{StaticResource DefaultCornerRadius}">
                                            <Image
                                                SnapsToDevicePixels="True"
                                                Source="{Binding COCOVIM}"
                                                Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding ItemObject.GANA}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                FontWeight="Normal"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                Text="{Binding ItemObject.LAPL, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="4"
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding COCPLTI}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <!--  Playtime overview  -->
            <Border
                Grid.Column="2"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE823;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Playtime Overview" />
                    </StackPanel>

                    <!--  2x2 stat grid  -->
                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Total playtime  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="16,12"
                            Style="{StaticResource Card.Inset}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE823;" />
                                    <TextBlock
                                        x:Name="txtTotalPlaytime"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Total Playtime" />
                            </StackPanel>
                        </Border>

                        <!--  Days played  -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            Padding="16,12"
                            Style="{StaticResource Card.Inset}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE787;" />
                                    <TextBlock
                                        x:Name="txtDaysPlayed"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Days Played" />
                            </StackPanel>
                        </Border>

                        <!--  Games played  -->
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Padding="16,12"
                            Style="{StaticResource Card.Inset}">
                            <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource Font.Icons}"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource Brush.Accent}"
                                        Text="&#xE7FC;" />
                                    <TextBlock
                                        x:Name="txtGamesPlayed"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="n.A." />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Games Played" />
                            </StackPanel>
                        </Border>

                        <!--  Achievements  -->

                    </Grid>
                </Grid>
            </Border>

            <!--  Overall statistics  -->
            <Border
                Grid.Column="4"
                Padding="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="16,16,16,0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="16"
                            FontWeight="Normal"
                            Foreground="{DynamicResource Brush.Accent}"
                            Text="&#xE9D9;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Overall Statistics" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="16,12"
                            Style="{StaticResource Card.Inset}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Played today" />
                                <TextBlock
                                    x:Name="txtStatPlayedToday"
                                    Margin="0,4,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="n.A." />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="2"
                            Padding="16,12"
                            Style="{StaticResource Card.Inset}">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Longest session" />
                                <TextBlock
                                    x:Name="txtStatLongestSession"
                                    Margin="0,4,0,0"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    Text="n.A." />
                                <TextBlock
                                    x:Name="txtStatLongestSessionGame"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="(n.A.)" />
                                <TextBlock
                                    x:Name="txtStatLongestSessionDate"
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    FontWeight="Normal"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="(n.A.)" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

</uix:UIXUserControlBase>
