<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.BigPicture.Views.BigPictureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <!--
        Only the list templates bind to their entries (pivots, covers, keys, filter and menu entries);
        everything else is set by BigPictureViewController on the named controls.
    -->
    <Grid Background="{StaticResource Brush.BigPicture.Background}" ClipToBounds="True">

        <!--  Window background of GameTimeNext with its accent glow, the blurred cover of the selected game on top  -->
        <Border Background="{DynamicResource GradientBrush.ProfileDetailView.Background}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource GradientBrush.ProfileDetailView.AccentGlowPrimary}" IsHitTestVisible="False" />

        <Image
            x:Name="imgBackdrop"
            Margin="-120"
            IsHitTestVisible="False"
            Opacity="0.4"
            Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect
                    KernelType="Gaussian"
                    Radius="90"
                    RenderingBias="Performance" />
            </Image.Effect>
        </Image>

        <!--  Key art: the cover of the selected game large on the right, faded into the background  -->
        <Grid IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" />
                <ColumnDefinition Width="11*" />
            </Grid.ColumnDefinitions>
            <Image
                x:Name="imgKeyArt"
                Grid.Column="1"
                OpacityMask="{StaticResource GradientBrush.BigPicture.KeyArtMask}"
                Opacity="0.7"
                Stretch="UniformToFill" />
        </Grid>

        <Border Background="{StaticResource GradientBrush.BigPicture.ShadeHorizontal}" IsHitTestVisible="False" />
        <Border Background="{StaticResource GradientBrush.BigPicture.ShadeVertical}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource GradientBrush.ProfileDetailView.Vignette}" IsHitTestVisible="False" />

        <!--  Content, laid out for 1080 px height and scaled to the screen  -->
        <Grid ui:ViewScale.DesignHeight="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Top bar: name and pivots on the left; filter, controller, clock and mouse buttons on the right  -->
            <Grid Grid.Row="0" Margin="64,22,64,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="36"
                        Height="36"
                        Source="/UI/Ressources/GTN_APP_ICON.ico" />
                    <TextBlock
                        x:Name="txApplicationName"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.BigPicture.Display}"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Style="{StaticResource BigPicture.Text}" />

                    <!--  Pivots in the tab bar look, switched with LB / RB  -->
                    <StackPanel
                        Margin="44,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ContentControl
                            Margin="0,0,12,0"
                            Content="LB"
                            Style="{StaticResource BigPicture.ControllerBumper}" />
                        <Border Style="{StaticResource BigPicture.PivotBar}">
                            <ItemsControl x:Name="itcPivots" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="btnPivot" Style="{StaticResource BigPicture.Pivot}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ContentControl
                            Margin="12,0,0,0"
                            Content="RB"
                            Style="{StaticResource BigPicture.ControllerBumper}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Playtime monitoring is running (started here or with the hotkey)  -->
                    <Border
                        x:Name="pnlMonitoringChip"
                        Margin="0,0,16,0"
                        Style="{StaticResource BigPicture.Chip}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource Brush.Danger}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="17"
                                Style="{StaticResource BigPicture.Text.Secondary}"
                                Text="Monitoring" />
                            <TextBlock
                                x:Name="txMonitoringChip"
                                MaxWidth="320"
                                Margin="8,0,0,0"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Style="{StaticResource BigPicture.Text}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="pnlFilterChip"
                        Margin="0,0,24,0"
                        Style="{StaticResource BigPicture.Chip}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                Style="{StaticResource BigPicture.Text.Icon}"
                                Text="&#xE71C;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                FontSize="17"
                                Style="{StaticResource BigPicture.Text}"
                                Text="Filtered" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="txControllerConnected"
                        Margin="0,0,24,0"
                        FontSize="26"
                        Style="{StaticResource BigPicture.Text.Icon}"
                        Text="&#xE7FC;"
                        ToolTip="Controller connected"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="txClock"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.BigPicture.Display}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Style="{StaticResource BigPicture.Text}" />

                    <Button
                        x:Name="btnSearch"
                        Margin="28,0,0,0"
                        Style="{StaticResource BigPicture.TopBarButton}"
                        ToolTip="Search">
                        <TextBlock
                            FontSize="18"
                            Style="{StaticResource BigPicture.Text.Icon}"
                            Text="&#xE721;" />
                    </Button>

                    <Button
                        x:Name="btnFilter"
                        Style="{StaticResource BigPicture.TopBarButton}"
                        ToolTip="Filter">
                        <TextBlock
                            FontSize="18"
                            Style="{StaticResource BigPicture.Text.Icon}"
                            Text="&#xE71C;" />
                    </Button>

                    <Button
                        x:Name="btnMenu"
                        Style="{StaticResource BigPicture.TopBarButton}"
                        ToolTip="Menu">
                        <TextBlock
                            FontSize="18"
                            Style="{StaticResource BigPicture.Text.Icon}"
                            Text="&#xE700;" />
                    </Button>

                    <Button
                        x:Name="btnExitBigPicture"
                        Style="{StaticResource BigPicture.TopBarButton}"
                        ToolTip="Exit Big Picture">
                        <TextBlock
                            FontSize="18"
                            Style="{StaticResource BigPicture.Text.Icon}"
                            Text="&#xE73F;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Row of covers of the current pivot; scrolled by the selection (BringIntoViewBehaviors), no scroll bar  -->
            <StackPanel x:Name="pnlRow" Grid.Row="1">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>

                <TextBlock
                    x:Name="txRowTitle"
                    Margin="64,16,64,0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Style="{StaticResource BigPicture.Text.Secondary}" />

                <ScrollViewer
                    x:Name="svGames"
                    CanContentScroll="False"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="itcGames" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!--  Room around the covers for the grown selected cover and its glow (the scroll viewer clips at its edges)  -->
                                <StackPanel Margin="64,26,64,30" Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <!--  The selected cover above its neighbours, so they don't cover its glow  -->
                            <Style TargetType="ContentPresenter">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Panel.ZIndex" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    x:Name="btnGame"
                                    ui:BringIntoViewBehaviors.Padding="420,30,420,30"
                                    ui:BringIntoViewBehaviors.Smooth="True"
                                    ui:BringIntoViewBehaviors.When="{Binding IsSelected}"
                                    Style="{StaticResource BigPicture.Cover}"
                                    ToolTip="{Binding Name}">
                                    <Grid>
                                        <!--  Without cover: the name on the tile  -->
                                        <TextBlock
                                            Margin="14"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BigPicture.Text}"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        <Border Style="{StaticResource BigPicture.RunningBadge}">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BigPicture.Text}"
                                                Text="Playing" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!--  The selected game large, or the keyboard of the search  -->
            <Grid
                x:Name="pnlContent"
                Grid.Row="2"
                Margin="64,6,64,0">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>

                <StackPanel
                    x:Name="pnlDetails"
                    MaxWidth="1180"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">

                    <TextBlock x:Name="txTitle" Style="{StaticResource BigPicture.Text.Title}" />

                    <TextBlock
                        x:Name="txSubtitle"
                        Margin="2,10,0,0"
                        FontSize="24"
                        Style="{StaticResource BigPicture.Text.Secondary}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Times  -->
                    <StackPanel Margin="2,26,0,0" Orientation="Horizontal">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigPicture.Text.StatCaption}" Text="Total playtime" />
                            <TextBlock x:Name="txTotalPlaytime" Style="{StaticResource BigPicture.Text.StatValue}" />
                        </StackPanel>

                        <Border Style="{StaticResource BigPicture.StatDivider}" />

                        <StackPanel>
                            <TextBlock Style="{StaticResource BigPicture.Text.StatCaption}" Text="Last session" />
                            <TextBlock x:Name="txLastSession" Style="{StaticResource BigPicture.Text.StatValue}" />
                        </StackPanel>

                        <Border Style="{StaticResource BigPicture.StatDivider}" />

                        <StackPanel>
                            <TextBlock Style="{StaticResource BigPicture.Text.StatCaption}" Text="Played today" />
                            <TextBlock x:Name="txPlayedToday" Style="{StaticResource BigPicture.Text.StatValue}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Current playthrough (not the initial one) and its progress  -->
                    <Border
                        x:Name="pnlPlaythrough"
                        Width="620"
                        Margin="0,24,0,0"
                        Padding="24,12,24,14"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BigPicture.Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource BigPicture.Text.StatCaption}" Text="Current playthrough" />
                                <TextBlock
                                    x:Name="txPlaythroughTime"
                                    HorizontalAlignment="Right"
                                    FontSize="18"
                                    Style="{StaticResource BigPicture.Text.Secondary}" />
                            </Grid>
                            <TextBlock
                                x:Name="txPlaythrough"
                                Margin="0,4,0,0"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Style="{StaticResource BigPicture.Text}"
                                TextTrimming="CharacterEllipsis" />

                            <Grid x:Name="pnlProgress" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Height="8"
                                    VerticalAlignment="Center">
                                    <Border Background="{StaticResource Brush.Card.Inset}" CornerRadius="4" />
                                    <Border
                                        x:Name="pnlProgressFill"
                                        Background="{DynamicResource Brush.Accent}"
                                        CornerRadius="4"
                                        RenderTransformOrigin="0,0.5" />
                                </Grid>
                                <TextBlock
                                    x:Name="txProgress"
                                    Grid.Column="1"
                                    Margin="16,0,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Style="{StaticResource BigPicture.Text}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Play / quit and why the game can't be started  -->
                    <StackPanel Margin="0,28,0,0" Orientation="Horizontal">
                        <Button x:Name="btnPlay" Style="{StaticResource BigPicture.PlayButton}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl
                                    Background="{StaticResource Brush.BigPicture.ButtonA}"
                                    Content="A"
                                    Style="{StaticResource BigPicture.ControllerButton}" />
                                <TextBlock
                                    x:Name="txPlayGlyph"
                                    Margin="16,0,0,0"
                                    FontSize="22"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Style="{StaticResource BigPicture.Text.Icon}" />
                                <TextBlock
                                    x:Name="txPlay"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="25"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    Style="{StaticResource BigPicture.Text}" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            x:Name="txStatus"
                            MaxWidth="760"
                            Margin="26,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Style="{StaticResource BigPicture.Text.Secondary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!--  Search: field and on-screen keyboard while they have the input  -->
                <StackPanel
                    x:Name="pnlKeyboard"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="txbSearch"
                        Width="870"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BigPicture.SearchBox}" />

                    <ItemsControl
                        x:Name="itcKeys"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Width" Value="{Binding Width}" />
                                <Setter Property="Height" Value="{Binding Height}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button x:Name="btnKey" Style="{StaticResource BigPicture.Key}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,10,0"
                                            FontSize="20"
                                            Style="{StaticResource BigPicture.Text.Icon}"
                                            Text="{Binding Glyph}"
                                            Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Style="{StaticResource BigPicture.Text}"
                                            Text="{Binding Text}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Nothing to show (empty library or nothing left by the filter)  -->
                <StackPanel
                    x:Name="pnlEmpty"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="txEmptyTitle"
                        FontFamily="{StaticResource Font.BigPicture.Display}"
                        FontSize="48"
                        FontWeight="Bold"
                        Style="{StaticResource BigPicture.Text}" />
                    <TextBlock
                        x:Name="txEmptyHint"
                        Margin="2,10,0,0"
                        FontSize="24"
                        Style="{StaticResource BigPicture.Text.Secondary}" />
                </StackPanel>
            </Grid>

            <!--  Hints: what the controller buttons do right now (hidden while they do nothing)  -->
            <StackPanel
                Grid.Row="3"
                Height="52"
                Margin="64,0,64,20"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <StackPanel x:Name="pnlHintView" Orientation="Horizontal">
                    <ContentControl Content="VIEW" Style="{StaticResource BigPicture.ControllerBumper}" />
                    <TextBlock x:Name="txHintView" Style="{StaticResource BigPicture.HintText}" />
                </StackPanel>

                <StackPanel x:Name="pnlHintY" Orientation="Horizontal">
                    <ContentControl
                        Background="{StaticResource Brush.BigPicture.ButtonY}"
                        Content="Y"
                        Style="{StaticResource BigPicture.ControllerButton}" />
                    <TextBlock x:Name="txHintY" Style="{StaticResource BigPicture.HintText}" />
                </StackPanel>

                <StackPanel x:Name="pnlHintX" Orientation="Horizontal">
                    <ContentControl
                        Background="{StaticResource Brush.BigPicture.ButtonX}"
                        Content="X"
                        Style="{StaticResource BigPicture.ControllerButton}" />
                    <TextBlock x:Name="txHintX" Style="{StaticResource BigPicture.HintText}" />
                </StackPanel>

                <StackPanel x:Name="pnlHintA" Orientation="Horizontal">
                    <ContentControl
                        Background="{StaticResource Brush.BigPicture.ButtonA}"
                        Content="A"
                        Style="{StaticResource BigPicture.ControllerButton}" />
                    <TextBlock x:Name="txHintA" Style="{StaticResource BigPicture.HintText}" />
                </StackPanel>

                <StackPanel x:Name="pnlHintB" Orientation="Horizontal">
                    <ContentControl
                        Background="{StaticResource Brush.BigPicture.ButtonB}"
                        Content="B"
                        Style="{StaticResource BigPicture.ControllerButton}" />
                    <TextBlock
                        x:Name="txHintB"
                        Margin="10,0,0,0"
                        Style="{StaticResource BigPicture.HintText}" />
                </StackPanel>
            </StackPanel>

            <!--  Filter: drawer on the right with the switches of the library filter  -->
            <Grid
                x:Name="grdFilter"
                Grid.Row="0"
                Grid.RowSpan="4"
                Panel.ZIndex="1050"
                Background="{StaticResource Brush.BigPicture.DialogBackdrop}"
                Visibility="Collapsed">
                <Border
                    Width="640"
                    Padding="36,32,36,0"
                    HorizontalAlignment="Right"
                    Background="{StaticResource Brush.BigPicture.Dialog}"
                    BorderBrush="{StaticResource Brush.Card.Border}"
                    BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock
                                FontSize="30"
                                Style="{StaticResource BigPicture.Text.Icon}"
                                Text="&#xE71C;" />
                            <TextBlock
                                Margin="16,0,0,0"
                                FontFamily="{StaticResource Font.BigPicture.Display}"
                                FontSize="34"
                                FontWeight="SemiBold"
                                Style="{StaticResource BigPicture.Text}"
                                Text="Filter" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Hidden">
                            <ItemsControl
                                x:Name="itcFilter"
                                Margin="0,0,0,40"
                                Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Style="{StaticResource BigPicture.FilterHeader}" Text="{Binding Text}" />

                                            <Button
                                                x:Name="btnFilterEntry"
                                                ui:BringIntoViewBehaviors.Padding="0,80,0,80"
                                                ui:BringIntoViewBehaviors.Smooth="True"
                                                ui:BringIntoViewBehaviors.When="{Binding IsSelected}"
                                                Style="{StaticResource BigPicture.FilterEntry}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource BigPicture.FilterCheck}" />
                                                    <TextBlock
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="24"
                                                        Style="{StaticResource BigPicture.Text}"
                                                        Text="{Binding Text}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!--  Launching / quitting a game: the card of the profiles view  -->
            <ContentControl
                x:Name="ccLaunchOverlay"
                Grid.Row="0"
                Grid.RowSpan="4"
                Style="{StaticResource GameStartOverlayHostStyle}" />

            <!--  Menu, questions and the message boxes of the application (CFMBOX)  -->
            <Grid
                x:Name="grdMenu"
                Grid.Row="0"
                Grid.RowSpan="4"
                Panel.ZIndex="1100"
                Background="{StaticResource Brush.BigPicture.DialogBackdrop}"
                Visibility="Collapsed">
                <Border
                    Width="680"
                    Padding="36,32,36,26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource Brush.BigPicture.Dialog}"
                    BorderBrush="{StaticResource Brush.Card.Border}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="txMenuIcon"
                                Margin="0,0,16,0"
                                FontSize="32"
                                Style="{StaticResource BigPicture.Text.Icon}" />
                            <TextBlock
                                x:Name="txMenuTitle"
                                MaxWidth="560"
                                FontFamily="{StaticResource Font.BigPicture.Display}"
                                FontSize="34"
                                FontWeight="SemiBold"
                                Style="{StaticResource BigPicture.Text}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <ScrollViewer
                            x:Name="svMenuMessage"
                            MaxHeight="440"
                            Margin="0,14,0,0"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="txMenuMessage"
                                Style="{StaticResource BigPicture.Text.Secondary}"
                                TextWrapping="Wrap" />
                        </ScrollViewer>

                        <ItemsControl
                            x:Name="itcMenuOptions"
                            Margin="0,26,0,0"
                            Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="btnMenuOption" Style="{StaticResource BigPicture.MenuOption}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Width="40"
                                                FontSize="24"
                                                Style="{StaticResource BigPicture.Text.Icon}"
                                                Text="{Binding Glyph}" />
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="26"
                                                Style="{StaticResource BigPicture.Text}"
                                                Text="{Binding Text}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!--  Opening animation over everything; any button skips it  -->
        <ui:CFParticleIntro
            x:Name="ptcIntro"
            Panel.ZIndex="2000"
            Logo="/UI/Ressources/GTN_APP_ICON.ico"
            Subtitle="BIG PICTURE" />
    </Grid>
</uix:UIXUserControlBase>
