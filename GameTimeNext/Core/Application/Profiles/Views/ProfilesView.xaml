<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="Transparent">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="73*" />
            <ColumnDefinition Width="2" />
            <!--  Grows with the window (bigger cover on large screens), the detail view adapts its header to the height  -->
            <ColumnDefinition
                Width="27*"
                MinWidth="300"
                MaxWidth="460" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Column="0"
            Padding="0"
            Background="Transparent">
            <!--  Frosted glass behind the monitoring overlay  -->
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=MonitoringOverlay}" Value="Visible">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect KernelType="Gaussian" Radius="12" RenderingBias="Performance" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Toolbar: narrowing the list (search, filter) on the left, actions (refresh, add) on the right  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,16,12"
                    Padding="16"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="tbSearchProfileName"
                            Grid.Column="0"
                            Width="320"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBox.Default}"
                            Tag="Search for name"
                            ToolTip="Search for name" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button
                                x:Name="BtnFilter"
                                VerticalAlignment="Center"
                                Style="{StaticResource Button.Icon}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Text="" />
                            </Button>

                            <Popup
                                x:Name="PopFilter"
                                AllowsTransparency="True"
                                Placement="Right"
                                PlacementTarget="{Binding ElementName=BtnFilter}"
                                StaysOpen="True">
                                <Border
                                    Padding="12"
                                    Style="{StaticResource ModernPopupCardStyle}">
                                    <ContentPresenter x:Name="CPFilter" />
                                </Border>
                            </Popup>
                        </Grid>

                        <Button
                            x:Name="BtnRefresh"
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            ToolTip="Refresh profiles"
                            Style="{StaticResource Button.Icon}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE72C;" />
                        </Button>

                        <Button
                            x:Name="BtnAddProfile"
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            ToolTip="Add profile"
                            Style="{StaticResource Button.Icon}">
                            <Image
                                Width="16"
                                Height="16"
                                Source="/UI/Ressources/GTN_ICON_ADD_PROFILE.png"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <ListBox
                    x:Name="ListBoxProfiles"
                    ui:ScrollFade.Length="80"
                    ui:TileLayout.AutoSize="True"
                    Grid.Row="1"
                    Margin="-12,12,0,0"
                    Padding="0"
                    ClipToBounds="True"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding T1Profis}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedT1Profi, Mode=TwoWay}"
                    SelectionMode="Single">

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  Spacing on the panel, not as ListBox padding: it has to scroll with the tiles instead of shrinking the viewport  -->
                            <WrapPanel Margin="0,-18,0,26" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource TileListBoxItemStyle}" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="{StaticResource TileItemMargin}" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Style="{StaticResource ModernContextMenuStyle}">
                                        <MenuItem
                                            x:Name="ctxtEdit"
                                            Header="Edit"
                                            Style="{StaticResource ModernContextMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Text="" />
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator Style="{StaticResource ModernContextMenuSeparatorStyle}" />

                                        <MenuItem
                                            x:Name="ctxtDelete"
                                            Header="Delete"
                                            Style="{StaticResource ModernContextMenuItemStyle}">
                                            <MenuItem.Icon>
                                                <TextBlock
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Text="" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <ContentControl
            x:Name="MonitoringOverlay"
            Grid.Column="0"
            Style="{StaticResource MonitoringOverlayHostStyle}"
            Visibility="Collapsed" />

        <ContentControl
            x:Name="LaunchingOverlay"
            Grid.Column="0"
            Style="{StaticResource GameStartOverlayHostStyle}"
            Visibility="Collapsed" />

        <Border
            Grid.Column="2"
            Padding="0"
            Background="Transparent">
            <ContentPresenter x:Name="CPProfileDetailView" />
        </Border>
    </Grid>
</uix:UIXUserControlBase>