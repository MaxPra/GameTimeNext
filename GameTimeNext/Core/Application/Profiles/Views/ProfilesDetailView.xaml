<uixcontrols:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uixcontrols="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    d:DesignHeight="1000"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid Style="{StaticResource ProfileDetail.Root}">

        <!--  Blurred cover as atmosphere behind the header  -->
        <Image Source="{Binding Source, ElementName=imgProfileCover}" Style="{StaticResource ProfileDetail.Backdrop}" />

        <DockPanel Margin="{StaticResource ProfileDetail.SideMargin}">

            <!--  Actions: pinned, always reachable  -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource ProfileDetail.ActionBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="btnLaunchGame"
                        Grid.Column="0"
                        Content="Launch game"
                        Style="{StaticResource Button.Secondary}" />

                    <Button
                        x:Name="btnStartMonitoring"
                        Grid.Column="2"
                        Content="Start monitoring" />
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="svDetail"
                Focusable="False"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!--  ===== Header: cover | title + total playtime =====  -->
                    <Grid Style="{StaticResource ProfileDetail.Header}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Sized in code-behind (follows the panel width)  -->
                        <Border x:Name="bdCoverFrame" Style="{StaticResource ProfileDetail.CoverFrame}">
                            <Image x:Name="imgProfileCover" Style="{StaticResource ProfileDetail.CoverImage}" />
                        </Border>

                        <StackPanel Grid.Column="1" Style="{StaticResource ProfileDetail.HeaderText}">
                            <!--  Average of the rated playthroughs, hidden while none is rated  -->
                            <StackPanel x:Name="pnlRating" Style="{StaticResource ProfileDetail.Rating}">
                                <fui:StarRating x:Name="rtgProfileRating" Style="{StaticResource StarRating.Small}" />
                                <TextBlock x:Name="txProfileRating" Style="{StaticResource ProfileDetail.RatingValue}" />
                            </StackPanel>
                            <TextBlock uixprops:UIXAttachedProperty.Path="T1PROFI.GANA" Style="{StaticResource ProfileDetail.Title}" />
                            <TextBlock Style="{StaticResource Card.Caption}" Text="Total playtime" />
                            <TextBlock x:Name="txTotalGameTime" Style="{StaticResource ProfileDetail.HeroValue}" />
                        </StackPanel>
                    </Grid>

                    <!--  ===== Activity =====  -->
                    <GroupBox
                        Padding="{StaticResource Card.RowsPadding}"
                        Header="Activity"
                        Style="{StaticResource GroupBox.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Card.FirstRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Card.RowLabel}" Text="Today" />
                                    <TextBlock
                                        x:Name="txPlayedToday"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Card.RowLabel}" Text="Last session" />
                                    <TextBlock
                                        x:Name="txLastSession"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Card.RowLabel}" Text="First played" />
                                    <TextBlock
                                        x:Name="txFirstTimePlayed"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Card.RowLabel}" Text="Last played" />
                                    <TextBlock
                                        x:Name="txLastTimePlayed"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!--  ===== Current playthrough =====  -->
                    <GroupBox
                        x:Name="pnlPlaythrough"
                        Padding="{StaticResource Card.RowsPadding}"
                        Header="Current playthrough"
                        Style="{StaticResource GroupBox.Card}">
                        <Border Style="{StaticResource Card.FirstRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="txPlaythrough" Style="{StaticResource ProfileDetail.PlaythroughName}" />
                                <TextBlock
                                    x:Name="txPlaythroughTime"
                                    Grid.Column="1"
                                    Style="{StaticResource ProfileDetail.PlaythroughTime}" />
                            </Grid>
                        </Border>
                    </GroupBox>

                    <!--  ===== Estimated playtime =====  -->
                    <GroupBox
                        x:Name="pnlProgressSection"
                        Padding="{StaticResource Card.RowsPadding}"
                        Header="Estimated playtime"
                        Style="{StaticResource GroupBox.Card}">
                        <StackPanel>
                            <Border Style="{StaticResource Card.FirstRow}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Card.RowLabel}" Text="Progress" />
                                        <TextBlock
                                            x:Name="txtProgress"
                                            Grid.Column="1"
                                            Style="{StaticResource Card.RowValue}"
                                            Text="0%" />
                                    </Grid>

                                    <Grid>
                                        <Border Style="{StaticResource ProfileDetail.ProgressTrack}" />
                                        <Border x:Name="pnlProgress" Style="{StaticResource ProfileDetail.ProgressFill}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="lblEstMain"
                                        Style="{StaticResource Card.RowLabel}"
                                        Text="Story" />
                                    <TextBlock
                                        x:Name="txEstMain"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="lblEstExtra"
                                        Style="{StaticResource Card.RowLabel}"
                                        Text="Story + Extras" />
                                    <TextBlock
                                        x:Name="txEstExtra"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card.Row}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="lblEstCompletionist"
                                        Style="{StaticResource Card.RowLabel}"
                                        Text="Completionist" />
                                    <TextBlock
                                        x:Name="txEstCompletionist"
                                        Grid.Column="1"
                                        Style="{StaticResource Card.RowValue}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Border Style="{StaticResource ProfileDetail.Edge}" />
    </Grid>
</uixcontrols:UIXUserControlBase>
