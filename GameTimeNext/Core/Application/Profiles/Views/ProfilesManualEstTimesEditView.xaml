<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesManualEstTimesEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    Title="Estimated Times"
    Width="760"
    Height="500"
    MinWidth="760"
    MinHeight="500"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border
                VerticalAlignment="Top"
                Padding="16"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Estimated Times" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Main Story (h)" />

                    <TextBox
                        x:Name="txbEstTimeMain"
                        Grid.Row="2"
                        Grid.Column="2"
                        Height="36"
                        ToolTip="Estimated time for the main story" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Main Story + Extras (h)" />

                    <TextBox
                        x:Name="txbEstTimeMainExtra"
                        Grid.Row="4"
                        Grid.Column="2"
                        Height="36"
                        ToolTip="Estimated time for the main story and extra content" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Text.Label}"
                        Text="Completionist (h)" />

                    <TextBox
                        x:Name="txbEstTimeCompletionist"
                        Grid.Row="6"
                        Grid.Column="2"
                        Height="36"
                        ToolTip="Estimated time for a completionist playthrough" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnOpenHowLongToBeat"
                Grid.Column="1"
                Width="180"
                Height="36"
                Content="Open HowLongToBeat" />

            <Button
                x:Name="btnCancel"
                Grid.Column="3"
                Width="110"
                Height="36"
                Content="Cancel" />

            <Button
                x:Name="btnApply"
                Grid.Column="5"
                Width="140"
                Height="36"
                Content="Apply"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
