<uixcontrols:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesFilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixcontrols="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    MinWidth="600">

    <uixcontrols:UIXUserControlBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FilterGroupHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style
            x:Key="FilterGroupBorder"
            BasedOn="{StaticResource Card.Inset}"
            TargetType="Border">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!--  Checkbox list for tags and fixed options  -->
        <DataTemplate x:Key="FilterItemTemplate">
            <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <CheckBox
                    x:Name="Cb"
                    Content="{Binding Name}"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    Style="{StaticResource CheckBox.ListItem}"
                    ToolTip="{Binding ToolTip}" />

                <!--  Separates special entries from the real tags  -->
                <Border
                    Height="1"
                    Margin="10,4,10,4"
                    Background="{DynamicResource Brush.Border}"
                    Visibility="{Binding IsSpecial, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                    <Setter TargetName="Cb" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Cb" Property="Opacity" Value="0.8" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </uixcontrols:UIXUserControlBase.Resources>

    <!--  Shown inside the filter popup (ModernPopupCardStyle), which provides surface and padding  -->
    <Border Padding="4" Background="Transparent">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Text="Library filters" />

            <TextBlock
                Grid.Row="1"
                Margin="0,0,0,16"
                Foreground="{DynamicResource Brush.TextSecondary}"
                Text="Checked entries are shown. Uncheck what you want to hide."
                TextWrapping="Wrap" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!--  Tags  -->
                <!--  Height follows the options column, so the tag list fills the whole box  -->
                <DockPanel
                    Grid.Column="0"
                    Height="{Binding ActualHeight, ElementName=SpOptions}"
                    Margin="0,0,18,0"
                    VerticalAlignment="Top">
                    <TextBlock
                        DockPanel.Dock="Top"
                        Style="{StaticResource FilterGroupHeader}"
                        Text="Tags" />

                    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="TxtSearchTag"
                            Grid.Column="0"
                            Margin="0,0,8,0"
                            Style="{StaticResource TextBox.Default}"
                            Tag="Search tags"
                            ToolTip="Search tags" />

                        <Button
                            x:Name="BtnSelectAllTags"
                            Grid.Column="1"
                            Margin="0,0,6,0"
                            Padding="10,0"
                            Content="All"
                            ToolTip="Check all (visible) tags" />

                        <Button
                            x:Name="BtnSelectNoTags"
                            Grid.Column="2"
                            Padding="10,0"
                            Content="None"
                            ToolTip="Uncheck all (visible) tags" />
                    </Grid>

                    <Border Style="{StaticResource FilterGroupBorder}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding Tags}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!--  Fixed options  -->
                <StackPanel x:Name="SpOptions" Grid.Column="1">
                    <TextBlock Style="{StaticResource FilterGroupHeader}" Text="Progress" />
                    <Border Style="{StaticResource FilterGroupBorder}">
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding Progress}" />
                    </Border>

                    <TextBlock Style="{StaticResource FilterGroupHeader}" Text="Availability" />
                    <Border Style="{StaticResource FilterGroupBorder}">
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding Availability}" />
                    </Border>

                    <TextBlock Style="{StaticResource FilterGroupHeader}" Text="Source" />
                    <Border Style="{StaticResource FilterGroupBorder}">
                        <ItemsControl ItemTemplate="{StaticResource FilterItemTemplate}" ItemsSource="{Binding Source}" />
                    </Border>

                    <TextBlock Style="{StaticResource FilterGroupHeader}" Text="Options" />
                    <Border Padding="10" Style="{StaticResource FilterGroupBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="Show archived" />
                            <CheckBox
                                Grid.Row="0"
                                Grid.Column="1"
                                IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                                Style="{StaticResource CheckBox.Switch}"
                                ToolTip="Also shows archived games" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                Text="Recently played only" />
                            <CheckBox
                                Grid.Row="2"
                                Grid.Column="1"
                                IsChecked="{Binding OnlyRecentlyPlayed, Mode=TwoWay}"
                                Style="{StaticResource CheckBox.Switch}"
                                ToolTip="Only shows games played within the last 14 days" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,4,0,0">
                <Button
                    x:Name="BtnReset"
                    Padding="14,0"
                    HorizontalAlignment="Left"
                    Content="Reset"
                    ToolTip="Show the whole library again" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="BtnCancel"
                        Width="90"
                        Margin="0,0,10,0"
                        Content="Cancel" />

                    <Button
                        x:Name="BtnApply"
                        Width="90"
                        Content="Apply"
                        Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</uixcontrols:UIXUserControlBase>
