<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesLauncherImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Title="Launcher import"
    Width="800"
    Height="750"
    MinWidth="720"
    MinHeight="420"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource Text.Label}"
            Text="Search" />

        <TextBox
            x:Name="txbSearch"
            Grid.Row="2"
            Height="36"
            VerticalContentAlignment="Center"
            ToolTip="Type to filter the list" />

        <uixsel:UIXDataGrid
            x:Name="dgGames"
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserResizeRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <uixsel:UIXDataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding COGANAM}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding COLNTY}"
                    Header="Launcher" />
            </uixsel:UIXDataGrid.Columns>
        </uixsel:UIXDataGrid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnCancel"
                Grid.Column="1"
                Width="110"
                Height="36"
                Content="Cancel"
                IsCancel="True" />

            <Button
                x:Name="btnImport"
                Grid.Column="3"
                Width="140"
                Height="36"
                Content="Import"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
