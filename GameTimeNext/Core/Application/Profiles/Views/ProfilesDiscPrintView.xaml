<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesDiscPrintView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gtnui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    Title="Disc image"
    Width="520"
    Height="660"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="brdWorkspace"
            Grid.Row="0"
            Padding="16"
            Style="{StaticResource Card}">
            <Grid
                Width="384"
                Height="384"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!--  Same disc as in GameCase (drawn at 224), turned like the selected disc in the library  -->
                <Viewbox IsHitTestVisible="False" Stretch="Fill">
                    <Grid
                        Width="224"
                        Height="224"
                        OpacityMask="{StaticResource Brush.Case.DiscHoleMask}">
                        <Ellipse x:Name="elpPrint" gtnui:DiscPrint.PrintAngle="90" />
                        <Ellipse Fill="{StaticResource Brush.Case.Disc}" />

                        <!--  Lies under the opened front cover of the selected case (up to 0.30 radii right of the center, see DiscPrint)  -->
                        <Ellipse>
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="#80000000" />
                                    <GradientStop Offset="0.65" Color="#80000000" />
                                    <GradientStop Offset="0.65" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse Stroke="{DynamicResource Brush.Card.Border}" StrokeThickness="3" />
                        <Ellipse
                            Opacity="0.6"
                            Stroke="{DynamicResource Brush.Accent}"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="88"
                            Height="88"
                            Fill="{StaticResource Brush.Case.Hub}"
                            Stroke="{DynamicResource Brush.Card.Border}"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="62"
                            Height="62"
                            Stroke="#14FFFFFF"
                            StrokeThickness="1" />
                        <Ellipse
                            Width="34"
                            Height="34"
                            Stroke="#33FFFFFF"
                            StrokeThickness="2" />
                    </Grid>
                </Viewbox>

                <Thumb
                    x:Name="thbMove"
                    Cursor="SizeAll"
                    Focusable="False">
                    <Thumb.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Ellipse Fill="Transparent" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{StaticResource Text.Label}"
                Text="Zoom" />

            <Slider
                x:Name="sldZoom"
                Grid.Column="2"
                VerticalAlignment="Center"
                IsMoveToPointEnabled="True"
                LargeChange="0.25"
                Maximum="2.5"
                Minimum="1"
                SmallChange="0.1" />
        </Grid>

        <TextBlock
            Grid.Row="4"
            Style="{StaticResource Text.Hint}"
            Text="Drag the disc to move the image. The darkened part lies under the open case in the library."
            TextWrapping="Wrap" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnAutomatic"
                Grid.Column="0"
                Width="110"
                Height="36"
                Content="Automatic"
                ToolTip="Go back to the automatically chosen position" />

            <Button
                x:Name="btnCancel"
                Grid.Column="2"
                Width="110"
                Height="36"
                Content="Cancel" />

            <Button
                x:Name="btnApply"
                Grid.Column="4"
                Width="110"
                Height="36"
                Content="Apply"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
