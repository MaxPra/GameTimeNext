
<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Profile"
    Width="980"
    Height="700"
    MinWidth="980"
    MinHeight="750"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="tabControl" Grid.Row="0">
            <TabItem Header="General">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Profile" />

                                    <TextBox
                                        x:Name="txbProfileName"
                                        Grid.Row="2"
                                        Height="36"
                                        uixprops:UIXAttachedProperty.Path="T1PROFI.GANA"
                                        ToolTip="Name shown in the profile list" />

                                    <TextBlock
                                        Grid.Row="4"
                                        Opacity="0.8"
                                        Text="Target play style" />

                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox
                                            x:Name="cmbEstimatedTimeType"
                                            Grid.Column="0"
                                            Height="36"
                                            SelectedIndex="0"
                                            ToolTip="Select the target play style" />

                                        <Button
                                            x:Name="btnManualEstTimes"
                                            Grid.Column="2"
                                            Height="36"
                                            Content="Enter manual"
                                            ToolTip="Open the window to manually enter estimated times" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="8"
                                        Opacity="0.8"
                                        Text="Game folder (where the .exe is)" />

                                    <Grid Grid.Row="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="txbGameFolder"
                                            Grid.Column="0"
                                            Height="36"
                                            uixprops:UIXAttachedProperty.Path="T1PROFI.EXGF"
                                            IsReadOnly="True"
                                            ToolTip="Folder that contains the game executable" />

                                        <Button
                                            x:Name="btnBrowseGameFolder"
                                            Grid.Column="2"
                                            Height="36"
                                            Content="Browse…"
                                            ToolTip="Select game folder" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="12"
                                        Opacity="0.8"
                                        Text="Platform" />

                                    <Grid Grid.Row="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox
                                            x:Name="cmbPlatform"
                                            Grid.Column="0"
                                            Height="36"
                                            uixprops:UIXAttachedProperty.AdditionalEntry="(None)"
                                            uixprops:UIXAttachedProperty.Path="T1PROFI.PLAFO"
                                            uixprops:UIXAttachedProperty.Source="From=T1CTABD;Where=TXTYP:pF;Text=DESCR;Value=TXNUM"
                                            SelectedIndex="0"
                                            SelectedValue=""
                                            SelectedValuePath="Tag" />

                                        <Button
                                            x:Name="btnAddPlatformWizard"
                                            Grid.Column="2"
                                            ToolTip="Add Platform through wizard"
                                            Style="{StaticResource Button.Icon}">
                                            <Viewbox
                                                Width="18"
                                                Height="18"
                                                Stretch="Uniform">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Segoe UI Emoji"
                                                    FontSize="16"
                                                    Text="🧙" />
                                            </Viewbox>
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox
                                            x:Name="cbOverrideGlobalBlackout"
                                            Grid.Column="0"
                                            Content="override global blackout" />

                                        <CheckBox
                                            x:Name="cbBlackoutSideMonitors"
                                            Grid.Column="2"
                                            Content="blackout side monitors" />
                                    </Grid>
                                </Grid>
                            </Border>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Launcher">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                        <Button
                            x:Name="btnLinkFile"
                            Width="140"
                            Height="34"
                            Content="Link file…"
                            ToolTip="Start the game with an executable, a shortcut or a URI" />

                        <Button
                            x:Name="btnLauncherImport"
                            Width="140"
                            Height="34"
                            Margin="10,0,0,0"
                            Content="Launcher import"
                            ToolTip="Import an installed game from a launcher" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                x:Name="pnlLauncherLinkState"
                                Grid.Row="0"
                                Padding="12,10"
                                Visibility="Visible"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Text="🔗" />

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <TextBlock
                                            x:Name="txtLauncherLinkStatus"
                                            FontWeight="SemiBold"
                                            Text="Linked with launcher" />

                                        <TextBlock
                                            x:Name="txtLauncherGameId"
                                            Margin="0,2,0,0"
                                            Opacity="0.8"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        x:Name="btnUnlinkLauncher"
                                        Grid.Column="4"
                                        Width="110"
                                        Height="30"
                                        VerticalAlignment="Center"
                                        Content="Remove link"
                                        ToolTip="Remove the launcher link from this profile" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="pnlLauncherSettings"
                                Grid.Row="2"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Launch settings" />

                                    <CheckBox
                                        x:Name="cbEnableHdrOnStart"
                                        Grid.Row="2"
                                        Content="Enable HDR on game start" />

                                    <CheckBox
                                        x:Name="cbPauseInBigPicture"
                                        Grid.Row="4"
                                        Content="Pause the game while the Big Picture mode is in front"
                                        ToolTip="The game doesn't react to the controller while you use the Big Picture mode. Switch it off for online games or games with anti-cheat." />

                                    <Grid x:Name="grdLaunchArgs" Grid.Row="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Opacity="0.8"
                                            Text="Launch arguments" />

                                        <TextBox
                                            x:Name="txbLaunchArgs"
                                            Grid.Row="2"
                                            Height="36"
                                            ToolTip="Additional launch arguments (e.g. -novid -fullscreen)" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Tags">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border
                            x:Name="pnlGroups"
                            Padding="16"
                            Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="Tags" />

                                <ItemsControl Grid.Row="2" ItemsSource="{Binding T1GROUPs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Margin="0,0,0,6"
                                                Content="{Binding ItemObject.GRNA}"
                                                IsChecked="{Binding COISSEL, Mode=TwoWay}"
                                                Style="{StaticResource CheckBox.Left}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Image">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Cover" />

                                    <TextBox
                                        x:Name="txbImagePath"
                                        Grid.Row="2"
                                        Height="36"
                                        uixprops:UIXAttachedProperty.Path="T1PROFI.PPFN"
                                        IsReadOnly="True"
                                        ToolTip="Local path or path set after selecting an image" />

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="btnBrowseLocalImage"
                                            Grid.Column="0"
                                            Height="36"
                                            Content="Browse local…"
                                            ToolTip="Select a local image file" />

                                        <Button
                                            x:Name="btnSteamGridDb"
                                            Grid.Column="2"
                                            Height="36"
                                            Content="SteamGridDB…"
                                            ToolTip="Open SteamGridDB picker window" />

                                        <Button
                                            x:Name="btnUsePlaceholderCover"
                                            Grid.Column="4"
                                            Height="36"
                                            Content="Placeholder"
                                            ToolTip="Use the GameTimeNext placeholder cover" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="6"
                                        Opacity="0.65"
                                        Text="Use “Browse local…”, “SteamGridDB…” or “Placeholder” to set the image path." />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Padding="16"
                                Style="{StaticResource Card}">
                                <Grid x:Name="grdAccentColorSettings">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="Appearance" />

                                    <CheckBox
                                        x:Name="cbUseProfileAccentColors"
                                        Grid.Row="2"
                                        uixprops:UIXAttachedProperty.Path="T1PROFI.ACAC"
                                        Content="Change accent colors based on this profile"
                                        ToolTip="If enabled, the application's accent colors can switch when this profile is selected/active." />

                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Opacity="0.8"
                                            Text="Accent colors" />

                                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                                            <ToggleButton x:Name="tglAccent1" Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />

                                            <ToggleButton x:Name="tglAccent2" Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />

                                            <ToggleButton
                                                x:Name="tglAccent3"
                                                Margin="0"
                                                Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnCancel"
                Grid.Column="1"
                Width="110"
                Height="36"
                Content="Cancel" />

            <Button
                x:Name="btnSave"
                Grid.Column="3"
                Width="140"
                Height="36"
                Content="Save" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
