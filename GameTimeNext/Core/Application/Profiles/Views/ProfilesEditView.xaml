
<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.Profiles.Views.ProfilesEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixcb="clr-namespace:UIX.ViewController.Engine.FrameworkElements.ComboBoxes;assembly=UIX.ViewController.Engine"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:gtnui="clr-namespace:GameTimeNext.Core.Framework.UI"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Profiles.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Profile"
    Width="1080"
    Height="780"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Cover: always visible, its buttons change it; top aligned with the first section header of the tabs  -->
            <StackPanel Grid.Column="0" Margin="0,64,0,0">
                <Border
                    x:Name="brdCover"
                    Width="220"
                    Height="330"
                    Background="{StaticResource Brush.Card.Inset}"
                    BorderBrush="{StaticResource Brush.Card.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Card.CornerRadius}">
                    <Grid gtnui:ClipBehaviors.CornerRadius="5">
                        <Image
                            x:Name="imgCover"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Button
                    x:Name="btnBrowseLocalImage"
                    Height="36"
                    Margin="0,16,0,0"
                    Content="Browse local…"
                    ToolTip="Select a local image file" />

                <Button
                    x:Name="btnSteamGridDb"
                    Height="36"
                    Margin="0,8,0,0"
                    Content="SteamGridDB…"
                    ToolTip="Search a cover on SteamGridDB" />

                <Button
                    x:Name="btnUsePlaceholderCover"
                    Height="36"
                    Margin="0,8,0,0"
                    Content="Placeholder"
                    ToolTip="Use the GameTimeNext placeholder cover" />
            </StackPanel>

            <TabControl x:Name="tabControl" Grid.Column="2">
                <TabControl.Resources>
                    <!--  Sections of this view: more room inside the cards  -->
                    <Style BasedOn="{StaticResource GroupBox.Card}" TargetType="{x:Type GroupBox}">
                        <Setter Property="Padding" Value="20" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </TabControl.Resources>

                <TabItem Header="General">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox
                            Grid.Row="0"
                            Grid.ColumnSpan="3"
                            Header="Game">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource Text.Label}"
                                    Text="Name" />

                                <TextBox
                                    x:Name="txbProfileName"
                                    Grid.Row="2"
                                    Height="36"
                                    uixprops:UIXAttachedProperty.Path="T1PROFI.GANA"
                                    ToolTip="Name shown in the profile list" />

                                <TextBlock
                                    Grid.Row="4"
                                    Style="{StaticResource Text.Label}"
                                    Text="Platform" />

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <uixcb:UIXComboBox
                                        x:Name="cmbPlatform"
                                        Grid.Column="0"
                                        Height="36"
                                        AdditionalEntry="(None)"
                                        uixprops:UIXAttachedProperty.Path="T1PROFI.PLAFO"
                                        uixprops:UIXAttachedProperty.Source="From=T1CTABD;Where=TXTYP:pF;Text=DESCR;Value=TXNUM"
                                        SelectedIndex="0"
                                        SelectedValue=""
                                        SelectedValuePath="Tag" />

                                    <Button
                                        x:Name="btnAddPlatformWizard"
                                        Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Style="{StaticResource Button.Icon}"
                                        ToolTip="Add a platform with the wizard">
                                        <TextBlock
                                            FontSize="14"
                                            Style="{StaticResource Text.Icon}"
                                            Text="&#xE710;" />
                                    </Button>
                                </Grid>

                                <TextBlock
                                    Grid.Row="8"
                                    Style="{StaticResource Text.Label}"
                                    Text="Game folder" />

                                <Grid Grid.Row="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        x:Name="txbGameFolder"
                                        Grid.Column="0"
                                        Height="36"
                                        uixprops:UIXAttachedProperty.Path="T1PROFI.EXGF"
                                        IsReadOnly="True"
                                        ToolTip="Folder that contains the game executable" />

                                    <Button
                                        x:Name="btnBrowseGameFolder"
                                        Grid.Column="2"
                                        Height="36"
                                        Content="Browse…"
                                        ToolTip="Select game folder" />
                                </Grid>

                                <TextBlock
                                    Grid.Row="12"
                                    Style="{StaticResource Text.Hint}"
                                    Text="The folder with the game's .exe, used to detect when the game is running." />
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Grid.Row="2"
                            Grid.Column="0"
                            Header="Playtime goal">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Label}" Text="Target play style" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <uixcb:UIXComboBox
                                        x:Name="cmbEstimatedTimeType"
                                        ShowKeys="False"
                                        Grid.Column="0"
                                        Height="36"
                                        SelectedIndex="0"
                                        ToolTip="Select the target play style" />

                                    <Button
                                        x:Name="btnManualEstTimes"
                                        Grid.Column="2"
                                        Height="36"
                                        Content="Enter manual"
                                        ToolTip="Open the window to manually enter estimated times" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Grid.Row="2"
                            Grid.Column="2"
                            Header="Blackout">
                            <StackPanel>
                                <CheckBox x:Name="cbOverrideGlobalBlackout" Content="Override the global blackout settings" />

                                <CheckBox
                                    x:Name="cbBlackoutSideMonitors"
                                    Margin="0,12,0,0"
                                    Content="Black out side monitors" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Launcher">
                    <StackPanel>
                        <GroupBox Header="Launcher">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Hint}" Text="Link the game with a launcher or a file to start it from the library." />

                                <Border
                                    x:Name="pnlLauncherLinkState"
                                    Margin="0,16,0,0"
                                    Padding="12"
                                    Style="{StaticResource Card.Inset}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="{DynamicResource Brush.Accent}"
                                            Style="{StaticResource Text.Icon}"
                                            Text="&#xE71B;" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="txtLauncherLinkStatus"
                                                Style="{StaticResource Text.BodyStrong}"
                                                Text="Linked with launcher" />

                                            <TextBlock
                                                x:Name="txtLauncherGameId"
                                                Margin="0,2,0,0"
                                                Style="{StaticResource Text.Hint}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Button
                                            x:Name="btnUnlinkLauncher"
                                            Grid.Column="4"
                                            Width="120"
                                            Height="36"
                                            VerticalAlignment="Center"
                                            Content="Remove link"
                                            ToolTip="Remove the launcher link from this profile" />
                                    </Grid>
                                </Border>

                                <StackPanel
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="btnLauncherImport"
                                        Width="150"
                                        Height="36"
                                        Content="Launcher import…"
                                        ToolTip="Import an installed game from a launcher" />

                                    <Button
                                        x:Name="btnLinkFile"
                                        Width="150"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Content="Link file…"
                                        ToolTip="Start the game with an executable, a shortcut or a URI" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            x:Name="pnlLauncherSettings"
                            Margin="0,24,0,0"
                            Header="Launch settings">
                            <StackPanel>
                                <CheckBox x:Name="cbEnableHdrOnStart" Content="Enable HDR on game start" />

                                <CheckBox
                                    x:Name="cbPauseInBigPicture"
                                    Margin="0,12,0,0"
                                    Content="Pause the game while the Big Picture mode is in front"
                                    ToolTip="The game doesn't react to the controller while you use the Big Picture mode. Switch it off for online games or games with anti-cheat." />

                                <StackPanel x:Name="grdLaunchArgs" Margin="0,20,0,0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Launch arguments" />

                                    <TextBox
                                        x:Name="txbLaunchArgs"
                                        Height="36"
                                        Margin="0,8,0,0"
                                        ToolTip="Additional launch arguments (e.g. -novid -fullscreen)" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Tags">
                    <!--  The only tab whose content grows with the data (number of tags)  -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <GroupBox x:Name="pnlGroups" Header="Tags">
                            <ItemsControl ItemsSource="{Binding T1GROUPs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,0,0,12"
                                            Content="{Binding ItemObject.GRNA}"
                                            IsChecked="{Binding COISSEL, Mode=TwoWay}"
                                            Style="{StaticResource CheckBox.Left}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Appearance">
                    <StackPanel>
                        <GroupBox Header="Accent color">
                            <StackPanel x:Name="grdAccentColorSettings">
                                <CheckBox
                                    x:Name="cbUseProfileAccentColors"
                                    uixprops:UIXAttachedProperty.Path="T1PROFI.ACAC"
                                    Content="Change accent colors based on this profile"
                                    ToolTip="If enabled, the application's accent colors can switch when this profile is selected/active." />

                                <TextBlock
                                    Margin="0,20,0,0"
                                    Style="{StaticResource Text.Label}"
                                    Text="Accent colors" />

                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <ToggleButton x:Name="tglAccent1" Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />

                                    <ToggleButton x:Name="tglAccent2" Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />

                                    <ToggleButton
                                        x:Name="tglAccent3"
                                        Margin="0"
                                        Style="{StaticResource ProfileAccentColorToggleButtonStyle}" />
                                </StackPanel>

                                <TextBlock
                                    Margin="0,8,0,0"
                                    Style="{StaticResource Text.Hint}"
                                    Text="The colors are taken from the cover." />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="btnCancel"
                Grid.Column="1"
                Width="110"
                Height="36"
                Content="Cancel" />

            <Button
                x:Name="btnSave"
                Grid.Column="3"
                Width="140"
                Height="36"
                Content="Save"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
