<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.Settings.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    xmlns:uixcb="clr-namespace:UIX.ViewController.Engine.FrameworkElements.ComboBoxes;assembly=UIX.ViewController.Engine"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:GameTimeNext.Core.Application.Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="800"
    d:DesignWidth="2000"
    mc:Ignorable="d">

    <uix:UIXUserControlBase.Resources>
        <!--  One setting of a settings page: title and hint on the left, the control on the right  -->
        <Style x:Key="Settings.Row" TargetType="{x:Type Grid}">
            <Setter Property="Margin" Value="0,8" />
        </Style>
    </uix:UIXUserControlBase.Resources>

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar: search hides the pages, cards and settings that don't match; refresh reloads the saved settings  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,16"
            Padding="16"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox
                        x:Name="txbSearch"
                        Padding="36,0,12,0"
                        uixprops:UIXAttachedProperty.SkipEventPipeline="True"
                        ToolTip="Search for a setting" />

                    <TextBlock
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.Icons}"
                        FontSize="14"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        IsHitTestVisible="False"
                        Text="&#xE721;" />
                </Grid>

                <Button
                    x:Name="btnRefresh"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    uixprops:UIXAttachedProperty.SkipEventPipeline="True"
                    Style="{StaticResource Button.Icon}"
                    ToolTip="Reload the saved settings (discards unsaved changes)">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource Font.Icons}"
                        FontSize="14"
                        Text="&#xE72C;" />
                </Button>
            </Grid>
        </Border>

        <TextBlock
            x:Name="txSearchEmpty"
            Grid.Row="1"
            Margin="12,8,0,0"
            Style="{StaticResource Text.Hint}"
            Text="No setting matches your search."
            Visibility="Collapsed" />

        <uixsel:UIXTabControl
            x:Name="tbcSettings"
            Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            SelectedIndex="0"
            Style="{StaticResource VerticalSettingsTabControlStyle}"
            TabStripPlacement="Left">

            <uixsel:UIXTabControl.Resources>
                <Style BasedOn="{StaticResource CheckBox.Switch}" TargetType="{x:Type CheckBox}" />
            </uixsel:UIXTabControl.Resources>

            <TabItem Header="General" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="860"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="General" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Everyday behavior of the application." />

                        <GroupBox
                            Header="Startup"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Automatic start (minimized)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Starts the application minimized when launched automatically."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbAutoStartMinimized" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Add new games shrink-wrapped" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="New games are added still shrink-wrapped. Unwrap them (context menu or Unwrap game) before the first launch."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbSealNewGames" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Breaks"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Remind me to take a break" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Shows a reminder while you play."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbRemindTakeBreak" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Break interval" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Hours between two reminders."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox x:Name="txbBreakReminderHours" Width="80" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Label}"
                                            Text="hrs" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Game import"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Add new games automatically" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Newly installed games of the checked launchers are added as profiles shortly after their installation."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbAutoImportGames" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Launchers" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Games that already have a profile, or whose profile was deleted, are not added again. When a launcher is switched on, you decide once what happens with the games installed already."
                                            TextWrapping="Wrap" />

                                        <uixsel:UIXListBox
                                            Margin="0,12,0,0"
                                            x:Name="lbAutoImportLaunchers"
                                            Focusable="False">
                                            <uixsel:UIXListBox.Template>
                                                <ControlTemplate TargetType="{x:Type ListBox}">
                                                    <ItemsPresenter />
                                                </ControlTemplate>
                                            </uixsel:UIXListBox.Template>

                                            <uixsel:UIXListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel MaxWidth="660" ItemWidth="220" />
                                                </ItemsPanelTemplate>
                                            </uixsel:UIXListBox.ItemsPanel>

                                            <uixsel:UIXListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <ContentPresenter />
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </uixsel:UIXListBox.ItemContainerStyle>

                                            <uixsel:UIXListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Margin="0,0,12,12"
                                                        HorizontalAlignment="Left"
                                                        Content="{Binding CONAME}"
                                                        IsChecked="{Binding COISSEL, Mode=TwoWay}"
                                                        Style="{StaticResource CheckBox.Left}" />
                                                </DataTemplate>
                                            </uixsel:UIXListBox.ItemTemplate>
                                        </uixsel:UIXListBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="860"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Appearance" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Colors, backgrounds and the arrangement of the views." />

                        <GroupBox
                            Header="Look"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Allow profile-specific colors" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="The accent colors can follow the profile that is selected or running."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbAllowProfileSpecificStyleChanges" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Dark tinted glass" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Tints the window background and the glass surfaces darker, closer to a classic dark mode."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbDarkTintedGlass" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Dynamic background" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Image used as blurred main window background: the desktop wallpaper or the cover of the selected profile. (None) disables it."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <uixcb:UIXComboBox
                                        x:Name="cmbBackgroundSource"
                                        Grid.Column="1"
                                        Width="260"
                                        AdditionalEntry="(None)"
                                        SelectedValuePath="Tag"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Layout"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Profile detail view position" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Side of the profiles view on which the details of the selected profile are shown."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <uixcb:UIXComboBox
                                        x:Name="cmbProfileDetailViewPosition"
                                        Grid.Column="1"
                                        Width="260"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Integrations" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="860"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Integrations" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Online services that provide artwork and game information." />

                        <GroupBox
                            Header="Steam Grid DB"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="API key" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Used to retrieve game artwork and grid images."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbSteamGridDbApiKey"
                                            Width="300" />
                                        <Button
                                            x:Name="btnOpenSteamGridDB"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Open Steam Grid DB and get your API key.">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                Text="&#xE128;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="IGDB"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Enable integration" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Required for IGDB access via Twitch developer credentials."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbEnableIGDBIntegration" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Client ID" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Client ID used for IGDB / Twitch authentication."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbIgdbClientId"
                                            Width="300" />
                                        <Button
                                            x:Name="btnOpenIgdbClientId"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Open Twitch Developer Portal to get your client ID.">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                Text="&#xE128;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Client secret" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Client secret used for IGDB / Twitch authentication."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbIgdbClientSecret"
                                            Width="300" />
                                        <Button
                                            x:Name="btnOpenIgdbClientSecret"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Open Twitch Developer Portal to get your client secret.">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                Text="&#xE128;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Backup" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="860"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Backup" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Protect your data: create, schedule and restore backups." />

                        <GroupBox
                            Header="Export"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Backup export path" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Folder in which backups are stored."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbBackupExportPath"
                                            Width="300"
                                            IsReadOnly="True" />
                                        <Button
                                            x:Name="btnBrowseBackupExportPath"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Select a backup export path.">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                Text="&#xE188;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Create a backup now" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Creates a backup at the selected export path."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button
                                        x:Name="btnCreateBackup"
                                        Grid.Column="1"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        Content="Create backup" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Auto backup" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Creates a backup automatically whenever the application starts or closes."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbAutoBackup" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Auto delete" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Automatically deletes backups older than three days and keeps only the most recent backups from the last three days."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbAutoDeleteBackups" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Import"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Backup import path" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Backup file to restore."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbBackupImportPath"
                                            Width="300"
                                            IsReadOnly="True" />
                                        <Button
                                            x:Name="btnBrowseBackupImportPath"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Select a backup import file.">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="{StaticResource Font.Icons}"
                                                FontSize="14"
                                                Text="&#xE8B7;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Restore the backup" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Imports the backup from the selected path."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button
                                        x:Name="btnImportBackup"
                                        Grid.Column="1"
                                        Width="150"
                                        VerticalAlignment="Center"
                                        Content="Import backup" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Monitoring" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="860"
                        Margin="12,8,12,0"
                        HorizontalAlignment="Left">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Monitoring" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Configure game monitoring behavior and blackout handling." />

                        <GroupBox
                            Header="Monitoring behavior"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Key active" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Enables the monitoring hotkey."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbMonitoringKeyActive" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Show toast notification" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Needs the monitoring key."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbShowToastNotification" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Show monitoring indicator" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Shows a small indicator while a game is monitored."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbShowMonitoringIndicator" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Blackout side monitors" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Needs the monitoring key."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbBlackoutSideMonitors" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Enable session time query" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Pressing Ctrl+Shift+T displays the current recorded playtime."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbEnableSessionTimeQuery" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            x:Name="pnlMonitoringKey"
                            Header="Monitoring hotkey"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Hotkey" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Press the button to listen for a new hotkey."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox
                                            x:Name="txbMonitoringKey"
                                            Width="140"
                                            IsEnabled="False" />

                                        <Button
                                            x:Name="btnCaptureMonitoringKey"
                                            Width="36"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource Button.Icon}"
                                            ToolTip="Listen for a new hotkey">
                                            <Image
                                                Width="16"
                                                Height="16"
                                                Source="/UI/Ressources/GTN_ICON_MONITOR_KEY.png" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Blackout"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Activate blackout key combination" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Blacks out all screens to help protect OLED displays (Ctrl + B)."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbActivateBlackoutKeyCombination" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Show animation on blackout" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Shows an animated particle clock when all monitors are blacked out."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbShowTextOnBlackout" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox
                            Header="Session cleanup"
                            Style="{StaticResource GroupBox.Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Enable cleanup" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Removes sessions that are shorter than the minimum."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox x:Name="cbEnableSessionCleanup" Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Style="{StaticResource Settings.Row}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Minimum seconds" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource Text.Hint}"
                                            Text="Minimum playtime in seconds for a session to be valid."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBox x:Name="txbSessionCleanupSeconds" Width="80" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Text.Label}"
                                            Text="sec" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About" Style="{StaticResource VerticalSettingsTabItemStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,12,0">

                        <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="About" />

                        <TextBlock
                            Margin="0,4,0,16"
                            Style="{StaticResource SettingsPageSubtitleStyle}"
                            Text="Application information, version details and credits." />

                        <GroupBox
                            Header="Application"
                            Style="{StaticResource GroupBox.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    x:Name="txVersion"
                                    Grid.Row="0"
                                    Style="{StaticResource Text.BodyStrong}"
                                    Text="Beta 0.1.0" />

                                <TextBlock
                                    x:Name="txBetaNotice"
                                    Grid.Row="2"
                                    Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox
                            Header="Credits"
                            Style="{StaticResource GroupBox.Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource Text.Hint}"
                                    Text="Some icons used in this application are provided by Icons8." />

                                <TextBlock Grid.Row="2" Foreground="{DynamicResource Brush.TextSecondary}">
                                    <Run Text="Developed by" />
                                </TextBlock>
                                <Border
                                    Grid.Row="4"
                                    Padding="16"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Card.Inset}">
                                    <StackPanel>
                                        <Image
                                            Width="210"
                                            Height="210"
                                            HorizontalAlignment="Center"
                                            Source="/UI/Ressources/GTN_CLS_ICON.png" />

                                        <StackPanel
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Border
                                                Padding="4"
                                                Background="#0AFFFFFF"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                                <Image
                                                    Width="94"
                                                    Height="94"
                                                    Source="/UI/Ressources/GTN_ICON_CLSMP.png" />
                                            </Border>

                                            <Border
                                                Margin="12,0,0,0"
                                                Padding="4"
                                                Background="#0AFFFFFF"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                                <Image
                                                    Width="94"
                                                    Height="94"
                                                    Source="/UI/Ressources/GTN_ICON_CLSOF.png" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </uixsel:UIXTabControl>

        <Grid Grid.Row="2" Margin="0,24,0,8">
            <Button
                x:Name="btnSave"
                Width="140"
                Height="36"
                HorizontalAlignment="Right"
                Content="Save settings"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</uix:UIXUserControlBase>