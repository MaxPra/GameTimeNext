<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.SelectionLists.Views.SelectionListsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixsel="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Selectors;assembly=UIX.ViewController.Engine"
    Width="Auto"
    Height="800"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  The lists the user may extend  -->
        <Border
            Grid.Column="0"
            Padding="16"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource Text.Title}" Text="Lists" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource Text.Hint}"
                        Text="Choose a list to see and change what you can pick from."
                        TextWrapping="Wrap" />
                </StackPanel>

                <uixsel:UIXDataGrid
                    x:Name="dgLists"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="None"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <uixsel:UIXDataGrid.Columns>
                        <uixsel:UIXDataGridTextColumn Width="*" Binding="{Binding CONAME}" />
                    </uixsel:UIXDataGrid.Columns>
                </uixsel:UIXDataGrid>
            </Grid>
        </Border>

        <!--  The entries of the chosen list  -->
        <Border
            Grid.Column="2"
            Padding="16"
            Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="txListTitle"
                            Style="{StaticResource Text.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Hint}"
                            Text="These are the choices you can pick from in the app."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        x:Name="btnAdd"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource Button.Primary}"
                        ToolTip="Add a new entry to this list">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource Font.Icons}"
                                FontSize="14"
                                Text="&#xE710;" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="Add" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2">
                    <uixsel:UIXDataGrid
                        x:Name="dgEntries"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <uixsel:UIXDataGrid.Columns>
                            <uixsel:UIXDataGridTextColumn
                                Width="*"
                                Binding="{Binding CONAME}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding COPARM1}"
                                Header="" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding COPARM2}"
                                Header="" />
                        </uixsel:UIXDataGrid.Columns>
                    </uixsel:UIXDataGrid>

                    <!--  Empty state: shown by the selector adapter when the list has no entries  -->
                    <StackPanel
                        x:Name="pnlNoEntries"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource Font.Icons}"
                            FontSize="28"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            Text="&#xE8FD;" />
                        <TextBlock
                            x:Name="txNoEntries"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Subtitle}" />
                        <TextBlock
                            x:Name="txNoEntriesHint"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource Text.Hint}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:GTNWindowView>
