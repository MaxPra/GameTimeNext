<ui:GTNWindowView
    x:Class="GameTimeNext.Core.Application.ApplicationProperties.Views.ApplicationPropertiesEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    xmlns:uixmd="clr-namespace:UIX.ViewController.Engine.FrameworkElements.Markdown;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    Title="Application Properties Definition"
    Width="1200"
    Height="1000"
    ResizeMode="NoResize"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Header="General"
            Style="{StaticResource GroupBox.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Label}"
                    Text="App name" />

                <TextBox
                    x:Name="TxbId"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="300"
                    HorizontalAlignment="Left"
                    uixprops:UIXAttachedProperty.Path="T1APRDH.APDID" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Label}"
                    Text="Description" />

                <TextBox
                    x:Name="TxbDescription"
                    Grid.Row="2"
                    Grid.Column="1"
                    uixprops:UIXAttachedProperty.Path="T1APRDH.APDES" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Text.Label}"
                    Text="Menu call possible" />

                <CheckBox
                    x:Name="ChbMenuCallPossible"
                    Grid.Row="4"
                    Grid.Column="1"
                    Padding="0"
                    VerticalAlignment="Center"
                    uixprops:UIXAttachedProperty.Path="T1APRDH.APMCP" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="1"
            Margin="0"
            Header="Help text"
            Style="{StaticResource GroupBox.Card}">
            <uixmd:UIXMarkdownEditor x:Name="TxbHelpText" uixprops:UIXAttachedProperty.Path="T1APRDH.APHPT" />
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BtnSave"
                Grid.Column="1"
                Width="140"
                Height="36"
                Content="Save"
                IsDefault="True"
                Style="{StaticResource Button.Primary}" />
        </Grid>
    </Grid>
</ui:GTNWindowView>
