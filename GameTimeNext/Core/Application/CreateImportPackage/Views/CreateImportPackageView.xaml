<uix:UIXUserControlBase
    x:Class="GameTimeNext.Core.Application.CreateImportPackage.Views.CreateImportPackageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uix="clr-namespace:UIX.ViewController.Engine.FrameworkElements.UserControls;assembly=UIX.ViewController.Engine"
    xmlns:uixprops="clr-namespace:UIX.ViewController.Engine.AttachedProperties;assembly=UIX.ViewController.Engine"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    d:DesignHeight="520"
    d:DesignWidth="980"
    mc:Ignorable="d">

    <Grid Style="{StaticResource View.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button
            x:Name="btnExecute"
            Grid.Row="0"
            Grid.Column="0"
            Width="148"
            Height="38"
            HorizontalAlignment="Left"
            IsDefault="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    Text="&#xE768;" />
                <TextBlock VerticalAlignment="Center" Text="Execute" />
            </StackPanel>
        </Button>

        <Button
            x:Name="btnTestImport"
            Grid.Row="0"
            Grid.Column="2"
            Width="148"
            Height="38"
            HorizontalAlignment="Left"
            IsDefault="True">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    Text="&#xE9D9;" />
                <TextBlock VerticalAlignment="Center" Text="Test Import" />
            </StackPanel>
        </Button>
    </Grid>
</uix:UIXUserControlBase>
