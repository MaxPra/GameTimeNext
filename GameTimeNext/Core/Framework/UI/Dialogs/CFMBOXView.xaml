<ui:GTNWindow
    x:Class="GameTimeNext.Core.Framework.UI.Dialogs.CFMBOXView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:GameTimeNext.Core.Framework.UI.Base"
    Title="Question"
    Width="460"
    MinWidth="460"
    MaxWidth="820"
    MaxHeight="700"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    ShowMaximizeButton="False"
    ShowMinimizeButton="False"
    SizeToContent="Height"
    Style="{StaticResource GTNWindowStyle}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Body  -->
        <Grid Grid.Row="0" Margin="24,22,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="BdIconHost"
                Grid.Column="0"
                Margin="0,1,16,0"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0">

                <TextBlock
                    x:Name="TbIconGlyph"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="22"
                    Foreground="{DynamicResource Brush.Warning}"
                    Text="&#xE9CE;" />
            </Border>

            <StackPanel
                x:Name="SpText"
                Grid.Column="1"
                VerticalAlignment="Top">

                <TextBlock
                    x:Name="TbHeadline"
                    Margin="0,0,0,6"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="Headline"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <ScrollViewer
                    x:Name="SvMessage"
                    MaxHeight="360"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <TextBlock
                        x:Name="TbMessage"
                        FontSize="13.5"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        LineHeight="20"
                        Text="Message"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>

            <TextBox
                x:Name="TxbMemotext"
                Grid.Column="1"
                Height="Auto"
                MinHeight="80"
                Padding="8"
                VerticalAlignment="Stretch"
                VerticalContentAlignment="Top"
                AcceptsReturn="True"
                Background="{DynamicResource Brush.TextBox.Background}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                FontFamily="Consolas"
                FontSize="13"
                Foreground="{DynamicResource Brush.TextPrimary}"
                HorizontalScrollBarVisibility="Auto"
                IsReadOnly="True"
                TextWrapping="NoWrap"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed" />
        </Grid>

        <!--  Footer: translucent inset band so the window glass shows through (rounded like the window corners)  -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            Background="{StaticResource Brush.Card.Inset}"
            BorderBrush="{StaticResource Brush.Card.Divider}"
            BorderThickness="0,1,0,0"
            CornerRadius="0,0,9,9">

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                        <Setter Property="MinWidth" Value="88" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="16,0" />
                        <Setter Property="Margin" Value="8,0,0,0" />
                    </Style>
                </StackPanel.Resources>

                <Button
                    x:Name="BtnButton1"
                    Content="OK"
                    Visibility="Collapsed" />

                <Button
                    x:Name="BtnButton2"
                    Content="No"
                    Visibility="Collapsed" />

                <Button
                    x:Name="BtnButton3"
                    Content="Cancel"
                    Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</ui:GTNWindow>
